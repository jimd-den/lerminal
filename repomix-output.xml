<file path="src/frameworks/ui/useDeckNavigation.ts">
  1: import { useCallback, useEffect, useState } from "react";
  2: import { BackHandler } from "react-native";
  3: import {
  4:   AppState,
  5:   GriotController,
  6: } from "../../adapters/presenters/GriotController";
  7: import { CorePlace } from "./griot/components";
  8: export type LibraryLevel = "index" | "space" | "document";
  9: export interface DeckNavigation {
 10:   place: CorePlace;
 11:   libraryLevel: LibraryLevel;
 12:   openSpace: (spaceId: string) => Promise<void>;
 13:   openDocument: (groupId: string) => void;
 14:   backFromDocument: () => void;
 15:   openOperationResult: () => Promise<void>;
 16:   openSettings: () => void;
 17:   changePlace: (next: CorePlace) => void;
 18:   showLibraryIndex: () => void;
 19: }
 20: export interface DeckNavigationOptions {
 21:   controller: GriotController;
 22:   state: AppState;
 23:   captureWorking: boolean;
 24: }
 25: export function useDeckNavigation({
 26:   controller,
 27:   state,
 28:   captureWorking,
 29: }: DeckNavigationOptions): DeckNavigation {
 30:   const [place, setPlace] = useState<CorePlace>("deck");
 31:   const [libraryLevel, setLibraryLevel] = useState<LibraryLevel>("index");
 32:   const openSpace = useCallback(
 33:     async (spaceId: string) => {
 34:       if (spaceId !== state.activeWorkspaceId) {
 35:         await controller.switchWorkspace(spaceId);
 36:       }
 37:       controller.navigateToGroup(null);
 38:       controller.clearSelection();
 39:       setPlace("library");
 40:       setLibraryLevel("space");
 41:     },
 42:     [controller, state.activeWorkspaceId]
 43:   );
 44:   const openDocument = useCallback(
 45:     (groupId: string) => {
 46:       controller.navigateToGroup(groupId);
 47:       setPlace("library");
 48:       setLibraryLevel("document");
 49:     },
 50:     [controller]
 51:   );
 52:   const backFromDocument = useCallback(() => {
 53:     const current = state.cards.find(card => card.id === state.currentGroupId);
 54:     if (current?.parentId) {
 55:       controller.navigateToGroup(current.parentId);
 56:       setLibraryLevel("document");
 57:     } else {
 58:       controller.navigateToGroup(null);
 59:       setLibraryLevel("space");
 60:     }
 61:   }, [controller, state.cards, state.currentGroupId]);
 62:   const openOperationResult = useCallback(async () => {
 63:     const result = state.operationResult;
 64:     if (!result) return;
 65:     await controller.openOperationResult();
 66:     if (result.destination.cardId && !result.destination.groupId) {
 67:       controller.openCard(result.destination.cardId);
 68:       return;
 69:     }
 70:     setPlace("library");
 71:     setLibraryLevel(result.destination.groupId ? "document" : "space");
 72:   }, [controller, state.operationResult]);
 73:   const openSettings = useCallback(() => setPlace("more"), []);
 74:   const showLibraryIndex = useCallback(() => setLibraryLevel("index"), []);
 75:   const changePlace = useCallback(
 76:     (next: CorePlace) => {
 77:       if (captureWorking) return;
 78:       controller.navigateToGroup(null);
 79:       setPlace(next);
 80:       if (next === "library") setLibraryLevel("index");
 81:     },
 82:     [captureWorking, controller]
 83:   );
 84:   useEffect(() => {
 85:     if (state.isSettingsSheetOpen) {
 86:       setPlace("more");
 87:       controller.setSettingsSheetOpen(false);
 88:     }
 89:   }, [controller, state.isSettingsSheetOpen]);
 90:   useEffect(() => {
 91:     if (!state.pendingGroupNavigation) return;
 92:     const groupId = controller.consumeGroupNavigation();
 93:     if (groupId) {
 94:       setPlace("library");
 95:       setLibraryLevel("document");
 96:     }
 97:   }, [controller, state.pendingGroupNavigation]);
 98:   useEffect(() => {
 99:     const subscription = BackHandler.addEventListener("hardwareBackPress", () => {
100:       if (state.selection.size > 0) {
101:         controller.clearSelection();
102:         return true;
103:       }
104:       if (state.isCaptureSheetOpen) {
105:         if (!captureWorking) controller.closeCaptureSheet();
106:         return true;
107:       }
108:       if (place === "library" && libraryLevel === "document") {
109:         backFromDocument();
110:         return true;
111:       }
112:       if (place === "library" && libraryLevel === "space") {
113:         setLibraryLevel("index");
114:         return true;
115:       }
116:       if (place !== "deck") {
117:         controller.navigateToGroup(null);
118:         setPlace("deck");
119:         return true;
120:       }
121:       return false;
122:     });
123:     return () => subscription.remove();
124:   }, [backFromDocument, captureWorking, controller, libraryLevel, place, state.isCaptureSheetOpen, state.selection.size]);
125:   return {
126:     place,
127:     libraryLevel,
128:     openSpace,
129:     openDocument,
130:     backFromDocument,
131:     openOperationResult,
132:     openSettings,
133:     changePlace,
134:     showLibraryIndex,
135:   };
136: }
</file>

