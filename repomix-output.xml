 1: import { Card, createCard } from "../../entities/card";
 2: import { createProvenance } from "../../entities/provenance";
 3: import { ResearchResult } from "../../entities/research";
 4: import { BUILTIN_ASSISTANT_PROFILES } from "../../entities/assistantProfile";
 5: import { AgentGateway } from "../ports/gateways/AgentGateway";
 6: import { CardRepository } from "../ports/repositories/CardRepository";
 7: import { AgentRequestError, EmptySelectionError, MissingApiKeyError, UngroundedBriefError } from "../errors";
 8: const RESEARCH_BRIEF_PROFILE = BUILTIN_ASSISTANT_PROFILES.find(p => p.id === "builtin-research-brief")!;
 9: export interface CreateResearchBriefRequest {
10:   query: string;
11:   results: ResearchResult[];
12:   workspaceId: string;
13:   parentId: string | null;
14:   apiKey: string;
15:   model: string;
16: }
17: export class CreateResearchBriefInteractor {
18:   constructor(
19:     private readonly agentGateway: AgentGateway,
20:     private readonly cardRepo: CardRepository
21:   ) {}
22:   async execute(request: CreateResearchBriefRequest): Promise<Card[]> {
23:     if (!request.apiKey?.trim()) {
24:       throw new MissingApiKeyError("Creating a cited research brief");
25:     }
26:     const retained = request.results.filter(r => r.keepState === "kept");
27:     if (retained.length === 0) {
28:       throw new EmptySelectionError("Keep at least one source before creating a brief");
29:     }
30:     const sourceCards: Card[] = retained.map(r =>
31:       createCard({
32:         workspaceId: request.workspaceId,
33:         type: "source",
34:         title: r.title,
35:         body: `Source URL: ${r.url}\n\n${r.extractedText ?? r.snippet}`,
36:         cite: r.url,
37:       })
38:     );
39:     const askResult = await this.agentGateway.ask(
40:       request.query,
41:       sourceCards,
42:       request.apiKey,
43:       request.model,
44:       RESEARCH_BRIEF_PROFILE.systemPrompt,
45:       "chunks-v1"
46:     );
47:     if (askResult.isLocalFallback) {
48:       throw new AgentRequestError(
49:         askResult.fallbackReason ?? "No model answered, so no cited brief was written"
50:       );
51:     }
52:     const agentCards = askResult.cards;
53:     const sourceCardById = new Map(sourceCards.map(c => [c.id, c]));
54:     const grounded = agentCards.filter(item => item.sourceCardId && sourceCardById.has(item.sourceCardId));
55:     if (grounded.length === 0) {
56:       throw new UngroundedBriefError();
57:     }
58:     const briefCards = grounded.map(item => {
59:       const sourceCard = sourceCardById.get(item.sourceCardId!)!;
60:       const retainedResult = retained.find(r => r.url === sourceCard.cite);
61:       return createCard({
62:         workspaceId: request.workspaceId,
63:         type: "chunk",
64:         role: "claim",
65:         title: item.title,
66:         body: item.body,
67:         cite: retainedResult?.url,
68:         parentId: request.parentId ?? undefined,
69:         sourceRef: sourceCard.id,
70:         provenance: createProvenance({
71:           mode: "search",
72:           searchQuery: request.query,
73:           sourceUrls: retainedResult ? [retainedResult.url] : [],
74:           model: request.model,
75:           citations: item.sourceExcerpt
76:             ? [{ excerpt: item.sourceExcerpt, url: retainedResult?.url }]
77:             : undefined,
78:         }),
79:       });
80:     });
81:     await this.cardRepo.saveCards(briefCards);
82:     return briefCards;
83:   }
84: }
</file>

