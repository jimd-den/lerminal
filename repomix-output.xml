<file path="src/usecases/pipeline/SearchCommand.ts">
 1: import { createCard } from "../../entities/card";
 2: import { SearchGateway } from "../ports/gateways/SearchGateway";
 3: import { CardRepository } from "../ports/repositories/CardRepository";
 4: import { SettingsRepository } from "../ports/repositories/SettingsRepository";
 5: import { CommandContext, CommandResult, PipelineCommand } from "./Command";
 6: export class SearchCommand implements PipelineCommand {
 7:   readonly name = "search";
 8:   constructor(
 9:     private readonly searchGateway: SearchGateway,
10:     private readonly cardRepo: CardRepository,
11:     private readonly settingsRepo: SettingsRepository
12:   ) {}
13:   async execute(rawArg: string, ctx: CommandContext): Promise<CommandResult> {
14:     if (!rawArg) {
15:       return { kind: "needsInput", mode: "ask" };
16:     }
17:     let query = rawArg;
18:     const sites: string[] = [];
19:     const settings = await this.settingsRepo.getSettings();
20:     const siteFlags = settings?.searchSiteFlags || { "wiki": "wikipedia.org", "nature": "nature.com" };
21:     for (const [flag, domain] of Object.entries(siteFlags)) {
22:       const regex = new RegExp(`--${flag}\\b`, "g");
23:       if (regex.test(query)) {
24:         sites.push(domain);
25:         query = query.replace(regex, "");
26:       }
27:     }
28:     // Simple parser for --site or -s
29:     const siteRegex = /(?:--site|-s)\s+([^\s]+)/g;
30:     let match;
31:     while ((match = siteRegex.exec(query)) !== null) {
32:       sites.push(match[1]);
33:     }
34:     // Remove the generic flags from the query
35:     query = query.replace(/(?:--site|-s)\s+[^\s]+/g, "").trim();
36:     if (sites.length > 0) {
37:       if (sites.length === 1) {
38:         query = `${query} site:${sites[0]}`;
39:       } else {
40:         const siteQuery = sites.map(s => `site:${s}`).join(" OR ");
41:         query = `${query} (${siteQuery})`;
42:       }
43:     }
44:     let results;
45:     try {
46:       results = await this.searchGateway.search(query);
47:     } catch (err: any) {
48:       throw new Error("Search failed: " + err?.message);
49:     }
50:     if (!results || results.length === 0) {
51:       throw new Error("No results found for query.");
52:     }
53:     const card = createCard({
54:       workspaceId: ctx.workspaceId,
55:       type: "search",
56:       title: `Search: ${rawArg}`,
57:       body: JSON.stringify(results),
58:       parentId: ctx.parentId ?? undefined,
59:     });
60:     await this.cardRepo.saveCard(card);
61:     return {
62:       kind: "cards",
63:       cards: [card],
64:     };
65:   }
66: }
</file>

