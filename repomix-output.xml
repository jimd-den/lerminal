 1: import { SearchGateway, SearchResult } from "../../usecases/ports/gateways/SearchGateway";
 2: export class DuckDuckGoSearchGateway implements SearchGateway {
 3:   async search(query: string): Promise<SearchResult[]> {
 4:     const url = `https://html.duckduckgo.com/html/?q=${encodeURIComponent(query)}`;
 5:     try {
 6:       const response = await fetch(url, {
 7:         headers: {
 8:           "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"
 9:         }
10:       });
11:       if (!response.ok) {
12:         throw new Error(`DuckDuckGo returned status ${response.status}`);
13:       }
14:       const html = await response.text();
15:       return this.parseHtml(html);
16:     } catch (err: any) {
17:       console.error(`[DuckDuckGoSearchGateway] Error fetching search results: ${err.message}`);
18:       return [];
19:     }
20:   }
21:   private parseHtml(html: string): SearchResult[] {
22:     const results: SearchResult[] = [];
23:     const resultBlocks = html.split('class="result ');
24:     for (let i = 1; i < resultBlocks.length; i++) {
25:       const block = resultBlocks[i];
26:       if (results.length >= 10) break;
27:       const urlMatch = block.match(/href="([^"]+)"/);
28:       // Extract Title
29:       const titleMatch = block.match(/<h2 class="result__title">[\s\S]*?<a[^>]*>(.*?)<\/a>[\s\S]*?<\/h2>/i);
30:       const snippetMatch = block.match(/<a class="result__snippet[^>]*>(.*?)<\/a>/i);
31:       if (urlMatch && titleMatch && snippetMatch) {
32:         let rawUrl = urlMatch[1];
33:         // DuckDuckGo often redirects URLs like "
34:         if (rawUrl.includes("uddg=")) {
35:           const params = new URLSearchParams(rawUrl.split("?")[1] || "");
36:           const targetUrl = params.get("uddg");
37:           if (targetUrl) {
38:             rawUrl = decodeURIComponent(targetUrl);
39:           }
40:         } else if (rawUrl.startsWith("//")) {
41:           rawUrl = "https:" + rawUrl;
42:         } else if (rawUrl.startsWith("/")) {
43:           rawUrl = "https://duckduckgo.com" + rawUrl;
44:         }
45:         if (rawUrl.includes("duckduckgo.com/lite") || rawUrl.includes("duckduckgo.com/html")) {
46:           continue;
47:         }
48:         results.push({
49:           url: rawUrl,
50:           title: this.stripHtmlTags(titleMatch[1]),
51:           snippet: this.stripHtmlTags(snippetMatch[1]),
52:         });
53:       }
54:     }
55:     return results;
56:   }
57:   private stripHtmlTags(str: string): string {
58:     return str
59:       .replace(/<[^>]*>?/gm, "")
60:       .replace(/&nbsp;/g, " ")
61:       .replace(/&quot;/g, "\"")
62:       .replace(/&apos;/g, "'")
63:       .replace(/&lt;/g, "<")
64:       .replace(/&gt;/g, ">")
65:       .replace(/&amp;/g, "&")
66:       .trim();
67:   }
68: }
</file>

