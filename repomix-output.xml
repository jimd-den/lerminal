14:       options,
15:     );
16:   }
17:   async getWorkspaces(): Promise<Workspace[]> {
18:     return this.workspaces.readAll();
19:   }
20:   async saveWorkspace(workspace: Workspace): Promise<void> {
21:     await this.workspaces.mutate((all) => upsert(all, workspace, workspaceId));
22:   }
23:   async deleteWorkspace(id: string): Promise<void> {
24:     await this.workspaces.mutate((all) => removeById(all, id, workspaceId));
25:   }
26: }
</file>

