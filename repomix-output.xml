<file path="src/usecases/agent/AgentScope.ts">
 1: import { Card } from "../../entities/card";
 2: import { AgentScopeKind, DEFAULT_SCOPE_BUDGET, ScopeBudget } from "../../entities/agentScope";
 3: export type { AgentScopeKind, ScopeBudget };
 4: export { DEFAULT_SCOPE_BUDGET };
 5: export interface ScopedContext {
 6:   cards: Card[];
 7:   truncated: boolean;
 8:   totalConsideredCount: number;
 9:   totalCharacters: number;
10: }
11: export interface ResolveScopeInput {
12:   scope: AgentScopeKind;
13:   allCards: Card[];
14:   selectedCards: Card[];
15:   parentId: string | null;
16:   budget?: ScopeBudget;
17: }
18: export function resolveScopedContext(input: ResolveScopeInput): ScopedContext {
19:   const budget = input.budget ?? DEFAULT_SCOPE_BUDGET;
20:   if (input.scope === "web") {
21:     return { cards: [], truncated: false, totalConsideredCount: 0, totalCharacters: 0 };
22:   }
23:   const candidates: Card[] = [];
24:   const seen = new Set<string>();
25:   const push = (card: Card) => {
26:     if (seen.has(card.id)) return;
27:     seen.add(card.id);
28:     candidates.push(card);
29:   };
30:   for (const card of input.selectedCards) push(card);
31:   if (input.scope === "workspace" || input.scope === "selected-plus-web") {
32:     const byId = new Map(input.allCards.map(c => [c.id, c]));
33:     let current = input.parentId ? byId.get(input.parentId) : undefined;
34:     while (current) {
35:       push(current);
36:       current = current.parentId ? byId.get(current.parentId) : undefined;
37:     }
38:     const siblings = input.allCards
39:       .filter(c => (c.parentId ?? null) === input.parentId && !seen.has(c.id))
40:       .sort((a, b) => b.createdAt - a.createdAt);
41:     for (const card of siblings) push(card);
42:   }
43:   const totalConsideredCount = candidates.length;
44:   const cardBounded = candidates.slice(0, budget.maxCards);
45:   const cardTruncated = cardBounded.length < candidates.length;
46:   const finalCards: Card[] = [];
47:   let totalCharacters = 0;
48:   let charTruncated = false;
49:   for (const card of cardBounded) {
50:     const len = (card.title?.length ?? 0) + (card.body?.length ?? 0);
51:     if (finalCards.length > 0 && totalCharacters + len > budget.maxCharacters) {
52:       charTruncated = true;
53:       break;
54:     }
55:     finalCards.push(card);
56:     totalCharacters += len;
57:   }
58:   return {
59:     cards: finalCards,
60:     truncated: cardTruncated || charTruncated,
61:     totalConsideredCount,
62:     totalCharacters,
63:   };
64: }
</file>

