<file path="src/usecases/commands/CreateCommandDefinitionInteractor.ts">
 1: import {
 2:   CommandDefinition,
 3:   CommandKind,
 4:   COMMAND_NAME_PATTERN,
 5:   createCommandDefinition,
 6:   normalizeCommandName,
 7:   RESERVED_COMMAND_NAMES,
 8: } from "../../entities/commandDefinition";
 9: import { CommandDefinitionRepository } from "../ports/repositories/CommandDefinitionRepository";
10: import {
11:   DuplicateCommandNameError,
12:   InvalidCommandNameError,
13:   MissingArgumentError,
14:   ReservedCommandNameError,
15: } from "../errors";
16: export interface CreateCommandDefinitionRequest {
17:   name: string;
18:   description?: string;
19:   kind?: CommandKind;
20:   systemPrompt?: string;
21:   body?: string;
22: }
23: export class CreateCommandDefinitionInteractor {
24:   constructor(private readonly repo: CommandDefinitionRepository) {}
25:   async execute(request: CreateCommandDefinitionRequest): Promise<CommandDefinition> {
26:     const name = normalizeCommandName(request.name);
27:     const kind: CommandKind = request.kind || "agent";
28:     if (!COMMAND_NAME_PATTERN.test(name)) {
29:       throw new InvalidCommandNameError();
30:     }
31:     if (RESERVED_COMMAND_NAMES.includes(name)) {
32:       throw new ReservedCommandNameError(name);
33:     }
34:     if (kind === "agent" && !request.systemPrompt?.trim()) {
35:       throw new MissingArgumentError("Add a system prompt for this command");
36:     }
37:     if (kind === "pipeline" && !request.body?.trim()) {
38:       throw new MissingArgumentError("Add a pipeline for this command (e.g. chunk | recall | space)");
39:     }
40:     const existing = await this.repo.getDefinitions();
41:     if (existing.some(d => d.name === name)) {
42:       throw new DuplicateCommandNameError(name);
43:     }
44:     const definition = createCommandDefinition({
45:       name,
46:       description: request.description,
47:       kind,
48:       systemPrompt: request.systemPrompt,
49:       body: request.body,
50:     });
51:     await this.repo.saveDefinition(definition);
52:     return definition;
53:   }
54: }
</file>

