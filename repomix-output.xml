<file path="src/usecases/pipeline/SplitCommand.ts">
  1: import { CardRepository } from "../ports/repositories/CardRepository";
  2: import { Card, createCard } from "../../entities/card";
  3: import { chunkCard } from "../../entities/chunking";
  4: import { MarkdownChunkerService, MarkdownNode } from "../card/MarkdownChunkerService";
  5: import { EmptySelectionError } from "../errors";
  6: import { CommandContext, CommandResult, PipelineCommand } from "./Command";
  7: export class SplitCommand implements PipelineCommand {
  8:   readonly name = "split";
  9:   constructor(private readonly cardRepo: CardRepository) {}
 10:   async execute(_arg: string, ctx: CommandContext): Promise<CommandResult> {
 11:     const chunkable = ctx.inputCards.filter(
 12:       c => c.type === "source" || c.type === "note" || c.type === "chunk"
 13:     );
 14:     if (chunkable.length === 0) {
 15:       throw new EmptySelectionError("Select source, note, or chunk to split");
 16:     }
 17:     const created: Card[] = [];
 18:     for (const source of chunkable) {
 19:       const docGroup = await this.ensureDocumentGroup(source, ctx);
 20:       const sourceRef = source.sourceRef || source.id;
 21:       const sections = MarkdownChunkerService.chunk(source.body, source.title);
 22:       if (sections.length <= 1) {
 23:         const generated = chunkCard(source).map(c => ({ ...c, parentId: docGroup.id }));
 24:         created.push(...generated);
 25:         continue;
 26:       }
 27:       const tree = MarkdownChunkerService.chunkTree(source.body, source.title);
 28:       this.materialize(tree, docGroup.id, source, sourceRef, ctx.workspaceId, created);
 29:     }
 30:     if (created.length === 0) {
 31:       throw new EmptySelectionError("Nothing to split");
 32:     }
 33:     await this.cardRepo.saveCards(created);
 34:     return { kind: "cards", cards: created };
 35:   }
 36:   private async ensureDocumentGroup(
 37:     source: Card,
 38:     ctx: CommandContext
 39:   ): Promise<Card> {
 40:     const allWorkspaceCards = await this.cardRepo.getCardsByWorkspace(ctx.workspaceId);
 41:     const existingGroup = allWorkspaceCards.find(
 42:       c => c.type === "group" && c.documentGroupFor === source.id
 43:     );
 44:     if (existingGroup) {
 45:       return existingGroup;
 46:     }
 47:     const documentGroup = createCard({
 48:       workspaceId: ctx.workspaceId,
 49:       type: "group",
 50:       title: source.title,
 51:       body: "",
 52:       parentId: source.parentId ?? ctx.parentId ?? undefined,
 53:       sourceRef: source.sourceRef ?? source.id,
 54:       cite: source.cite,
 55:       documentGroupFor: source.id,
 56:     });
 57:     await this.cardRepo.saveCard(documentGroup);
 58:     if (source.parentId !== documentGroup.id) {
 59:       const updatedSource = { ...source, parentId: documentGroup.id };
 60:       await this.cardRepo.saveCard(updatedSource);
 61:     }
 62:     return documentGroup;
 63:   }
 64:   private materialize(
 65:     nodes: MarkdownNode[],
 66:     parentId: string | undefined,
 67:     source: Card,
 68:     sourceRef: string,
 69:     workspaceId: string,
 70:     out: Card[]
 71:   ): void {
 72:     for (const node of nodes) {
 73:       if (node.children.length === 0) {
 74:         out.push(createCard({
 75:           workspaceId,
 76:           type: "chunk",
 77:           title: node.title,
 78:           body: node.body,
 79:           sourceRef,
 80:           cite: source.cite,
 81:           parentId,
 82:         }));
 83:         continue;
 84:       }
 85:       const group = createCard({
 86:         workspaceId,
 87:         type: "group",
 88:         title: node.title,
 89:         body: "",
 90:         sourceRef,
 91:         cite: source.cite,
 92:         parentId,
 93:       });
 94:       out.push(group);
 95:       const lead = stripLeadingHeading(node.body);
 96:       if (lead.length > 0) {
 97:         out.push(createCard({
 98:           workspaceId,
 99:           type: "chunk",
100:           title: `${node.title} · Overview`,
101:           body: lead,
102:           sourceRef,
103:           cite: source.cite,
104:           parentId: group.id,
105:         }));
106:       }
107:       this.materialize(node.children, group.id, source, sourceRef, workspaceId, out);
108:     }
109:   }
110: }
111: function stripLeadingHeading(body: string): string {
112:   return body.replace(/^\s*#{1,6}\s.*(?:\r?\n|$)/, "").trim();
113: }
</file>

<file path="src/usecases/pipeline/UngroupCommand.ts">
 1: import { Card } from "../../entities/card";
 2: import { CardRepository } from "../ports/repositories/CardRepository";
 3: import { directChildren } from "../../entities/tree";
 4: import { CommandContext, CommandResult, PipelineCommand } from "./Command";
 5: export class UngroupCommand implements PipelineCommand {
 6:   readonly name = "ungroup";
 7:   constructor(private readonly cardRepo: CardRepository) {}
 8:   async execute(_arg: string, ctx: CommandContext): Promise<CommandResult> {
 9:     const groups = ctx.inputCards.filter(c => c.type === "group");
10:     if (groups.length === 0) {
11:       return { kind: "cards", cards: ctx.inputCards };
12:     }
13:     const allCards = await this.cardRepo.getCardsByWorkspace(ctx.workspaceId);
14:     const freed: Card[] = [];
15:     for (const group of groups) {
16:       for (const child of directChildren(allCards, group.id)) {
17:         const reparented = { ...child, parentId: group.parentId };
18:         await this.cardRepo.saveCard(reparented);
19:         freed.push(reparented);
20:       }
21:       await this.cardRepo.deleteCard(group.id);
22:     }
23:     const passthrough = ctx.inputCards.filter(c => c.type !== "group");
24:     return { kind: "cards", cards: [...passthrough, ...freed] };
25:   }
26: }
</file>

