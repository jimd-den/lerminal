 820:   async submitPendingPipelineInput(
 821:     value: string,
 822:     flags: string[] = [],
 823:   ): Promise<boolean> {
 824:     const resume = this.pendingPipelineResume;
 825:     const command = resume?.command || this.ui.pendingCommandName;
 826:     if (!command || !value.trim()) return false;
 827:     const argument = `${value.trim()}${flags.map((flag) => ` --${flag}`).join("")}`;
 828:     const pipelineText = `${command} "${encodePipelineArgument(argument)}"${resume?.remainingPipeline ? ` | ${resume.remainingPipeline}` : ""}`;
 829:     this.pendingPipelineResume = null;
 830:     return this.runPipeline(
 831:       pipelineText,
 832:       resume
 833:         ? { inputCardIds: resume.inputCardIds, parentId: resume.parentId }
 834:         : undefined,
 835:     );
 836:   }
