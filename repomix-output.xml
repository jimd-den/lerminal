 61: export function presentGoalArchitect(
 62:   state: GoalArchitectState,
 63:   canPropose: boolean
 64: ): GoalArchitectViewModel {
 65:   const { map } = state;
 66:   const sections = [
 67:     map.goal ? { heading: "GOAL", rows: [toRow(map.goal)] } : null,
 68:     map.deliverable ? { heading: "DELIVERABLE", rows: [toRow(map.deliverable)] } : null,
 69:     section("CONSTRAINTS", map.constraints),
 70:     section("ASSUMPTIONS", map.assumptions),
 71:     section("PREREQUISITES", map.prerequisites),
 72:     section("RISKS", map.risks),
 73:     section("OPEN QUESTIONS", map.unknowns),
 74:     section("CANDIDATE NEXT ACTIONS", map.candidateNextActions),
 75:   ].filter((item): item is WorkingMapSection => item !== null);
 76:   const agentQuestion = state.agentQuestion;
 77:   const bankQuestion = state.question;
 78:   const everyInsight = [
 79:     map.goal,
 80:     map.deliverable,
 81:     ...map.constraints,
 82:     ...map.assumptions,
 83:     ...map.unknowns,
 84:     ...map.prerequisites,
 85:     ...map.risks,
 86:     ...map.candidateNextActions,
 87:   ].filter((item): item is Insight => item !== undefined);
 88:   return {
 89:     isOpen: state.isOpen,
 90:     stage: state.stage,
 91:     prompt: agentQuestion?.prompt ?? bankQuestion?.prompt ?? null,
 92:     rationale: agentQuestion?.rationale ?? bankQuestion?.rationale ?? null,
 93:     choices: agentQuestion?.choices ?? [],
 94:     isAgentQuestion: agentQuestion !== null,
 95:     isFirstRun: state.isFirstRun,
 96:     dismissLabel: state.isFirstRun ? "START BLANK INSTEAD" : "CLOSE",
 97:     agentMessage: state.agentMessage,
 98:     agentError: state.agentError,
 99:     isAgentThinking: state.isAgentThinking,
100:     answeredCount: state.answers.length,
101:     canSkip: bankQuestion !== null && bankQuestion.optional,
102:     canPropose,
103:     mapSections: sections,
104:     hasAgentContributions: everyInsight.some(item => item.origin === "agent"),
105:     proposal: state.proposal,
106:     recommendedResearch: state.recommendedResearch,
107:     proposalStatus: "DRAFT MISSION — NOTHING HAS BEEN CREATED YET",
108:     provenanceSummary: describeProvenance(state),
109:   };
110: }
111: function describeProvenance(state: GoalArchitectState): string {
112:   const parts: string[] = [];
113:   parts.push(
114:     state.modelUsed
115:       ? "A model contributed suggestions, marked as hypotheses above."
116:       : "No model was used — this plan came from your answers alone."
117:   );
118:   parts.push(
119:     state.webUsed
120:       ? "Web results you kept are cited on the cards they produced."
121:       : "The web was not searched."
122:   );
123:   return parts.join(" ");
124: }
</file>

