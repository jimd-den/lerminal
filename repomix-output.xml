<file path="src/usecases/cardLink/LinkCardsInteractor.ts">
 1: import { Card } from "../../entities/card";
 2: import { CardLink, createCardLink, isDuplicateCardLink } from "../../entities/cardLink";
 3: import { CardLinkRepository } from "../ports/repositories/CardLinkRepository";
 4: import { UseCaseError } from "../errors";
 5: export class CardNotFoundError extends UseCaseError {
 6:   constructor() {
 7:     super("Couldn't find those cards. Nothing was changed.");
 8:   }
 9: }
10: export class DuplicateCardLinkError extends UseCaseError {
11:   constructor() {
12:     super("Those cards are already linked that way.");
13:   }
14: }
15: export interface LinkCardsRequest {
16:   workspaceId: string;
17:   fromCardId: string;
18:   toCardId: string;
19:   relation?: string;
20:   cards: Card[];
21: }
22: export class LinkCardsInteractor {
23:   constructor(private readonly cardLinkRepo: CardLinkRepository) {}
24:   async execute(request: LinkCardsRequest): Promise<CardLink> {
25:     const fromCard = request.cards.find(
26:       (c) => c.id === request.fromCardId && c.workspaceId === request.workspaceId,
27:     );
28:     const toCard = request.cards.find(
29:       (c) => c.id === request.toCardId && c.workspaceId === request.workspaceId,
30:     );
31:     if (!fromCard || !toCard) {
32:       throw new CardNotFoundError();
33:     }
34:     const candidate = createCardLink({
35:       workspaceId: request.workspaceId,
36:       fromCardId: request.fromCardId,
37:       toCardId: request.toCardId,
38:       relation: request.relation,
39:     });
40:     const existing = await this.cardLinkRepo.getLinksByWorkspace(request.workspaceId);
41:     if (existing.some((link) => isDuplicateCardLink(link, candidate))) {
42:       throw new DuplicateCardLinkError();
43:     }
44:     await this.cardLinkRepo.saveLink(candidate);
45:     return candidate;
46:   }
47: }
</file>

