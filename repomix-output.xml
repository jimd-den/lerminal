 7:     this.nhm = new NodeHtmlMarkdown(
 8:       {
 9:         ignore: ["script", "style", "nav", "footer", "header", "aside", "form", "img", "svg"]
10:       }
11:     );
12:   }
13:   private encodeUrl(rawUrl: string): string {
14:     try {
15:       const parsed = new URL(rawUrl);
16:       parsed.hostname = punycode.toASCII(parsed.hostname);
17:       return parsed.toString();
18:     } catch {
19:       return rawUrl;
20:     }
21:   }
22:   async extractText(rawUrl: string): Promise<string> {
23:     try {
24:       const url = this.encodeUrl(rawUrl);
25:       if (url.includes("wikipedia.org/wiki/")) {
26:         const titleMatch = url.match(/wikipedia\.org\/wiki\/([^#\?]+)/);
27:         if (titleMatch) {
28:           const title = titleMatch[1];
29:           const lang = url.match(/\/\/([a-z\-]+)\.wikipedia\.org/)?.[1] || "en";
30:           const apiUrl = `https://${lang}.wikipedia.org/w/api.php?action=query&prop=extracts&titles=${title}&format=json`;
31:           try {
32:             const apiRes = await fetch(apiUrl);
33:             if (apiRes.ok) {
34:               const data = await apiRes.json();
35:               const pages = data.query?.pages;
36:               if (pages) {
37:                 const pageId = Object.keys(pages)[0];
38:                 if (pageId && pageId !== "-1") {
39:                   const htmlExtract = pages[pageId].extract;
40:                   if (htmlExtract) {
41:                      return this.parseAndExtract(htmlExtract);
42:                   }
43:                 }
44:               }
45:             }
46:           } catch (e) {
47:             console.warn(`[WebExtractionGateway] Wikipedia API failed, falling back to HTML parsing: ${e}`);
48:           }
49:         }
50:       }
51:       const response = await fetch(url, {
52:         headers: {
53:           "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"
54:         }
55:       });
56:       if (!response.ok) {
57:         throw new Error(`Failed to fetch URL. Status: ${response.status}`);
58:       }
59:       const contentType = response.headers.get("content-type") || "";
60:       if (contentType && !contentType.includes("text/html") && !contentType.includes("text/plain")) {
61:         throw new Error("Unsupported content type for extraction: " + contentType);
62:       }
63:       const html = await response.text();
64:       return this.parseAndExtract(html);
65:     } catch (err: any) {
66:       console.error(`[WebExtractionGateway] Error extracting from ${rawUrl}: ${err.message}`);
67:       throw err;
68:     }
69:   }
70:   private async parseAndExtract(html: string): Promise<string> {
71:     let contentToParse = html;
72:     if (html.includes("<html")) {
73:       const articleMatch = html.match(/<article[^>]*>([\s\S]*?)<\/article>/i) || html.match(/<main[^>]*>([\s\S]*?)<\/main>/i);
74:       if (articleMatch) {
75:         contentToParse = articleMatch[1];
76:       }
77:     }
78:     if (contentToParse.length > 100000) {
79:       contentToParse = contentToParse.substring(0, 100000);
80:     }
81:     return new Promise((resolve) => {
82:       setTimeout(() => {
83:         try {
84:           let markdown = this.nhm.translate(contentToParse);
85:           resolve(markdown.substring(0, 10000));
86:         } catch (e) {
87:           resolve("Failed to parse content.");
88:         }
89:       }, 50);
90:     });
91:   }
92: }
</file>

