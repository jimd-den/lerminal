<file path="src/usecases/workspaceAgent/observeWorkspace.ts">
 1: import { Card } from "../../entities/card";
 2: export type WorkspacePulseKind =
 3:   | "notes-need-question"
 4:   | "unextracted-source"
 5:   | "unlinked-note-cluster";
 6: export interface WorkspacePulseObservation {
 7:   kind: WorkspacePulseKind;
 8:   message: string;
 9:   cardIds: string[];
10: }
11: const MIN_NOTE_CLUSTER = 3;
12: const MIN_LOOSE_NOTES = 4;
13: export function observeWorkspace(
14:   cards: Card[],
15:   workspaceId: string,
16: ): WorkspacePulseObservation | null {
17:   const inWorkspace = cards.filter((card) => card.workspaceId === workspaceId);
18:   if (inWorkspace.length === 0) return null;
19:   const notesToQuestion = findNotesNeedingQuestion(inWorkspace);
20:   if (notesToQuestion) return notesToQuestion;
21:   const unextractedSource = findUnextractedSource(inWorkspace);
22:   if (unextractedSource) return unextractedSource;
23:   const looseCluster = findUnlinkedNoteCluster(inWorkspace);
24:   if (looseCluster) return looseCluster;
25:   return null;
26: }
27: function findNotesNeedingQuestion(cards: Card[]): WorkspacePulseObservation | null {
28:   const openQuestions = cards.filter(
29:     (card) => card.type === "question" && !card.answer?.trim(),
30:   );
31:   for (const question of openQuestions) {
32:     const siblingNotes = cards.filter(
33:       (card) => card.type === "note" && card.parentId === question.parentId,
34:     );
35:     if (siblingNotes.length >= MIN_NOTE_CLUSTER) {
36:       return {
37:         kind: "notes-need-question",
38:         message: `${siblingNotes.length} notes sit near an unanswered question — worth resolving it?`,
39:         cardIds: [question.id, ...siblingNotes.map((card) => card.id)],
40:       };
41:     }
42:   }
43:   return null;
44: }
45: function findUnextractedSource(cards: Card[]): WorkspacePulseObservation | null {
46:   const unextracted = cards.find(
47:     (card) =>
48:       card.type === "source" && isUrl(card.cite) && !card.body?.trim(),
49:   );
50:   if (!unextracted) return null;
51:   return {
52:     kind: "unextracted-source",
53:     message: "There's a source with a link but no extracted text yet.",
54:     cardIds: [unextracted.id],
55:   };
56: }
57: function findUnlinkedNoteCluster(cards: Card[]): WorkspacePulseObservation | null {
58:   const looseNotes = cards.filter((card) => card.type === "note" && !card.parentId);
59:   if (looseNotes.length < MIN_LOOSE_NOTES) return null;
60:   return {
61:     kind: "unlinked-note-cluster",
62:     message: `${looseNotes.length} notes are sitting ungrouped at the top level.`,
63:     cardIds: looseNotes.map((card) => card.id),
64:   };
65: }
66: function isUrl(value: string | undefined): boolean {
67:   if (!value) return false;
68:   return /^https?:\/\//i.test(value.trim());
69: }
