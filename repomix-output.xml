 2: import { createInitialSchedule, updateSchedule } from "../schedule";
 3: describe("Spaced Repetition Scheduler (FSRS-lite)", () => {
 4:   const mockNow = 1718582400000;
 5:   const DAY_IN_MS = 86400000;
 6:   it("should create an initial schedule set to 1 day in the future", () => {
