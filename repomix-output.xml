<file path="src/usecases/report/GapReportInteractor.ts">
  1: import { Card, SemanticRole } from "../../entities/card";
  2: import { Workspace } from "../../entities/workspace";
  3: export type MaturityLevel = "just-starting" | "building-evidence" | "developing" | "near-complete";
  4: const MATURITY_LABELS: Record<MaturityLevel, string> = {
  5:   "just-starting": "Just starting — little evidence gathered yet",
  6:   "building-evidence": "Building evidence — early progress",
  7:   developing: "Developing — meaningful progress, gaps remain",
  8:   "near-complete": "Near complete — most success criteria have evidence",
  9: };
 10: export interface GapReportEvidenceCounts {
 11:   sources: number;
 12:   concepts: number;
 13:   claims: number;
 14:   experiments: number;
 15:   tasks: number;
 16:   deliverables: number;
 17:   openQuestions: number;
 18: }
 19: export interface SuccessCriterionStatus {
 20:   text: string;
 21:   hasEvidence: boolean;
 22: }
 23: export interface GapReportNextAction {
 24:   label: string;
 25:   reason: string;
 26:   presetId?: string;
 27: }
 28: export interface GapReport {
 29:   workspaceId: string;
 30:   generatedAt: number;
 31:   hasMission: boolean;
 32:   missionTitle?: string;
 33:   missionDeliverable?: string;
 34:   successCriteria: SuccessCriterionStatus[];
 35:   evidence: GapReportEvidenceCounts;
 36:   blockers: { id: string; title: string }[];
 37:   evidenceGaps: string[];
 38:   recommendedActions: GapReportNextAction[];
 39:   maturity: MaturityLevel;
 40:   maturityLabel: string;
 41: }
 42: const EMPTY_COUNTS: GapReportEvidenceCounts = {
 43:   sources: 0,
 44:   concepts: 0,
 45:   claims: 0,
 46:   experiments: 0,
 47:   tasks: 0,
 48:   deliverables: 0,
 49:   openQuestions: 0,
 50: };
 51: function tokenize(text: string): string[] {
 52:   return text
 53:     .toLowerCase()
 54:     .replace(/[^\p{L}\p{N}\s]/gu, " ")
 55:     .split(/\s+/)
 56:     .filter(w => w.length > 3);
 57: }
 58: function cardMatchesCriterion(card: Card, criterionWords: Set<string>): boolean {
 59:   const cardWords = tokenize(`${card.title} ${card.body}`);
 60:   return cardWords.some(w => criterionWords.has(w));
 61: }
 62: function classify(card: Card): keyof GapReportEvidenceCounts | null {
 63:   const role: SemanticRole | undefined = card.role;
 64:   if (role === "source") return "sources";
 65:   if (role === "concept") return "concepts";
 66:   if (role === "claim") return "claims";
 67:   if (role === "experiment") return "experiments";
 68:   if (role === "task") return "tasks";
 69:   if (role === "deliverable") return "deliverables";
 70:   if (role === "question") return "openQuestions";
 71:   if (card.type === "source") return "sources";
 72:   if (card.type === "chunk" || card.type === "note") return "concepts";
 73:   if (card.type === "question" && !card.schedule) return "openQuestions";
 74:   return null;
 75: }
 76: export function summarizeGapReportForPrompt(report: GapReport): string {
 77:   const lines: string[] = [];
 78:   lines.push(report.hasMission ? `Mission: ${report.missionTitle}` : "Mission: not yet defined");
 79:   if (report.missionDeliverable) lines.push(`Target deliverable: ${report.missionDeliverable}`);
 80:   lines.push(
 81:     `Evidence: ${report.evidence.sources} sources, ${report.evidence.concepts} concepts, ${report.evidence.claims} claims, ${report.evidence.experiments} experiments, ${report.evidence.tasks} tasks, ${report.evidence.deliverables} deliverables, ${report.evidence.openQuestions} open questions.`
 82:   );
 83:   if (report.evidenceGaps.length > 0) lines.push(`Gaps: ${report.evidenceGaps.join(" ")}`);
 84:   lines.push(report.maturityLabel);
 85:   lines.push("Assess momentum and suggest the single most useful next move based only on the above.");
 86:   return lines.join("\n");
 87: }
 88: export class GapReportInteractor {
 89:   execute(workspace: Workspace, cards: Card[], now: number = Date.now()): GapReport {
 90:     const evidence: GapReportEvidenceCounts = { ...EMPTY_COUNTS };
 91:     const blockerCards: Card[] = [];
 92:     for (const card of cards) {
 93:       const bucket = classify(card);
 94:       if (!bucket) continue;
 95:       evidence[bucket] += 1;
 96:       if (bucket === "openQuestions") blockerCards.push(card);
 97:     }
 98:     const mission = workspace.mission;
 99:     const successCriteria: SuccessCriterionStatus[] = (mission?.successCriteria ?? []).map(text => {
100:       const words = new Set(tokenize(text));
101:       const hasEvidence = words.size > 0 && cards.some(card => cardMatchesCriterion(card, words));
102:       return { text, hasEvidence };
103:     });
104:     const evidenceGaps = this.buildEvidenceGaps(evidence, mission !== undefined);
105:     const recommendedActions = this.buildRecommendedActions(evidence, successCriteria, mission !== undefined);
106:     const { maturity, maturityLabel } = this.assessMaturity(evidence, successCriteria);
107:     return {
108:       workspaceId: workspace.id,
109:       generatedAt: now,
110:       hasMission: mission !== undefined,
111:       missionTitle: mission?.goalTitle,
112:       missionDeliverable: mission?.targetDeliverable,
113:       successCriteria,
114:       evidence,
115:       blockers: blockerCards.slice(0, 8).map(c => ({ id: c.id, title: c.title })),
116:       evidenceGaps,
117:       recommendedActions,
118:       maturity,
119:       maturityLabel,
120:     };
121:   }
122:   private buildEvidenceGaps(evidence: GapReportEvidenceCounts, hasMission: boolean): string[] {
123:     const gaps: string[] = [];
124:     if (!hasMission) gaps.push("No mission defined yet — the report can't judge progress toward a goal.");
125:     if (evidence.sources === 0) gaps.push("No sources captured yet.");
126:     if (evidence.claims === 0) gaps.push("No web-grounded claims yet.");
127:     if (evidence.experiments === 0) gaps.push("No experiments planned or run yet.");
128:     if (evidence.openQuestions > 0) {
129:       gaps.push(`${evidence.openQuestions} open question${evidence.openQuestions === 1 ? "" : "s"} unresolved.`);
130:     }
131:     if (evidence.deliverables === 0 && hasMission) gaps.push("No deliverable/milestone cards yet.");
132:     return gaps;
133:   }
134:   private buildRecommendedActions(
135:     evidence: GapReportEvidenceCounts,
136:     successCriteria: SuccessCriterionStatus[],
137:     hasMission: boolean
138:   ): GapReportNextAction[] {
139:     const actions: GapReportNextAction[] = [];
140:     if (!hasMission) {
141:       actions.push({ label: "Define a mission", reason: "Set a goal so progress can be tracked against it." });
142:     }
143:     if (evidence.sources === 0) {
144:       actions.push({
145:         label: "Research the web for source material",
146:         reason: "No sources captured yet.",
147:         presetId: "research-web",
148:       });
149:     }
150:     const uncoveredCriteria = successCriteria.filter(c => !c.hasEvidence);
151:     if (uncoveredCriteria.length > 0) {
152:       actions.push({
153:         label: "Find prerequisites for the uncovered success criteria",
154:         reason: `${uncoveredCriteria.length} success criterion/criteria have no matching evidence yet.`,
155:         presetId: "find-prerequisites",
156:       });
157:     }
158:     if (evidence.concepts > 0 && evidence.openQuestions === 0) {
159:       actions.push({
160:         label: "Make study cards from what you have",
161:         reason: "There's material to study but no active-recall questions yet.",
162:         presetId: "make-study-cards",
163:       });
164:     }
165:     if (evidence.experiments === 0 && hasMission) {
166:       actions.push({
167:         label: "Plan an experiment",
168:         reason: "No experiments planned yet.",
169:         presetId: "plan-experiment",
170:       });
171:     }
172:     if (hasMission && evidence.deliverables === 0) {
173:       actions.push({
174:         label: "Plan capstone milestones",
175:         reason: "No milestone/deliverable cards yet.",
176:         presetId: "plan-capstone",
177:       });
178:     }
179:     return actions.slice(0, 4);
180:   }
181:   private assessMaturity(
182:     evidence: GapReportEvidenceCounts,
183:     successCriteria: SuccessCriterionStatus[]
184:   ): { maturity: MaturityLevel; maturityLabel: string } {
185:     const evidenceTotal =
186:       evidence.sources + evidence.concepts + evidence.claims + evidence.experiments + evidence.tasks + evidence.deliverables;
187:     const coverageRatio =
188:       successCriteria.length > 0
189:         ? successCriteria.filter(c => c.hasEvidence).length / successCriteria.length
190:         : Math.min(1, evidenceTotal / 8);
191:     let maturity: MaturityLevel;
192:     if (evidenceTotal === 0) {
193:       maturity = "just-starting";
194:     } else if (evidence.deliverables > 0 || coverageRatio >= 0.75) {
195:       maturity = "near-complete";
196:     } else if (coverageRatio >= 0.34) {
197:       maturity = "developing";
198:     } else {
199:       maturity = "building-evidence";
200:     }
201:     return { maturity, maturityLabel: `Heuristic read: ${MATURITY_LABELS[maturity]}. Not a precise measurement.` };
202:   }
203: }
</file>

