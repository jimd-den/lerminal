<file path="src/entities/fontCatalog.ts">
  1: export type FontCategory =
  2:   | "Sans Serif"
  3:   | "Serif"
  4:   | "Display"
  5:   | "Handwriting"
  6:   | "Monospace";
  7: export const FONT_CATEGORIES: FontCategory[] = [
  8:   "Sans Serif",
  9:   "Serif",
 10:   "Display",
 11:   "Handwriting",
 12:   "Monospace",
 13: ];
 14: export type FontFormat =
 15:   | "truetype"
 16:   | "opentype"
 17:   | "woff2"
 18:   | "woff"
 19:   | "embedded-opentype";
 20: export const NATIVE_FONT_FORMATS: FontFormat[] = ["truetype", "opentype"];
 21: export const WEB_FONT_FORMATS: FontFormat[] = [
 22:   "woff2",
 23:   "woff",
 24:   "truetype",
 25:   "opentype",
 26: ];
 27: export interface FontFamilySummary {
 28:   family: string;
 29:   category: FontCategory;
 30:   popularity: number;
 31:   designers: string[];
 32:   axes: string[];
 33: }
 34: export interface RankedFontFamily {
 35:   summary: FontFamilySummary;
 36:   score: number;
 37: }
 38: const TIER_EXACT = 1000;
 39: const TIER_CATEGORY = 900;
 40: const TIER_PREFIX = 800;
 41: const TIER_WORD_PREFIX = 700;
 42: const TIER_SUBSTRING = 600;
 43: const TIER_ALL_TOKENS = 450;
 44: const TIER_SUBSEQUENCE = 300;
 45: const CATEGORY_ALIASES: Record<string, FontCategory> = {
 46:   mono: "Monospace",
 47:   monospace: "Monospace",
 48:   monospaced: "Monospace",
 49:   code: "Monospace",
 50:   coding: "Monospace",
 51:   terminal: "Monospace",
 52:   fixedwidth: "Monospace",
 53:   hand: "Handwriting",
 54:   handwriting: "Handwriting",
 55:   handwritten: "Handwriting",
 56:   script: "Handwriting",
 57:   cursive: "Handwriting",
 58:   serif: "Serif",
 59:   sans: "Sans Serif",
 60:   sansserif: "Sans Serif",
 61:   display: "Display",
 62:   decorative: "Display",
 63:   title: "Display",
 64: };
 65: export function categoryForQuery(query: string): FontCategory | null {
 66:   const key = normalize(query).replace(/ /g, "");
 67:   return CATEGORY_ALIASES[key] ?? null;
 68: }
 69: /**
 70:  * Scores one family against a query, or returns `null` when it doesn't match at all.
 71:  *
 72:  * Exported for tests: the tier boundaries are the whole behaviour of the search box, and
 73:  * they deserve to be asserted directly rather than inferred from a result ordering.
 74:  */
 75: export function scoreFontFamily(
 76:   query: string,
 77:   family: string,
 78:   category?: FontCategory
 79: ): number | null {
 80:   const nameScore = scoreFamilyName(query, family);
 81:   // A category hit and a name hit are alternative reasons to show a font, so take
 82:   // whichever is stronger rather than letting one veto the other.
 83:   if (category && categoryForQuery(query) === category) {
 84:     return Math.max(nameScore ?? 0, TIER_CATEGORY);
 85:   }
 86:   return nameScore;
 87: }
 88: function scoreFamilyName(query: string, family: string): number | null {
 89:   const needle = normalize(query);
 90:   const hay = normalize(family);
 91:   if (!needle) return 0;
 92:   if (hay === needle) return TIER_EXACT;
 93:   if (hay.startsWith(needle)) return TIER_PREFIX + lengthAffinity(needle, hay);
 94:   const words = hay.split(" ");
 95:   if (words.some(word => word.startsWith(needle))) {
 96:     return TIER_WORD_PREFIX + lengthAffinity(needle, hay);
 97:   }
 98:   if (hay.includes(needle)) return TIER_SUBSTRING + lengthAffinity(needle, hay);
 99:   // "hand writing" should still find "Handwriting", and "mono jetbrains" find
100:   const tokens = needle.split(" ").filter(Boolean);
101:   if (tokens.length > 1 && tokens.every(token => hay.includes(token))) {
102:     return TIER_ALL_TOKENS + lengthAffinity(needle, hay);
103:   }
104:   const compactNeedle = needle.replace(/ /g, "");
105:   const compactHay = hay.replace(/ /g, "");
106:   const span = subsequenceSpan(compactNeedle, compactHay);
107:   if (span === null) return null;
108:   // A tight span means few dropped letters, so it's a closer typo than a scattered one.
109:   const tightness = compactNeedle.length / span;
110:   return TIER_SUBSEQUENCE + tightness * 50;
111: }
112: /**
113:  * Ranks the catalog against a query.
114:  *
115:  * An empty query is not an empty result: it lists the most popular families, so opening
116:  * the picker with nothing typed still shows something worth looking at.
117:  */
118: export function rankFontFamilies(
119:   query: string,
120:   catalog: FontFamilySummary[],
121:   options: { limit?: number; category?: FontCategory | null } = {}
122: ): RankedFontFamily[] {
123:   const { limit = 40, category = null } = options;
124:   const pool = category
125:     ? catalog.filter(summary => summary.category === category)
126:     : catalog;
127:   const trimmed = query.trim();
128:   if (!trimmed) {
129:     return [...pool]
130:       .sort((a, b) => a.popularity - b.popularity)
131:       .slice(0, limit)
132:       .map(summary => ({ summary, score: 0 }));
133:   }
134:   const ranked: RankedFontFamily[] = [];
135:   for (const summary of pool) {
136:     const score = scoreFontFamily(trimmed, summary.family, summary.category);
137:     if (score === null) continue;
138:     ranked.push({ summary, score });
139:   }
140:   // Popularity only ever breaks a tie within a tier — see the note on the tier constants.
141:   ranked.sort(
142:     (a, b) => b.score - a.score || a.summary.popularity - b.summary.popularity
143:   );
144:   return ranked.slice(0, limit);
145: }
146: /** Case, punctuation, and stray spacing are noise when someone is guessing at a name. */
147: function normalize(value: string): string {
148:   return value
149:     .toLowerCase()
150:     .replace(/[^a-z0-9]+/g, " ")
151:     .trim();
152: }
153: /**
154:  * Prefers the shorter of two families that match equally well, so "Roboto" outranks
155:  * "Roboto Condensed Italic" for the query "roboto". Capped well below the tier gap.
156:  */
157: function lengthAffinity(needle: string, hay: string): number {
158:   return (needle.length / hay.length) * 50;
159: }
160: function subsequenceSpan(needle: string, hay: string): number | null {
161:   let start = -1;
162:   let cursor = 0;
163:   for (const char of needle) {
164:     const found = hay.indexOf(char, cursor);
165:     if (found === -1) return null;
166:     if (start === -1) start = found;
167:     cursor = found + 1;
168:   }
169:   return start === -1 ? null : cursor - start;
170: }
</file>

<file path="src/entities/mission.ts">
  1: import { CardType, SemanticRole } from "./card";
  2: export type InsightOrigin =
  3:   | "user"
  4:   | "app"
  5:   | "agent"
  6:   | "web";
  7: export interface Insight {
  8:   text: string;
  9:   origin: InsightOrigin;
 10: }
 11: export const insight = (text: string, origin: InsightOrigin): Insight => ({
 12:   text: text.trim(),
 13:   origin,
 14: });
 15: export interface WorkingMap {
 16:   goal?: Insight;
 17:   deliverable?: Insight;
 18:   constraints: Insight[];
 19:   assumptions: Insight[];
 20:   unknowns: Insight[];
 21:   prerequisites: Insight[];
 22:   risks: Insight[];
 23:   candidateNextActions: Insight[];
 24: }
 25: export const EMPTY_WORKING_MAP: WorkingMap = {
 26:   constraints: [],
 27:   assumptions: [],
 28:   unknowns: [],
 29:   prerequisites: [],
 30:   risks: [],
 31:   candidateNextActions: [],
 32: };
 33: export interface RecommendedResearch {
 34:   query: string;
 35:   rationale: string;
 36:   sourceKinds: string[];
 37: }
 38: export interface ProposedCard {
 39:   role: SemanticRole;
 40:   type: CardType;
 41:   title: string;
 42:   body: string;
 43:   origin: InsightOrigin;
 44: }
 45: export interface MissionProposal {
 46:   title: string;
 47:   goalStatement: string;
 48:   targetDeliverable: string;
 49:   successCriteria: string[];
 50:   constraints: Insight[];
 51:   assumptions: Insight[];
 52:   firstMilestone: string;
 53:   smallestProof: string;
 54:   prerequisites: Insight[];
 55:   risks: Insight[];
 56:   unknowns: Insight[];
 57:   recommendedResearch: RecommendedResearch[];
 58:   suggestedCards: ProposedCard[];
 59: }
 60: export function mergeIntoWorkingMap(base: WorkingMap, additions: Partial<WorkingMap>): WorkingMap {
 61:   const merge = (existing: Insight[], incoming: Insight[] | undefined): Insight[] => {
 62:     if (!incoming?.length) return existing;
 63:     const seen = new Set(existing.map(item => item.text.toLowerCase()));
 64:     const fresh = incoming.filter(item => {
 65:       const key = item.text.toLowerCase();
 66:       if (!item.text || seen.has(key)) return false;
 67:       seen.add(key);
 68:       return true;
 69:     });
 70:     return fresh.length ? [...existing, ...fresh] : existing;
 71:   };
 72:   return {
 73:     goal: base.goal ?? additions.goal,
 74:     deliverable: base.deliverable ?? additions.deliverable,
 75:     constraints: merge(base.constraints, additions.constraints),
 76:     assumptions: merge(base.assumptions, additions.assumptions),
 77:     unknowns: merge(base.unknowns, additions.unknowns),
 78:     prerequisites: merge(base.prerequisites, additions.prerequisites),
 79:     risks: merge(base.risks, additions.risks),
 80:     candidateNextActions: merge(base.candidateNextActions, additions.candidateNextActions),
 81:   };
 82: }
 83: const titleCase = (text: string): string =>
 84:   text.length > 0 ? text[0].toUpperCase() + text.slice(1) : text;
 85: function toTitle(text: string, max = 60): string {
 86:   const cleaned = titleCase(text.replace(/^(i want to|i'd like to|i wanna|help me)\s+/i, "").trim());
 87:   return cleaned.length <= max ? cleaned : `${cleaned.slice(0, max - 1).trimEnd()}…`;
 88: }
 89: /**
 90:  * Builds the mission proposal from the working map.
 91:  *
 92:  * Deterministic, so the draft exists with or without a model. Where the map is silent the
 93:  * proposal says so in plain language rather than inventing a plausible-sounding milestone
 94:  * — an admitted gap is useful, and a fabricated plan is worse than none.
 95:  */
 96: export function buildMissionProposal(
 97:   map: WorkingMap,
 98:   research: RecommendedResearch[] = []
 99: ): MissionProposal {
100:   const goalText = map.goal?.text ?? "";
101:   const deliverable = map.deliverable?.text ?? "";
102:   const smallestProof =
103:     map.candidateNextActions[0]?.text ??
104:     "Define the smallest result that would prove this is working";
105:   const firstMilestone = deliverable
106:     ? `Produce a first version of: ${deliverable}`
107:     : `Decide and write down what "finished" means for this goal`;
108:   const successCriteria = [
109:     deliverable ? `${deliverable} exists and works end to end` : `A written definition of "done" exists`,
110:     `${smallestProof} — completed and checked`,
111:   ];
112:   const suggestedCards: ProposedCard[] = [];
113:   if (goalText) {
114:     suggestedCards.push({
115:       role: "goal",
116:       type: "note",
117:       title: toTitle(goalText),
118:       body: goalText,
119:       origin: map.goal!.origin,
120:     });
121:   }
122:   if (deliverable) {
123:     suggestedCards.push({
124:       role: "deliverable",
125:       type: "note",
126:       title: toTitle(deliverable),
127:       body: deliverable,
128:       origin: map.deliverable!.origin,
129:     });
130:   }
131:   suggestedCards.push({
132:     role: "task",
133:     type: "note",
134:     title: toTitle(firstMilestone),
135:     body: `First milestone.\n\n${firstMilestone}`,
136:     origin: "app",
137:   });
138:   const proof = map.candidateNextActions.find(action => action.origin !== "app");
139:   if (proof) {
140:     suggestedCards.push({
141:       role: "experiment",
142:       type: "note",
143:       title: toTitle(`Prove it: ${proof.text}`),
144:       body: [
145:         `Hypothesis: ${proof.text} is achievable with what you have now.`,
146:         `Method: build the smallest version that could demonstrate it.`,
147:         `Measurement: does it work end to end, yes or no?`,
148:         `Expected result: unknown — that is why it is worth running.`,
149:         `Next action: if it fails, the reason becomes the next prerequisite.`,
150:       ].join("\n\n"),
151:       origin: proof.origin,
152:     });
153:   }
154:   for (const prerequisite of map.prerequisites) {
155:     suggestedCards.push({
156:       role: "concept",
157:       type: "note",
158:       title: toTitle(prerequisite.text),
159:       body: prerequisite.text,
160:       origin: prerequisite.origin,
161:     });
162:   }
163:   for (const unknown of map.unknowns) {
164:     suggestedCards.push({
165:       role: "question",
166:       type: "question",
167:       title: toTitle(unknown.text),
168:       body: unknown.text,
169:       origin: unknown.origin,
170:     });
171:   }
172:   return {
173:     title: toTitle(goalText || "Untitled mission"),
174:     goalStatement: goalText,
175:     targetDeliverable: deliverable,
176:     successCriteria,
177:     constraints: map.constraints,
178:     assumptions: map.assumptions,
179:     firstMilestone,
180:     smallestProof,
181:     prerequisites: map.prerequisites,
182:     risks: map.risks,
183:     unknowns: map.unknowns,
184:     recommendedResearch: research,
185:     suggestedCards,
186:   };
187: }
188: export function describeKnownGaps(map: WorkingMap): string {
189:   if (map.unknowns.length === 0) {
190:     return "No open questions were recorded when this mission was created.";
191:   }
192:   return [
193:     "Open at the time this mission was created:",
194:     ...map.unknowns.map(
195:       item => `- ${item.text}${item.origin === "agent" ? " (agent hypothesis — verify)" : ""}`
196:     ),
197:   ].join("\n");
198: }
199: export function describeAssumptions(map: WorkingMap): string {
200:   if (map.assumptions.length === 0) {
201:     return "No assumptions were recorded when this mission was created.";
202:   }
203:   return [
204:     "This mission assumes the following. Correct anything that is wrong:",
205:     ...map.assumptions.map(item => `- ${item.text} [${item.origin}]`),
206:   ].join("\n");
207: }
</file>

<file path="src/entities/operationLog.ts">
