 1: import { SearchGateway } from "../ports/gateways/SearchGateway";
 2: import { normalizeSearchResults, ResearchResult } from "../../entities/research";
 3: import { ResearchNoResultsError } from "../errors";
 4: export class RunResearchInteractor {
 5:   constructor(private readonly searchGateway: SearchGateway) {}
 6:   async execute(query: string, now: number = Date.now()): Promise<ResearchResult[]> {
 7:     const trimmed = query.trim();
 8:     let raw;
 9:     try {
10:       raw = await this.searchGateway.search(trimmed);
11:     } catch (err: any) {
12:       throw new ResearchNoResultsError(trimmed);
13:     }
14:     if (!raw || raw.length === 0) {
15:       throw new ResearchNoResultsError(trimmed);
16:     }
17:     return normalizeSearchResults(raw, trimmed, now);
18:   }
19: }
</file>

