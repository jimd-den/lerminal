<file path="src/frameworks/ui/griot/CaptureReceipt.tsx">
  1: import React from "react";
  2: import { Pressable, StyleSheet, Text, View } from "react-native";
  3: import {
  4:   AppState,
  5:   GriotController,
  6: } from "../../../adapters/presenters/GriotController";
  7: import { presentCaptureReceipt } from "../../../adapters/presenters/CaptureReceiptPresenter";
  8: import { ArrivalView } from "../motion/communicative";
  9: import { GriotTheme, Structure, TypeScale } from "./theme";
 10: export function CaptureReceipt({
 11:   controller,
 12:   state,
 13:   theme,
 14:   onOpenOutput,
 15: }: {
 16:   controller: GriotController;
 17:   state: AppState;
 18:   theme: GriotTheme;
 19:   onOpenOutput: () => void;
 20: }) {
 21:   const receipt = presentCaptureReceipt(state);
 22:   if (!receipt) return null;
 23:   return (
 24:     <ArrivalView key={receipt.createdCards.map(card => card.id).join(",")}>
 25:     <View
 26:       accessibilityRole="alert"
 27:       accessibilityLiveRegion="polite"
 28:       style={[styles.panel, { backgroundColor: theme.panelStrong, borderColor: theme.accent }]}
 29:     >
 30:       <Text style={[styles.status, { color: theme.accent, fontFamily: theme.fontMono }]}>
 31:         RUN COMPLETE
 32:       </Text>
 33:       <Text style={[styles.summary, { color: theme.text }]}>{receipt.summary}</Text>
 34:       {receipt.localFallbackReason ? (
 35:         <View style={[styles.fallbackNotice, { borderColor: theme.warning, backgroundColor: `${theme.warning}14` }]}>
 36:           <Text style={[styles.fallbackText, { color: theme.warning }]}>
 37:             {receipt.localFallbackReason}
 38:           </Text>
 39:         </View>
 40:       ) : null}
 41:       <Text style={[styles.destination, { color: theme.textMuted }]}>
 42:         Added to {receipt.destinationLabel}
 43:         {receipt.selectionChanged ? " · now selected, ready for the next step" : ""}
 44:       </Text>
 45:       {receipt.nextActions.length > 0 ? (
 46:         <>
 47:           <Text style={[styles.nextLabel, { color: theme.textFaint, fontFamily: theme.fontMono }]}>
 48:             NEXT
 49:           </Text>
 50:           <View style={styles.actionRow}>
 51:             {receipt.nextActions.map((action) => (
 52:               <Pressable
 53:                 key={action.id}
 54:                 accessibilityRole="button"
 55:                 onPress={() => void controller.dispatchSuggestedAction(action.dispatch)}
 56:                 style={({ pressed }) => [
 57:                   styles.nextAction,
 58:                   { borderColor: theme.accent, backgroundColor: theme.accentSoft },
 59:                   pressed && styles.pressed,
 60:                 ]}
 61:               >
 62:                 <Text numberOfLines={1} style={[styles.nextActionText, { color: theme.accent }]}>
 63:                   {action.label}
 64:                 </Text>
 65:               </Pressable>
 66:             ))}
 67:           </View>
 68:         </>
 69:       ) : null}
 70:       <View style={styles.footer}>
 71:         <Pressable
 72:           accessibilityRole="button"
 73:           onPress={onOpenOutput}
 74:           style={({ pressed }) => [
 75:             styles.primary,
 76:             { backgroundColor: theme.accent },
 77:             pressed && styles.pressed,
 78:           ]}
 79:         >
 80:           <Text style={[styles.primaryText, { color: theme.accentInk, fontFamily: theme.fontMono }]}>
 81:             {receipt.primaryActionLabel}
 82:           </Text>
 83:         </Pressable>
 84:         {receipt.canUndo ? (
 85:           <Pressable
 86:             accessibilityRole="button"
 87:             onPress={() => void controller.undoLastOperation()}
 88:             style={({ pressed }) => [styles.dismiss, pressed && styles.pressed]}
 89:           >
 90:             <Text style={[styles.dismissText, { color: theme.accent, fontFamily: theme.fontMono }]}>
 91:               UNDO
 92:             </Text>
 93:           </Pressable>
 94:         ) : null}
 95:         <Pressable
 96:           accessibilityRole="button"
 97:           onPress={() => controller.dismissOperationResult()}
 98:           style={({ pressed }) => [styles.dismiss, pressed && styles.pressed]}
 99:         >
100:           <Text style={[styles.dismissText, { color: theme.textMuted, fontFamily: theme.fontMono }]}>
101:             DISMISS
102:           </Text>
103:         </Pressable>
104:       </View>
105:     </View>
106:     </ArrivalView>
107:   );
108: }
109: const styles = StyleSheet.create({
110:   pressed: { opacity: 0.7 },
111:   panel: {
112:     borderWidth: 1,
113:     borderRadius: Structure.radius,
114:     padding: Structure.gutter,
