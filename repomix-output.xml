 73:   }
 74:   private patchPending(
 75:     id: string,
 76:     changes: Partial<PendingOperation>,
 77:   ): void {
 78:     this.patch({
 79:       pending: this.current.pending.map((op) =>
 80:         op.id === id ? { ...op, ...changes } : op,
 81:       ),
 82:     });
 83:   }
 84:   begin(
 85:     commandName: string,
 86:     retry?: { pipelineText: string; inputCardIds: string[]; parentId: string | null },
 87:   ): string {
 88:     const id = this.generateId();
 89:     this.patch({
 90:       pending: [
 91:         ...this.current.pending,
 92:         {
 93:           id,
 94:           commandName,
 95:           status: "loading",
 96:           workspaceId: this.deps.host.activeWorkspaceId() ?? undefined,
 97:           ...retry,
 98:         },
 99:       ],
100:     });
101:     return id;
102:   }
103:   end(id: string): void {
104:     this.patch({ pending: this.current.pending.filter((op) => op.id !== id) });
105:   }
106:   fail(id: string, errorMessage: string): void {
107:     this.patchPending(id, { status: "error", errorMessage });
108:   }
109:   find(id: string): PendingOperation | undefined {
110:     return this.current.pending.find((op) => op.id === id);
111:   }
112:   present(result: OperationResult): void {
113:     this.patch({ result });
114:   }
115:   dismissResult(): void {
116:     this.patch({ result: null });
117:   }
118:   async openResult(): Promise<void> {
119:     const result = this.current.result;
120:     if (!result) return;
121:     await this.deps.host.navigateToResult(result);
122:     this.patch({ result: null });
123:   }
124:   markUndoable(operationId: string): void {
125:     this.patch({ undoableOperationId: operationId });
126:   }
127:   async recordCompletedRun(run: CompletedRun): Promise<string> {
128:     const record = createOperationRecord({
129:       commandName: run.commandName,
130:       workspaceId: run.workspaceId,
131:       parentId: run.parentId,
132:       inputCardIds: run.inputCardIds,
133:       createdCardIds: run.createdCards.map((card) => card.id),
134:       createdCardSnapshots: run.createdCards.map((card) => ({ ...card })),
135:       startedAt: run.startedAt,
136:       summary: run.summary,
137:     });
138:     await this.deps.operationLog.saveRecord(record);
139:     this.patch({ undoableOperationId: record.id });
140:     return record.id;
141:   }
142:   async undoLast(): Promise<boolean> {
143:     const operationId = this.current.undoableOperationId;
144:     if (!operationId) return false;
145:     const record = await this.deps.operationLog.getRecord(operationId);
146:     if (!record) {
147:       this.patch({ undoableOperationId: null });
148:       return false;
149:     }
150:     try {
151:       const result = await this.deps.undoOperation.execute(
152:         record,
153:         this.deps.host.cards(),
154:       );
155:       this.deps.host.forgetCards(result.removedCardIds);
156:       this.patch({ undoableOperationId: null, result: null });
157:       await this.deps.host.refreshCards();
158:       this.deps.host.onChange();
159:       this.deps.host.notify(result.summary);
160:       return true;
161:     } catch (error) {
162:       this.deps.host.notify(messageFor(error, "Couldn't undo that"));
163:       if (error instanceof UndoUnavailableError) {
164:         this.patch({ undoableOperationId: null });
165:       }
166:       return false;
167:     }
168:   }
169: }
</file>

