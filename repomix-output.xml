 18: }
 19: export interface WorkspacePulseViewModel {
 20:   message: string;
 21:   chips: WorkspacePulseChip[];
 22:   cardIds: string[];
 23: }
 24: const CHIPS_BY_KIND: Record<WorkspacePulseObservation["kind"], WorkspacePulseChip[]> = {
 25:   "notes-need-question": [
 26:     { id: "group-these", label: "Group these" },
 27:     { id: "dismiss", label: "Dismiss" },
 28:   ],
 29:   "unextracted-source": [
 30:     { id: "extract-source", label: "Extract source" },
 31:     { id: "dismiss", label: "Dismiss" },
 32:   ],
 33:   "unlinked-note-cluster": [
 34:     { id: "group-these", label: "Group these" },
 35:     { id: "find-sources", label: "Find sources" },
 36:     { id: "dismiss", label: "Dismiss" },
 37:   ],
 38: };
 39: export function presentWorkspacePulse(
 40:   observation: WorkspacePulseObservation | null,
 41: ): WorkspacePulseViewModel | null {
 42:   if (!observation) return null;
 43:   return {
 44:     message: observation.message,
 45:     chips: CHIPS_BY_KIND[observation.kind] ?? [{ id: "dismiss", label: "Dismiss" }],
 46:     cardIds: [...observation.cardIds],
 47:   };
 48: }
 49: export interface WorkspaceAgentMessageViewModel {
 50:   id: string;
 51:   speaker: "user" | "assistant";
 52:   text: string;
 53:   pending: boolean;
 54:   webCitations: WebCitation[];
 55:   sentContext?: WorkspaceAgentSentContextViewModel;
 56:   reasoning?: string;
 57:   segments: WorkspaceAgentSegmentViewModel[];
 58:   streaming: boolean;
 59: }
 60: export interface WorkspaceAgentTagViewModel {
 61:   id: string;
 62:   messageId: string;
 63:   kindLabel: string;
 64:   title: string;
 65:   canAdd: boolean;
 66:   detail?: string;
 67:   status: "offered" | "pending" | "done" | "failed";
 68:   items: string[];
 69: }
 70: export type WorkspaceAgentSegmentViewModel =
 71:   | { kind: "text"; text: string }
 72:   | { kind: "tag"; tag: WorkspaceAgentTagViewModel };
 73: export interface WorkspaceAgentSentContextViewModel {
 74:   groupLabel: string | null;
 75:   cards: Array<{ id: string; title: string; focus: boolean }>;
 76:   briefing: string;
 77: }
 78: export interface WorkspaceAgentContextViewModel {
 79:   workspaceName: string;
 80:   groupLabel: string | null;
 81:   cardCount: number;
 82:   focusCardTitle: string | null;
 83: }
 84: export interface WorkspaceAgentViewModel {
 85:   isOpen: boolean;
 86:   context: WorkspaceAgentContextViewModel;
 87:   messages: WorkspaceAgentMessageViewModel[];
 88:   isEmpty: boolean;
 89:   isThinking: boolean;
 90:   agentError: string | null;
 91: }
 92: const EMPTY_CONTEXT_VIEW: WorkspaceAgentContextViewModel = {
 93:   workspaceName: "",
 94:   groupLabel: null,
 95:   cardCount: 0,
 96:   focusCardTitle: null,
 97: };
 98: /**
 99:  * Projects the workflow's conversation state into the sheet's view model. `workspaces`
100:  * and `groupTitle` are looked up here rather than stored on the workflow, since the
101:  * workflow only knows ids and the workspace name can change out from under it.
102:  */
103: export function presentWorkspaceAgent(
104:   state: WorkspaceAgentState,
105:   workspaces: Workspace[],
106:   groupTitle: string | null,
107:   focusCardTitle: string | null = null,
108:   cards: Card[] = [],
109: ): WorkspaceAgentViewModel {
110:   const cardTitles = new Map(cards.map((card) => [card.id, card]));
111:   const workspace = workspaces.find((ws) => ws.id === state.workspaceId);
112:   const context: WorkspaceAgentContextViewModel = state.isOpen
113:     ? {
114:         workspaceName: workspace?.name ?? "",
115:         groupLabel: groupTitle,
116:         cardCount: contextCardIds(state.context).length,
117:         focusCardTitle: state.context.openCardId ? focusCardTitle : null,
118:       }
119:     : EMPTY_CONTEXT_VIEW;
120:   const messages = state.messages.map(message =>
121:     toMessageViewModel(message, state.tagActions, cardTitles)
122:   );
123:   return {
124:     isOpen: state.isOpen,
125:     context,
126:     messages,
127:     isEmpty: messages.length === 0,
128:     isThinking: state.isThinking,
129:     agentError: state.agentError,
130:   };
131: }
132: function toMessageViewModel(
133:   message: WorkspaceAgentMessage,
134:   tagActions: Record<string, WorkspaceAgentTagAction>,
135:   cardsById: Map<string, Card>,
136: ): WorkspaceAgentMessageViewModel {
137:   return {
138:     id: message.id,
139:     speaker: message.speaker,
140:     text: message.text,
141:     pending: message.pending ?? false,
142:     webCitations: message.webCitations ? [...message.webCitations] : [],
143:     ...(message.sentContext
144:       ? { sentContext: toSentContextViewModel(message.sentContext, cardsById) }
145:       : {}),
146:     // Copied through verbatim, and omitted entirely when the model returned none.
147:     ...(message.reasoning ? { reasoning: message.reasoning } : {}),
148:     segments: (message.segments ?? []).map(segment =>
149:       toSegmentViewModel(segment, message.id, tagActions, cardsById)
150:     ),
151:     streaming: message.streaming ?? false,
152:   };
153: }
154: function toSegmentViewModel(
155:   segment: AgentMessageSegment,
156:   messageId: string,
157:   tagActions: Record<string, WorkspaceAgentTagAction>,
158:   cardsById: Map<string, Card>,
159: ): WorkspaceAgentSegmentViewModel {
160:   if (segment.kind === "text") return { kind: "text", text: segment.text };
161:   return {
162:     kind: "tag",
163:     tag: toTagViewModel(segment.tag, messageId, tagActions[tagActionKey(messageId, segment.tag.id)], cardsById),
164:   };
165: }
166: function toTagViewModel(
167:   tag: ParsedAgentTag,
168:   messageId: string,
169:   action: WorkspaceAgentTagAction | undefined,
170:   cardsById: Map<string, Card>,
171: ): WorkspaceAgentTagViewModel {
172:   const items = tag.intent
173:     ? (toolIntentItems(tag.intent) ?? [])
174:         .map(item => (item.cardId ? (cardsById.get(item.cardId)?.title ?? item.title) : item.title))
175:     : [];
176:   return {
177:     id: tag.id,
178:     messageId,
179:     kindLabel: tag.kindLabel,
180:     title: tag.title,
181:     canAdd: tag.intent !== null,
182:     ...(action?.resultMessage
183:       ? { detail: action.resultMessage }
184:       : tag.invalidReason
185:         ? { detail: tag.invalidReason }
186:         : {}),
187:     status: action?.status === "pending"
188:       ? "pending"
189:       : action?.status === "done"
190:         ? "done"
191:         : action?.status === "failed"
192:           ? "failed"
193:           : "offered",
194:     items,
195:   };
196: }
197: function toSentContextViewModel(
198:   sent: WorkspaceAgentSentContext,
199:   cardsById: Map<string, Card>,
200: ): WorkspaceAgentSentContextViewModel {
201:   const focus = new Set(sent.focusCardIds);
202:   return {
203:     groupLabel: sent.groupId ? (cardsById.get(sent.groupId)?.title ?? sent.groupId) : null,
204:     cards: sent.cardIds.map((id) => ({
205:       id,
206:       title: cardsById.get(id)?.title ?? id,
207:       focus: focus.has(id),
208:     })),
209:     briefing: sent.briefing,
210:   };
211: }
