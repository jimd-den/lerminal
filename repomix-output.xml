<file path="src/entities/recall.ts">
 1: import { Card, createCard } from "./card";
 2: const QUESTION_SHAPES: Array<{ pattern: RegExp; phrase: (subject: string) => string }> = [
 3:   {
 4:     pattern: /because|matters/i,
 5:     phrase: (subject) => `Why does ${subject} matter?`,
 6:   },
 7:   {
 8:     pattern: /break|parts|works|by/i,
 9:     phrase: (subject) => `How does ${subject} work?`,
10:   },
11:   {
12:     pattern: /mistake|confuse|error/i,
13:     phrase: (subject) => `What’s the common mistake with ${subject}?`,
14:   },
15: ];
16: function subjectOf(title: string): string {
17:   return title.replace(/·.*$/, "").trim();
18: }
19: /** Formulates a recall question from a card's content and title. */
20: export function makeQuestion(body: string, title: string): string {
21:   const text = body.trim();
22:   const subject = subjectOf(title);
23:   const shape = QUESTION_SHAPES.find(({ pattern }) => pattern.test(text));
24:   return shape ? shape.phrase(subject.toLowerCase()) : `Recall: ${subject}`;
25: }
26: /**
27:  * Turns a content card into a question card whose answer is the original content, keeping
28:  * a reference back to the card it came from.
29:  */
30: export function recallCard(card: Card): Card {
31:   return createCard({
32:     workspaceId: card.workspaceId,
33:     type: "question",
34:     title: makeQuestion(card.body, card.title),
35:     body: "",
36:     answer: card.body,
37:     sourceRef: card.id,
38:     cite: card.cite,
39:   });
40: }
</file>

