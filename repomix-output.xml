  8: import { Logger, silentLogger } from "../ports/Logger";
  9: import { UnknownCommandError } from "../errors";
 10: import { CommandContext, PipelineCommand } from "./Command";
 11: export interface PipelineEnvironment {
 12:   workspaceId: string;
 13:   parentId: string | null;
 14:   initialInputCards: Card[];
 15:   workspaces: Workspace[];
 16:   apiKey: string;
 17:   model: string;
 18:   systemPrompt: string;
 19:   chunkSystemPrompt: string;
 20:   assistantProfiles?: AssistantProfile[];
 21:   activeProfileIds?: Partial<Record<AssistantCapability, string>>;
 22:   cardTypes?: CardTypeDefinition[];
 23:   autoGroup?: boolean;
 24:   expansionStack?: string[];
 25: }
 26: interface ParsedStage {
 27:   cmd: string;
 28:   arg: string;
 29: }
 30: export type PipelineOutcome =
 31:   | { kind: "completed"; cards: Card[] }
 32:   | {
 33:       kind: "needsInput";
 34:       mode: "ask" | "source";
 35:       command: string;
 36:       resume?: {
 37:         command: string;
 38:         inputCards: Card[];
 39:         remainingPipeline: string;
 40:       };
 41:     }
 42:   | { kind: "review" };
 43: export class PipelineRunner {
 44:   private readonly commands: Map<string, PipelineCommand>;
 45:   private readonly logger: Logger;
 46:   constructor(commands: PipelineCommand[], logger: Logger = silentLogger) {
 47:     this.commands = new Map(commands.map((c) => [c.name, c]));
 48:     this.logger = logger;
 49:   }
 50:   async run(
 51:     pipelineText: string,
 52:     env: PipelineEnvironment,
 53:   ): Promise<PipelineOutcome> {
 54:     const stages = this.parse(pipelineText);
 55:     let cards = env.initialInputCards;
 56:     for (let index = 0; index < stages.length; index += 1) {
 57:       const { cmd, arg } = stages[index];
 58:       const command = this.commands.get(cmd);
 59:       if (!command) {
 60:         throw new UnknownCommandError(cmd);
 61:       }
 62:       const ctx: CommandContext = {
 63:         workspaceId: env.workspaceId,
 64:         parentId: env.parentId,
 65:         inputCards: cards,
 66:         workspaces: env.workspaces,
 67:         apiKey: env.apiKey,
 68:         model: env.model,
 69:         systemPrompt: env.systemPrompt,
 70:         chunkSystemPrompt: env.chunkSystemPrompt,
 71:         assistantProfiles: env.assistantProfiles,
 72:         activeProfileIds: env.activeProfileIds,
 73:         cardTypes: env.cardTypes,
 74:         expansionStack: env.expansionStack ?? [],
 75:       };
 76:       const result = await command.execute(arg, ctx);
 77:       if (result.kind === "needsInput") {
 78:         this.logger.debug("pipeline.halted", { reason: "needsInput", stage: cmd });
 79:         const outerRemainder = stages
 80:           .slice(index + 1)
 81:           .map(formatPipelineStage)
 82:           .join(" | ");
 83:         const resume = result.resume ?? {
 84:           command: cmd,
 85:           inputCards: cards,
 86:           remainingPipeline: "",
 87:         };
 88:         const remainingPipeline = [resume.remainingPipeline, outerRemainder]
 89:           .filter(Boolean)
 90:           .join(" | ");
 91:         const needsContinuation = Boolean(
 92:           remainingPipeline || resume.inputCards.length || result.resume,
 93:         );
 94:         return {
 95:           kind: "needsInput",
 96:           mode: result.mode,
 97:           command: needsContinuation ? resume.command : cmd,
 98:           ...(needsContinuation
 99:             ? { resume: { ...resume, remainingPipeline } }
100:             : {}),
101:         };
102:       }
103:       if (result.kind === "review") {
104:         this.logger.debug("pipeline.halted", { reason: "review" });
105:         return { kind: "review" };
106:       }
107:       cards = result.kind === "cards" ? result.cards : [];
108:     }
109:     this.logger.debug("pipeline.completed", { outputCards: cards.length });
110:     return { kind: "completed", cards };
111:   }
112:   private parse(pipelineText: string): ParsedStage[] {
113:     const stages: ParsedStage[] = [];
114:     for (const raw of splitPipelineStages(pipelineText)) {
115:       const match = raw.match(/^([a-zA-Z0-9_-]+)\s*([\s\S]*)$/);
116:       if (!match) continue;
117:       const rawArg = match[2].trim();
118:       stages.push({
119:         cmd: match[1].toLowerCase(),
120:         arg: unquotePipelineArg(rawArg),
121:       });
122:     }
123:     return stages;
124:   }
125: }
126: function formatPipelineStage(stage: ParsedStage): string {
127:   if (!stage.arg) return stage.cmd;
128:   return `${stage.cmd} "${stage.arg.replace(/\\/g, "\\\\").replace(/"/g, '\\"')}"`;
129: }
130: function splitPipelineStages(input: string): string[] {
131:   const stages: string[] = [];
132:   let current = "";
133:   let quote: '"' | "'" | null = null;
134:   let escaped = false;
135:   for (const char of input) {
136:     if (escaped) {
137:       current += char;
138:       escaped = false;
139:       continue;
140:     }
141:     if (char === "\\") {
142:       current += char;
143:       escaped = true;
144:       continue;
145:     }
146:     if (char === '"' || char === "'") {
147:       quote = quote === char ? null : (quote ?? char);
148:       current += char;
149:       continue;
150:     }
151:     if (char === "|" && !quote) {
152:       if (current.trim()) stages.push(current.trim());
153:       current = "";
154:       continue;
155:     }
156:     current += char;
157:   }
158:   if (current.trim()) stages.push(current.trim());
159:   return stages;
160: }
161: function unquotePipelineArg(arg: string): string {
162:   const quote = arg[0];
163:   const quoted =
164:     (quote === '"' || quote === "'") && arg[arg.length - 1] === quote;
165:   const value = quoted ? arg.slice(1, -1) : arg;
166:   return value.replace(/\\([\\"'])/g, "$1");
167: }
