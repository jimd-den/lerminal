 14: export function SelectionTray({
 15:   controller,
 16:   state,
 17:   theme,
 18:   onDelete,
 19: }: {
 20:   controller: GriotController;
 21:   state: AppState;
 22:   theme: GriotTheme;
 23:   onDelete: () => void;
 24: }) {
 25:   const tray = presentSelectionTray(state);
 26:   return (
 27:     <View style={[styles.wrap, { backgroundColor: theme.panelStrong, borderColor: theme.accent }]}>
 28:       <View style={styles.head}>
 29:         <Pressable
 30:           accessibilityRole="button"
 31:           onPress={() => controller.clearSelection()}
 32:           hitSlop={8}
 33:           style={styles.clear}
 34:         >
 35:           <Text style={[styles.clearText, { color: theme.accent, fontFamily: theme.fontMono }]}>
 36:             CLEAR
 37:           </Text>
 38:         </Pressable>
 39:         <CountPulse value={tray.count}>
 40:           <Text style={[styles.count, { color: theme.text, fontFamily: theme.fontMono }]}>
 41:             {tray.count} SELECTED
 42:           </Text>
 43:         </CountPulse>
 44:         <Pressable
 45:           accessibilityRole="button"
 46:           accessibilityLabel="Delete selected items"
 47:           onPress={onDelete}
 48:           hitSlop={8}
 49:           style={styles.delete}
 50:         >
 51:           <TrashIcon color={theme.danger} size={20} />
 52:         </Pressable>
 53:       </View>
 54:       {}
 55:       <ScrollView
 56:         horizontal
 57:         showsHorizontalScrollIndicator={false}
 58:         contentContainerStyle={styles.actions}
 59:         keyboardShouldPersistTaps="handled"
 60:       >
 61:         {tray.actions.map((action) => (
 62:           <TrayButton
 63:             key={action.id}
 64:             action={action}
 65:             theme={theme}
 66:             onPress={() => {
 67:               if (!action.enabled) {
 68:                 Alert.alert(action.label, action.disabledReason ?? "Not available right now.");
 69:                 return;
 70:               }
 71:               void controller.dispatchSuggestedAction(action.dispatch);
 72:             }}
 73:           />
 74:         ))}
 75:       </ScrollView>
 76:     </View>
 77:   );
 78: }
 79: function TrayButton({
 80:   action,
 81:   theme,
 82:   onPress,
 83: }: {
 84:   action: SelectionAction;
 85:   theme: GriotTheme;
 86:   onPress: () => void;
 87: }) {
 88:   const color = action.enabled ? theme.text : theme.textFaint;
 89:   return (
