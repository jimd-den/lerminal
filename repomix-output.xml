<file path="src/usecases/pipeline/runOutcome.ts">
 1: import { Card } from "../../entities/card";
 2: export function commonParentId(cards: Card[]): string | undefined {
 3:   if (cards.length === 0) return undefined;
 4:   const parentId = cards[0].parentId;
 5:   return parentId && cards.every((card) => card.parentId === parentId)
 6:     ? parentId
 7:     : undefined;
 8: }
 9: export function wasGeneratedTogether(cards: Card[], startedAt: number): boolean {
10:   return cards.every((card) => card.createdAt >= startedAt);
11: }
12: export interface AutoGroupDecision {
13:   cards: Card[];
14:   startedAt: number;
15:   autoGroupEnabled: boolean;
16: }
17: export function shouldAutoGroup({
18:   cards,
19:   startedAt,
20:   autoGroupEnabled,
21: }: AutoGroupDecision): boolean {
22:   if (!autoGroupEnabled || cards.length === 0) return false;
23:   if (!wasGeneratedTogether(cards, startedAt)) return false;
24:   return new Set(cards.map((card) => card.parentId ?? null)).size === 1;
25: }
26: export function commandNameOf(pipelineText: string): string {
27:   return pipelineText.match(/^\s*([\w-]+)/)?.[1] ?? "command";
28: }
29: export function describeRunOutput(cards: Card[]): string {
30:   const label = cards.every((card) => card.type === "chunk") ? "study chunk" : "item";
31:   return `${cards.length} ${label}${cards.length === 1 ? "" : "s"} created`;
32: }
</file>

