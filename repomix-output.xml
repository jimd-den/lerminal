 70:     let response: Response;
 71:     try {
 72:       response = await fetch(url, { headers: { "User-Agent": userAgent } });
 73:     } catch (err: any) {
 74:       throw new Error(`Couldn't reach Google Fonts: ${err?.message ?? "network error"}`);
 75:     }
 76:     if (response.status === 400) {
 77:       throw new Error(`Google Fonts has no family called "${family}"`);
 78:     }
 79:     if (!response.ok) {
 80:       throw new Error(`Google Fonts returned ${response.status}`);
 81:     }
 82:     return response.text();
 83:   }
