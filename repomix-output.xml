<file path="src/usecases/review/GradeReviewInteractor.ts">
 1: import { Card } from "../../entities/card";
 2: import { gradeSchedule, ReviewGrade, ReviewLog } from "../../entities/schedule";
 3: import { CardRepository } from "../ports/repositories/CardRepository";
 4: import { ReviewLogRepository } from "../ports/repositories/ReviewLogRepository";
 5: import { FsrsScheduler } from "./FsrsScheduler";
 6: import { FsrsConfig, DEFAULT_FSRS_CONFIG } from "../../entities/workspace";
 7: function toGrade(grade: boolean | ReviewGrade): ReviewGrade {
 8:   if (grade === true) return "good";
 9:   if (grade === false) return "again";
10:   return grade;
11: }
12: export class GradeReviewInteractor {
13:   constructor(
14:     private readonly cardRepo: CardRepository,
15:     private readonly scheduler?: FsrsScheduler,
16:     private readonly logRepo?: ReviewLogRepository
17:   ) {}
18:   async execute(
19:     card: Card,
20:     grade: boolean | ReviewGrade,
21:     now: number = Date.now(),
22:     config: FsrsConfig = DEFAULT_FSRS_CONFIG
23:   ): Promise<Card | null> {
24:     if (!card.schedule) {
25:       return null;
26:     }
27:     const reviewGrade = toGrade(grade);
28:     let updatedSchedule = card.schedule;
29:     let reviewLog: ReviewLog | undefined;
30:     if (this.scheduler) {
31:       const outcome = this.scheduler.review(card, reviewGrade, now, config);
32:       updatedSchedule = outcome.schedule;
33:       reviewLog = outcome.log;
34:     } else {
35:       updatedSchedule = gradeSchedule(card.schedule, reviewGrade, now);
36:     }
37:     const updatedCard: Card = {
38:       ...card,
39:       schedule: updatedSchedule,
40:     };
41:     await this.cardRepo.saveCard(updatedCard);
42:     if (reviewLog && this.logRepo) {
43:       await this.logRepo.saveLog(reviewLog);
44:     }
45:     return updatedCard;
46:   }
47: }
</file>

<file path="src/usecases/review/StartReviewInteractor.ts">
 1: import { Card } from "../../entities/card";
 2: import { CardTypeDefinition, isSchedulable } from "../../entities/cardTypeDefinition";
 3: import { NothingDueError } from "../errors";
 4: function interleaveByTopic(cards: Card[]): Card[] {
 5:   const buckets = new Map<string, Card[]>();
 6:   for (const card of cards) {
 7:     const key = card.parentId ?? "__root__";
 8:     const bucket = buckets.get(key);
 9:     if (bucket) bucket.push(card);
10:     else buckets.set(key, [card]);
11:   }
12:   const queues = Array.from(buckets.values());
13:   const result: Card[] = [];
14:   let added = true;
15:   while (added) {
16:     added = false;
17:     for (const queue of queues) {
18:       const next = queue.shift();
19:       if (next) {
20:         result.push(next);
21:         added = true;
22:       }
23:     }
24:   }
25:   return result;
26: }
27: export class StartReviewInteractor {
28:   execute(
29:     cards: Card[],
30:     now: number,
31:     interleave: boolean = true,
32:     cram: boolean = false,
33:     cardTypes?: CardTypeDefinition[]
34:   ): Card[] {
35:     const schedulableCards = cards.filter(c => Boolean(c.schedule) && isSchedulable(c, cardTypes));
36:     let queue: Card[];
37:     if (cram) {
38:       queue = schedulableCards;
39:     } else {
40:       queue = schedulableCards.filter(c => c.schedule!.dueAt <= now);
41:     }
42:     if (queue.length === 0) {
43:       throw new NothingDueError();
44:     }
45:     const finalQueue = interleave ? interleaveByTopic(queue) : queue;
46:     return finalQueue;
47:   }
48: }
</file>

