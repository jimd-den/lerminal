<file path="src/entities/research.ts">
  1: import { SearchResult } from "./searchResult";
  2: export type EvidenceKind = "official-docs" | "academic" | "reference" | "tutorial" | "forum" | "unknown";
  3: export type RelevanceLabel = "High relevance" | "Possibly relevant" | "Low relevance";
  4: export type ResearchKeepState = "undecided" | "kept" | "rejected";
  5: export interface ResearchResult {
  6:   title: string;
  7:   url: string;
  8:   snippet: string;
  9:   domain: string;
 10:   query: string;
 11:   accessedAt: number;
 12:   rank: number;
 13:   evidenceKind: EvidenceKind;
 14:   relevance: RelevanceLabel;
 15:   cautions: string[];
 16:   keepState: ResearchKeepState;
 17:   extractedText?: string;
 18:   savedCardId?: string;
 19: }
 20: export function evidenceKindLabel(kind: EvidenceKind): string {
 21:   switch (kind) {
 22:     case "official-docs":
 23:       return "Official documentation";
 24:     case "academic":
 25:       return "Academic / research source";
 26:     case "reference":
 27:       return "Reference (encyclopedia-style)";
 28:     case "tutorial":
 29:       return "Tutorial; verify against specification";
 30:     case "forum":
 31:       return "Community forum; not authoritative";
 32:     case "unknown":
 33:       return "Limited provenance";
 34:   }
 35: }
 36: function extractDomain(url: string): string {
 37:   try {
 38:     return new URL(url).hostname.replace(/^www\./, "");
 39:   } catch {
 40:     return url;
 41:   }
 42: }
 43: /** Explainable, deterministic domain classification — no opaque scoring. */
 44: export function classifyEvidenceKind(url: string): EvidenceKind {
 45:   const domain = extractDomain(url).toLowerCase();
 46:   if (
 47:     domain.endsWith(".gov") ||
 48:     domain.endsWith(".edu") ||
 49:     domain.includes("arxiv.org") ||
 50:     domain.includes("ncbi.nlm.nih.gov") ||
 51:     domain.includes("nature.com") ||
 52:     domain.includes("acm.org") ||
 53:     domain.includes("ieee.org")
 54:   ) {
 55:     return "academic";
 56:   }
 57:   if (domain.includes("wikipedia.org")) return "reference";
 58:   if (
 59:     domain.startsWith("docs.") ||
 60:     domain.startsWith("developer.") ||
 61:     domain.includes("readthedocs.io") ||
 62:     domain.includes("github.com") ||
 63:     domain.includes("mdn")
 64:   ) {
 65:     return "official-docs";
 66:   }
 67:   if (domain.includes("stackoverflow.com") || domain.includes("reddit.com") || domain.includes("forum")) {
 68:     return "forum";
 69:   }
 70:   if (domain.includes("medium.com") || domain.includes("blog") || domain.includes("tutorial")) {
 71:     return "tutorial";
 72:   }
 73:   return "unknown";
 74: }
 75: function tokenize(text: string): string[] {
 76:   return text
 77:     .toLowerCase()
 78:     .replace(/[^\p{L}\p{N}\s]/gu, " ")
 79:     .split(/\s+/)
 80:     .filter(w => w.length > 2);
 81: }
 82: export function assessRelevance(query: string, title: string, snippet: string): RelevanceLabel {
 83:   const queryWords = new Set(tokenize(query));
 84:   if (queryWords.size === 0) return "Possibly relevant";
 85:   const resultWords = new Set(tokenize(`${title} ${snippet}`));
 86:   let overlap = 0;
 87:   for (const word of queryWords) {
 88:     if (resultWords.has(word)) overlap += 1;
 89:   }
 90:   const ratio = overlap / queryWords.size;
 91:   if (ratio >= 0.6) return "High relevance";
 92:   if (ratio >= 0.25) return "Possibly relevant";
 93:   return "Low relevance";
 94: }
 95: function buildCautions(kind: EvidenceKind, isDuplicateDomain: boolean): string[] {
 96:   const cautions: string[] = [];
 97:   if (kind === "tutorial") cautions.push("Tutorial — verify against official documentation");
 98:   if (kind === "forum") cautions.push("Community discussion — not authoritative");
 99:   if (kind === "unknown") cautions.push("Limited provenance signals for this domain");
100:   if (isDuplicateDomain) cautions.push("Same domain as an earlier result in this list");
101:   return cautions;
102: }
103: export function normalizeSearchResults(
104:   raw: SearchResult[],
105:   query: string,
106:   now: number = Date.now()
107: ): ResearchResult[] {
108:   const seenDomains = new Set<string>();
109:   return raw.map((result, index) => {
110:     const domain = extractDomain(result.url);
111:     const isDuplicateDomain = seenDomains.has(domain);
112:     seenDomains.add(domain);
113:     const evidenceKind = classifyEvidenceKind(result.url);
114:     return {
115:       title: result.title,
116:       url: result.url,
117:       snippet: result.snippet,
118:       domain,
119:       query,
120:       accessedAt: now,
121:       rank: index + 1,
122:       evidenceKind,
123:       relevance: assessRelevance(query, result.title, result.snippet),
124:       cautions: buildCautions(evidenceKind, isDuplicateDomain),
125:       keepState: "undecided",
126:     };
127:   });
128: }
</file>

