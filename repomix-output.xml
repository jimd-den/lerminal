 587:   private buildOperationsWorkflow(deps: GriotControllerDeps): OperationsWorkflow {
 588:       return new OperationsWorkflow({
 589:         operationLog: this.operationLogRepo,
 590:         undoOperation: this.undoOperationInteractor,
 591:         host: {
 592:           cards: () => this.domain.cards,
 593:           activeWorkspaceId: () => this.domain.activeWorkspaceId,
 594:           onChange: () => this.emit(),
 595:           notify: (message) => this.showToast(message),
 596:           forgetCards: (removedCardIds) => this.session.forgetCards(removedCardIds),
 597:           refreshCards: () => this.loadCardsForActiveWorkspace(),
 598:           navigateToResult: async (result) => {
 599:             if (result.destination.spaceId !== this.domain.activeWorkspaceId) {
 600:               await this.switchWorkspace(result.destination.spaceId);
