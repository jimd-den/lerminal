  9: } from "../../usecases/ports/gateways/AgentGateway";
 10: import { AssistantCapability, OutputContractKind } from "../../entities/assistantProfile";
 11: import { composeCardPrompt, DEFAULT_CARD_INSTRUCTION } from "../../entities/promptPreset";
 12: const GOAL_ARCHITECT_SYSTEM_PROMPT = `You are a goal architect helping someone turn an ambition into an achievable learning mission.
 13: You are given the user's answers so far and the app's current working map. Respond with a single JSON object:
 14: {
 15:   "message": "brief prose: what you noticed, or what you'd add. 2-4 sentences.",
 16:   "question": { "id": "kebab-id", "prompt": "one high-leverage question", "rationale": "why it matters", "optional": true, "choices": ["optional", "suggested answers"] },
 17:   "workingMap": {
 18:     "goal": "restated goal, only if the user's is unclear",
 19:     "deliverable": "concrete finished artifact, only if implied but unstated",
 20:     "constraints": [], "assumptions": [], "unknowns": [],
 21:     "prerequisites": [], "risks": [], "candidateNextActions": []
 22:   },
 23:   "recommendedResearch": [ { "query": "a real search query", "rationale": "why", "sourceKinds": ["official docs","comparable project","paper","tutorial"] } ]
 24: }
 25: Rules:
 26: - Everything you contribute is treated as a hypothesis the user must verify. Do not state guesses as facts.
 27: - NEVER claim you searched, read, browsed, or cited anything. You have no web access. Suggest queries in recommendedResearch; the app runs them only with the user's approval.
 28: - Never invent what the user told you. If something is unknown, put it in "unknowns".
 29: - Ask at most ONE question, and only if it materially reduces ambiguity. Omit "question" entirely otherwise.
 30: - Prefer reducing scope and validating early over aspirational planning. Challenge vague goals directly but respectfully.
 31: - Propose concrete, testable milestones and experiments. No lectures, no motivational filler.
 32: - Omit any field you have nothing real to add to. Empty is better than padded.
 33: - Output JSON only. No markdown fences, no commentary.`;
 34: const PROMPT_ARCHITECT_SYSTEM_PROMPT = `You are a prompt architect for a study application.
 35: Convert the learner's goal into a concise system instruction for one named assistant capability. Ask at most one clarifying question if needed.
 36: The instruction must:
 37: - Define the assistant's role and learning outcome
 38: - State preferred depth, style, and priorities
 39: - Require grounding in supplied material
 40: - Tell the assistant to say when source support is missing
 41: - Avoid output-format instructions, JSON schemas, tool use, or app policies
 42: - Be under 250 words
 43: Return JSON only:
 44: {
 45:   "needsClarification": boolean,
 46:   "question": "string or null",
 47:   "nameSuggestion": "string",
 48:   "description": "string",
 49:   "systemPrompt": "string or null"
 50: }`;
 51: export class OpenRouterAgentGateway implements AgentGateway {
 52:   async ask(
 53:     query: string,
 54:     contextCards: Card[],
 55:     apiKey: string,
 56:     model: string,
 57:     systemPrompt?: string,
 58:     outputContract: OutputContractKind = "cards-v1"
 59:   ): Promise<AgentAskResult> {
 60:     const logTimestamp = new Date().toISOString();
 61:     const modelToUse = model;
 62:     const cleanKey = apiKey?.trim() || "";
 63:     const keyPrefix = cleanKey ? `${cleanKey.substring(0, 10)}... (len: ${cleanKey.length})` : "EMPTY";
 64:     console.log(`[${logTimestamp}] [OpenRouterAgentGateway.ask] query="${query}" | contextCardsCount=${contextCards.length} | model="${modelToUse}" | apiKey="${keyPrefix}"`);
 65:     if (cleanKey && cleanKey.includes(" ")) {
 66:       throw new Error("Invalid OpenRouter API key (contains spaces). Please update your key in Settings.");
 67:     }
 68:     if (!cleanKey) {
 69:       console.warn(`[${logTimestamp}] [OpenRouterAgentGateway] API Key is missing. Falling back to local generation.`);
 70:       return this.localFallback(query, "No OpenRouter API key is configured");
 71:     }
 72:     const contextText = contextCards
 73:       .map(card => `[Card Title: ${card.title}]\n${card.body}`)
 74:       .join("\n\n")
 75:       .substring(0, 3000);
 76:     const instruction = systemPrompt?.trim() || DEFAULT_CARD_INSTRUCTION;
 77:     const activeSystemPrompt = composeCardPrompt(instruction, outputContract);
 78:     const userPrompt = `${contextText ? `Use this source context to extract and base your facts on:\n${contextText}\n\n` : ""}Query: ${query}`;
 79:     try {
 80:       const response = await fetch("https:
 81:         method: "POST",
 82:         headers: {
 83:           "Content-Type": "application/json",
 84:           "Authorization": `Bearer ${cleanKey}`,
 85:           "HTTP-Referer": "https://github.com/dbslim/lerminal",
 86:           "X-Title": "GRIOT",
 87:         },
 88:         body: JSON.stringify({
 89:           model: modelToUse,
 90:           messages: [
 91:             {
 92:               role: "system",
 93:               content: activeSystemPrompt,
 94:             },
 95:             {
 96:               role: "user",
 97:               content: userPrompt,
 98:             },
 99:           ],
100:         }),
101:       });
102:       if (!response.ok) {
103:         let errMsg = `HTTP error: ${response.status} ${response.statusText}`;
104:         try {
105:           const errData = await response.json();
106:           if (errData && errData.error && errData.error.message) {
107:             errMsg += ` - ${errData.error.message}`;
108:           }
109:         } catch (e) {
110:           try {
111:             const text = await response.text();
