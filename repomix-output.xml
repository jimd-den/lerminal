116:   },
117:   status: { fontSize: TypeScale.label, fontWeight: "900", letterSpacing: 1.4 },
118:   summary: { fontSize: TypeScale.title, lineHeight: 28, fontWeight: "700", marginTop: 8 },
119:   destination: { fontSize: TypeScale.meta, lineHeight: 19, marginTop: 5 },
120:   fallbackNotice: { borderWidth: 1, borderRadius: 10, padding: 10, marginTop: 10 },
121:   fallbackText: { fontSize: TypeScale.meta, lineHeight: 18, fontWeight: "600" },
122:   nextLabel: { fontSize: TypeScale.label, fontWeight: "900", letterSpacing: 1.2, marginTop: 14 },
123:   actionRow: { flexDirection: "row", flexWrap: "wrap", gap: 8, marginTop: 8 },
124:   nextAction: {
125:     minHeight: Structure.tap,
126:     borderWidth: 1,
127:     borderRadius: Structure.radiusControl,
128:     paddingHorizontal: 12,
129:     justifyContent: "center",
130:     maxWidth: "100%",
131:   },
132:   nextActionText: { fontSize: TypeScale.body, fontWeight: "700" },
133:   footer: { flexDirection: "row", alignItems: "center", gap: 14, marginTop: 16 },
134:   primary: { minHeight: Structure.tapLarge, paddingHorizontal: 17, borderRadius: 10, justifyContent: "center" },
