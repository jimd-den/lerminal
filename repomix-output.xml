 11: class RecordingHost implements OperationsHost {
 12:   cardList: Card[] = [];
 13:   workspaceId: string | null = "w1";
 14:   changes = 0;
 15:   messages: string[] = [];
 16:   forgotten: string[][] = [];
 17:   refreshes = 0;
