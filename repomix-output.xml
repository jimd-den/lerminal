<file path="src/usecases/mission/MissionWorkflow.ts">
  1: import { Card } from "../../entities/card";
  2: import {
  3:   createWorkspaceMission,
  4:   updateWorkspaceMission,
  5:   Workspace,
  6:   WorkspacePhase,
  7: } from "../../entities/workspace";
  8: import { UseCaseError } from "../errors";
  9: import { WorkspaceRepository } from "../ports/repositories/WorkspaceRepository";
 10: import { GapReport, GapReportInteractor, summarizeGapReportForPrompt } from "../report/GapReportInteractor";
 11: import { GenerateSyllabusInteractor } from "../agent/GenerateSyllabusInteractor";
 12: export interface MissionDraft {
 13:   goalTitle: string;
 14:   goalDescription: string;
 15:   successCriteria: string[];
 16:   targetDeliverable: string;
 17: }
 18: export const EMPTY_MISSION_DRAFT: MissionDraft = {
 19:   goalTitle: "",
 20:   goalDescription: "",
 21:   successCriteria: [],
 22:   targetDeliverable: "",
 23: };
 24: export interface MissionState {
 25:   draft: MissionDraft;
 26:   isEditorOpen: boolean;
 27:   isGapReportOpen: boolean;
 28: }
 29: /** What a syllabus run produced, for the app to turn into a receipt. */
 30: export interface SyllabusOutcome {
 31:   group: Card;
 32:   items: Card[];
 33:   workspaceId: string;
 34: }
 35: export interface MissionHost {
 36:   activeWorkspace(): Workspace | undefined;
 37:   /** The cards the gap report reasons over. */
 38:   cards(): Card[];
 39:   apiKey(): string;
 40:   model(): string;
 41:   onChange(): void;
 42:   notify(message: string): void;
 43:   /** A workspace was persisted; refresh the app's copy. */
 44:   onWorkspaceSaved(workspace: Workspace): void;
 45:   /** Hand the user's report to the status-report preflight, pre-filled. */
 46:   openStatusReportPreflight(prompt: string): void;
 47:   onSyllabusCreated(outcome: SyllabusOutcome): Promise<void>;
 48:   /** Long-running work the activity indicator should show. Returns an operation id. */
 49:   beginOperation(label: string): string;
 50:   endOperation(operationId: string): void;
 51:   failOperation(operationId: string, message: string): void;
 52: }
 53: export interface MissionWorkflowDeps {
 54:   workspaceRepo: WorkspaceRepository;
 55:   gapReport: GapReportInteractor;
 56:   generateSyllabus: GenerateSyllabusInteractor;
 57:   host: MissionHost;
 58: }
 59: const messageFor = (error: unknown, fallback: string): string =>
 60:   error instanceof UseCaseError ? error.userMessage : fallback;
 61: /** Reads a workspace's mission back out as an editable draft. */
 62: const draftFrom = (workspace: Workspace | undefined): MissionDraft => {
 63:   const mission = workspace?.mission;
 64:   if (!mission) return { ...EMPTY_MISSION_DRAFT };
 65:   return {
 66:     goalTitle: mission.goalTitle,
 67:     goalDescription: mission.goalDescription,
 68:     successCriteria: [...mission.successCriteria],
 69:     targetDeliverable: mission.targetDeliverable,
 70:   };
 71: };
 72: export class MissionWorkflow {
 73:   private current: MissionState = {
 74:     draft: { ...EMPTY_MISSION_DRAFT },
 75:     isEditorOpen: false,
 76:     isGapReportOpen: false,
 77:   };
 78:   constructor(private readonly deps: MissionWorkflowDeps) {}
 79:   get state(): MissionState {
 80:     return this.current;
 81:   }
 82:   private patch(changes: Partial<MissionState>): void {
 83:     this.current = { ...this.current, ...changes };
 84:     this.deps.host.onChange();
 85:   }
 86:   private patchDraft(changes: Partial<MissionDraft>): void {
 87:     this.patch({ draft: { ...this.current.draft, ...changes } });
 88:   }
 89:   // --- Gap report: deterministic, model-free, computed fresh every time ---
 90:   /** Never cached: the report is a view of current cards, not a stored artifact. */
 91:   computeGapReport(): GapReport | null {
 92:     const workspace = this.deps.host.activeWorkspace();
 93:     if (!workspace) return null;
 94:     return this.deps.gapReport.execute(workspace, this.deps.host.cards());
 95:   }
 96:   openGapReport(): void {
 97:     this.patch({ isGapReportOpen: true });
 98:   }
 99:   closeGapReport(): void {
100:     this.patch({ isGapReportOpen: false });
101:   }
102:   /**
103:    * Closes the report and opens the status-report preflight pre-filled with the current
104:    * findings — the UI never has to know how that prompt is built.
105:    */
106:   enrichGapReport(): void {
107:     const report = this.computeGapReport();
108:     if (!report) return;
109:     this.patch({ isGapReportOpen: false });
110:     this.deps.host.openStatusReportPreflight(summarizeGapReportForPrompt(report));
111:   }
112:   // --- Mission editor ---
113:   openEditor(): void {
114:     this.patch({
115:       draft: draftFrom(this.deps.host.activeWorkspace()),
116:       isEditorOpen: true,
117:     });
118:   }
119:   closeEditor(): void {
120:     this.patch({ isEditorOpen: false });
121:   }
122:   updateDraft(patch: Partial<MissionDraft>): void {
123:     this.patchDraft(patch);
124:   }
125:   addCriterion(text: string): void {
126:     const trimmed = text.trim();
127:     if (!trimmed) return;
128:     this.patchDraft({ successCriteria: [...this.current.draft.successCriteria, trimmed] });
129:   }
130:   removeCriterion(index: number): void {
131:     this.patchDraft({
132:       successCriteria: this.current.draft.successCriteria.filter((_, i) => i !== index),
133:     });
134:   }
135:   /** Persists the draft onto the active workspace. A mission needs a goal to be a mission. */
136:   async saveDraft(): Promise<void> {
137:     const workspace = this.deps.host.activeWorkspace();
138:     if (!workspace) return;
139:     const draft = this.current.draft;
140:     if (!draft.goalTitle.trim()) {
141:       this.deps.host.notify("Give the mission a goal title first");
142:       return;
143:     }
144:     const fields = {
145:       goalTitle: draft.goalTitle,
146:       goalDescription: draft.goalDescription,
147:       successCriteria: draft.successCriteria,
148:       targetDeliverable: draft.targetDeliverable,
149:     };
150:     const mission = workspace.mission
151:       ? updateWorkspaceMission(workspace.mission, fields)
152:       : createWorkspaceMission(fields);
153:     await this.persist({ ...workspace, mission });
154:     this.patch({ isEditorOpen: false });
155:     this.deps.host.notify(`Mission saved: ${mission.goalTitle}`);
156:   }
157:   async setPhase(phase: WorkspacePhase): Promise<void> {
158:     const workspace = this.deps.host.activeWorkspace();
159:     if (!workspace?.mission) return;
160:     await this.persist({
161:       ...workspace,
162:       mission: updateWorkspaceMission(workspace.mission, { currentPhase: phase }),
163:     });
164:     this.deps.host.onChange();
165:   }
166:   private async persist(workspace: Workspace): Promise<void> {
167:     await this.deps.workspaceRepo.saveWorkspace(workspace);
168:     this.deps.host.onWorkspaceSaved(workspace);
169:   }
170:   async generateSyllabus(): Promise<void> {
171:     const workspace = this.deps.host.activeWorkspace();
172:     if (!workspace?.mission) {
173:       this.deps.host.notify("Define a mission first");
174:       return;
175:     }
176:     if (!this.deps.host.apiKey().trim()) {
177:       this.deps.host.notify("Add your OpenRouter key in Settings");
178:       return;
179:     }
180:     const operationId = this.deps.host.beginOperation("Generating syllabus…");
181:     try {
182:       const { group, items } = await this.deps.generateSyllabus.execute({
183:         mission: workspace.mission,
184:         workspaceId: workspace.id,
185:         apiKey: this.deps.host.apiKey(),
186:         model: this.deps.host.model(),
187:       });
188:       this.deps.host.endOperation(operationId);
189:       await this.deps.host.onSyllabusCreated({ group, items, workspaceId: workspace.id });
190:     } catch (error) {
191:       const message = messageFor(error, "Could not generate syllabus");
192:       this.deps.host.failOperation(operationId, message);
193:       this.deps.host.notify(message);
194:     }
195:   }
196: }
