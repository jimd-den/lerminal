ng:12px;font:13px 'Plus Jakarta Sans'}.input::placeholder{color:#6e8070}.hint{font-size:11px;color:#829283;margin:8px 1px 17px}.full{width:100%;padding:13px;border:0;border-radius:12px;background:var(--lime);color:#18200d;font-weight:800}.link{width:100%;padding:12px;border:0;background:none;color:var(--muted);font-size:12px}.label{color:var(--lime);margin-bottom:8px}.card{position:relative;border:1px solid #304537;background:#101711;border-radius:13px;padding:12px 12px 12px 16px;margin-bottom:9px}.card:before{content:"";position:absolute;left:0;top:11px;bottom:11px;width:3px;background:var(--green);border-radius:4px}.card.blue:before{background:var(--blue)}.card.amber:before{background:var(--amber)}.card.rose:before{background:var(--rose)}.tag{font:9px 'DM Mono',monospace;letter-spacing:.11em;color:var(--green)}.card h3{font-size:14px;letter-spacing:-.02em;margin:5px 0 4px}.card p{margin:0;font-size:11px;line-height:1.45;color:var(--muted)}.mission{border:1px solid #526845;background:linear-gradient(135deg,#1c2917,#111912);padding:14px;border-radius:16px;margin-bottom:14px}.mission h2{font-size:17px;letter-spacing:-.03em;margin:5px 0}.mission p{font-size:11px;color:var(--muted);margin:0}.trio{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:12px}.metric{border:1px solid #3b4c39;background:#111811;border-radius:9px;padding:8px}.metric b{font-size:18px}.metric span{display:block;color:#879787;font:8px 'DM Mono',monospace;margin-top:2px}.section{color:var(--lime);margin:14px 2px 8px}.dock{position:absolute;left:12px;right:12px;bottom:13px;display:flex;gap:6px;padding:7px;background:#182119ee;border:1px solid #496049;border-radius:15px;backdrop-filter:blur(8px)}.dock button{flex:1;padding:10px 3px;border:0;border-radius:8px;background:#293b2b;color:var(--txt);font-size:10px;font-weight:800}.dock .main{background:var(--lime);color:#15200c}.choice{display:grid;gap:7px;margin:14px 0}.choice button{background:#101711;color:var(--txt);border:1px solid #34