<file path="src/usecases/selection/deletionPlan.ts">
 1: import { Card } from "../../entities/card";
 2: export interface DeletionRequest {
 3:   cards: Card[];
 4:   selectedIds: Set<string>;
 5:   currentGroupId: string | null;
 6:   recursiveGroups: boolean;
 7: }
 8: export interface DeletionPlan {
 9:   selected: Card[];
10:   toDelete: Card[];
11:   nextGroupId: string | null;
12: }
13: function indexById(cards: Card[]): Map<string, Card> {
14:   return new Map(cards.map((card) => [card.id, card]));
15: }
16: function ancestorIds(card: Card, byId: Map<string, Card>): string[] {
17:   const chain: string[] = [];
18:   let parentId = card.parentId;
19:   while (parentId) {
20:     chain.push(parentId);
21:     parentId = byId.get(parentId)?.parentId;
22:   }
23:   return chain;
24: }
25: const depthOf = (card: Card, byId: Map<string, Card>): number =>
26:   ancestorIds(card, byId).length;
27: const hasSelectedAncestor = (
28:   card: Card,
29:   selectedIds: Set<string>,
30:   byId: Map<string, Card>,
31: ): boolean => ancestorIds(card, byId).some((id) => selectedIds.has(id));
32: function resolveNextGroup(
33:   request: DeletionRequest,
34:   selected: Card[],
35:   byId: Map<string, Card>,
36: ): string | null {
37:   const { currentGroupId, recursiveGroups } = request;
38:   if (!currentGroupId) return null;
39:   const currentGroup = byId.get(currentGroupId);
40:   if (!recursiveGroups) {
41:     return selected.some((card) => card.id === currentGroupId)
42:       ? (currentGroup?.parentId ?? null)
43:       : currentGroupId;
44:   }
45:   const chain = [currentGroupId, ...(currentGroup ? ancestorIds(currentGroup, byId) : [])];
46:   const doomedAncestor = selected
47:     .filter((card) => card.type === "group" && chain.includes(card.id))
48:     .sort((left, right) => depthOf(left, byId) - depthOf(right, byId))[0];
49:   return doomedAncestor ? (doomedAncestor.parentId ?? null) : currentGroupId;
50: }
51: export function planDeletion(request: DeletionRequest): DeletionPlan {
52:   const byId = indexById(request.cards);
53:   const selected = request.cards.filter((card) => request.selectedIds.has(card.id));
54:   const toDelete = selected
55:     .filter(
56:       (card) =>
57:         !request.recursiveGroups ||
58:         !hasSelectedAncestor(card, request.selectedIds, byId),
59:     )
60:     .sort((left, right) => depthOf(right, byId) - depthOf(left, byId));
61:   return {
62:     selected,
63:     toDelete,
64:     nextGroupId: resolveNextGroup(request, selected, byId),
65:   };
66: }
</file>

