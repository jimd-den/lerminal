 2: import { Pressable, StyleSheet, Text, View } from "react-native";
 3: import { Card } from "../../../entities/card";
 4: import { presentRole } from "../../../adapters/presenters/MissionCanvasPresenter";
 5: import { GriotTheme, Structure, TypeScale } from "./theme";
 6: import { toneColor } from "./MissionCanvas";
 7: export function ContextCardRow({
 8:   card,
 9:   theme,
10:   selected,
11:   onPress,
12:   onLongPress,
13: }: {
14:   card: Card;
15:   theme: GriotTheme;
16:   selected: boolean;
17:   onPress: () => void;
18:   onLongPress?: () => void;
19: }) {
20:   const role = presentRole(card.role);
21:   const railColor = role ? toneColor(role.tone, theme) : theme.line;
22:   return (
23:     <Pressable
24:       accessibilityRole="button"
25:       accessibilityState={{ selected }}
26:       accessibilityLabel={role ? `${role.label}: ${card.title}` : card.title}
27:       onPress={onPress}
28:       onLongPress={onLongPress}
29:       style={({ pressed }) => [
30:         styles.row,
31:         {
32:           backgroundColor: selected ? theme.accentSoft : theme.panel,
33:           borderColor: selected ? theme.accent : theme.line,
34:         },
35:         pressed && styles.pressed,
36:       ]}
37:     >
38:       <View style={[styles.rail, { backgroundColor: railColor }]} />
39:       <View style={styles.copy}>
40:         {role ? (
41:           <Text style={[styles.roleLabel, { color: railColor, fontFamily: theme.fontMono }]}>
42:             {role.label}
43:           </Text>
44:         ) : null}
45:         <Text
46:           numberOfLines={2}
47:           style={[styles.title, { color: theme.text, fontFamily: theme.fontSans }]}
48:         >
49:           {card.title}
50:         </Text>
51:         {card.body ? (
52:           <Text numberOfLines={2} style={[styles.body, { color: theme.textMuted }]}>
53:             {card.body}
54:           </Text>
55:         ) : null}
56:         {}
57:         {card.provenance?.mode === "search" || card.provenance?.mode === "extraction" ? (
58:           <Text style={[styles.provenance, { color: theme.evidence, fontFamily: theme.fontMono }]}>
59:             WEB EVIDENCE
60:           </Text>
61:         ) : card.provenance?.isLocalFallback ? (
62:           <Text style={[styles.provenance, { color: theme.warning, fontFamily: theme.fontMono }]}>
63:             NO MODEL ANSWERED — LOCAL TEMPLATE
64:           </Text>
65:         ) : null}
66:       </View>
67:     </Pressable>
68:   );
69: }
70: const styles = StyleSheet.create({
