<file path="src/usecases/agent/GenerateSyllabusInteractor.ts">
 1: import { AgentGateway } from "../ports/gateways/AgentGateway";
 2: import { CardRepository } from "../ports/repositories/CardRepository";
 3: import { BUILTIN_ASSISTANT_PROFILES } from "../../entities/assistantProfile";
 4: import { Card, createCard } from "../../entities/card";
 5: import { createProvenance } from "../../entities/provenance";
 6: import { WorkspaceMission } from "../../entities/workspace";
 7: import { AgentRequestError, MissingApiKeyError } from "../errors";
 8: import { buildQueryStrategistPrompt } from "./SuggestSearchQueriesInteractor";
 9: const SYLLABUS_PROFILE = BUILTIN_ASSISTANT_PROFILES.find(p => p.id === "builtin-syllabus-planner")!;
10: export interface GenerateSyllabusRequest {
11:   mission: WorkspaceMission;
12:   workspaceId: string;
13:   apiKey: string;
14:   model: string;
15: }
16: export interface GeneratedSyllabus {
17:   group: Card;
18:   items: Card[];
19: }
20: export class GenerateSyllabusInteractor {
21:   constructor(
22:     private readonly agentGateway: AgentGateway,
23:     private readonly cardRepo: CardRepository
24:   ) {}
25:   async execute(request: GenerateSyllabusRequest): Promise<GeneratedSyllabus> {
26:     if (!request.apiKey?.trim()) {
27:       throw new MissingApiKeyError("Generating a syllabus");
28:     }
29:     const askResult = await this.agentGateway.ask(
30:       buildQueryStrategistPrompt(request.mission.goalTitle, request.mission),
31:       [],
32:       request.apiKey,
33:       request.model,
34:       SYLLABUS_PROFILE.systemPrompt,
35:       "cards-v1"
36:     );
37:     if (askResult.isLocalFallback) {
38:       throw new AgentRequestError(
39:         askResult.fallbackReason ?? "No model answered, so no syllabus was generated"
40:       );
41:     }
42:     const responses = askResult.cards;
43:     const valid = responses.filter(
44:       r => typeof r?.title === "string" && r.title.trim() && typeof r?.body === "string"
45:     );
46:     if (valid.length === 0) {
47:       throw new AgentRequestError("The model didn't return a usable syllabus.");
48:     }
49:     const group = createCard({
50:       workspaceId: request.workspaceId,
51:       type: "group",
52:       title: `Syllabus: ${request.mission.goalTitle}`,
53:       body: "",
54:       provenance: createProvenance({ mode: "agent", model: request.model }),
55:     });
56:     const items = valid.map(item =>
57:       createCard({
58:         workspaceId: request.workspaceId,
59:         type: "note",
60:         role: "concept",
61:         title: item.title.trim(),
62:         body: item.body.trim(),
63:         parentId: group.id,
64:         provenance: createProvenance({ mode: "agent", model: request.model }),
65:       })
66:     );
67:     await this.cardRepo.saveCards([group, ...items]);
68:     return { group, items };
69:   }
70: }
</file>

<file path="src/usecases/card/DeleteCardInteractor.ts">
 1: import { Card } from "../../entities/card";
 2: import { CardRepository } from "../ports/repositories/CardRepository";
 3: import { directChildren } from "../../entities/tree";
 4: export class DeleteCardInteractor {
 5:   constructor(private readonly cardRepo: CardRepository) {}
 6:   async execute(card: Card, recursive: boolean = false): Promise<void> {
 7:     const all = await this.cardRepo.getCardsByWorkspace(card.workspaceId);
 8:     if (recursive) {
 9:       for (const descendant of this.collectDescendants(all, card.id)) {
10:         await this.cardRepo.deleteCard(descendant.id);
11:       }
12:       await this.cardRepo.deleteCard(card.id);
13:       return;
14:     }
15:     for (const child of directChildren(all, card.id)) {
16:       await this.cardRepo.saveCard({ ...child, parentId: card.parentId });
17:     }
18:     await this.cardRepo.deleteCard(card.id);
19:   }
20:   private collectDescendants(all: Card[], rootId: string): Card[] {
21:     const out: Card[] = [];
22:     const stack = directChildren(all, rootId);
23:     while (stack.length > 0) {
24:       const node = stack.pop()!;
25:       out.push(node);
26:       stack.push(...directChildren(all, node.id));
27:     }
28:     return out;
29:   }
30: }
</file>

