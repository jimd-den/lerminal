263:   streamChat(
264:     messages: ChatMessage[],
265:     apiKey: string,
266:     model: string,
267:     onToken: (delta: string) => void
268:   ): Promise<string> {
269:     return new Promise((resolve, reject) => {
270:       const cleanKey = apiKey?.trim();
271:       if (!cleanKey) {
272:         reject(new Error("Missing OpenRouter API key"));
273:         return;
274:       }
275:       const xhr = new XMLHttpRequest();
276:       xhr.open("POST", "https://openrouter.ai/api/v1/chat/completions");
277:       xhr.setRequestHeader("Content-Type", "application/json");
278:       xhr.setRequestHeader("Authorization", `Bearer ${cleanKey}`);
279:       xhr.setRequestHeader("HTTP-Referer", "https://github.com/dbslim/lerminal");
280:       xhr.setRequestHeader("X-Title", "GRIOT");
281:       let processed = 0;
282:       let full = "";
283:       const drain = () => {
284:         const data = xhr.responseText;
285:         let nl: number;
286:         while ((nl = data.indexOf("\n", processed)) !== -1) {
287:           const line = data.substring(processed, nl).trim();
288:           processed = nl + 1;
289:           if (!line.startsWith("data:")) continue;
290:           const payload = line.slice(5).trim();
291:           if (payload === "" || payload === "[DONE]") continue;
292:           try {
293:             const json = JSON.parse(payload);
294:             const delta = json.choices?.[0]?.delta?.content || "";
295:             if (delta) {
296:               full += delta;
297:               onToken(delta);
298:             }
299:           } catch {
300:             // Ignore keep-alive comments / partial fragments.
301:           }
302:         }
303:       };
304:       xhr.onprogress = drain;
305:       xhr.onload = () => {
306:         drain();
307:         if (xhr.status >= 200 && xhr.status < 300) {
308:           resolve(full);
309:         } else {
310:           reject(new Error(`HTTP ${xhr.status}: ${xhr.responseText?.substring(0, 200) || xhr.statusText}`));
311:         }
312:       };
313:       xhr.onerror = () => reject(new Error("Network error while streaming"));
314:       xhr.send(JSON.stringify({ model, stream: true, messages }));
315:     });
316:   }
317:   async fetchModels(): Promise<AgentModel[]> {
318:     const logTimestamp = new Date().toISOString();
319:     console.log(`[${logTimestamp}] [OpenRouterAgentGateway.fetchModels] Fetching models from OpenRouter...`);
320:     try {
321:       const response = await fetch("https://openrouter.ai/api/v1/models");
322:       if (!response.ok) {
323:         let errMsg = `HTTP error: ${response.status} ${response.statusText}`;
324:         try {
325:           const errData = await response.json();
326:           if (errData && errData.error && errData.error.message) {
327:             errMsg += ` - ${errData.error.message}`;
328:           }
329:         } catch (e) {
330:           try {
331:             const text = await response.text();
332:             if (text) errMsg += ` - ${text.substring(0, 150)}`;
333:           } catch (_) {}
334:         }
335:         throw new Error(errMsg);
336:       }
337:       const json = await response.json();
338:       if (!json || !Array.isArray(json.data)) {
339:         throw new Error("Invalid response format");
340:       }
341:       const models: AgentModel[] = json.data.map((m: any) => {
342:         const isFree = Boolean(
343:           m.id.endsWith(":free") ||
344:           (m.pricing && parseFloat(m.pricing.prompt) === 0 && parseFloat(m.pricing.completion) === 0)
345:         );
346:         return {
347:           id: m.id,
348:           name: m.name || m.id,
349:           free: isFree,
350:         };
351:       });
352:       console.log(`[${logTimestamp}] [OpenRouterAgentGateway.fetchModels] Retrieved ${models.length} models dynamically`);
353:       return models;
354:     } catch (err: any) {
355:       console.warn(`[${logTimestamp}] [OpenRouterAgentGateway.fetchModels] Warning: ${err.message}. Returning empty model list.`);
356:       return [];
357:     }
358:   }
359:   private localFallback(query: string, reason: string): AgentAskResult {
360:     return {
361:       cards: this.generateLocalFallback(query),
362:       isLocalFallback: true,
363:       fallbackReason: reason,
364:     };
365:   }
366:   private generateLocalFallback(query: string): AgentCardResponse[] {
367:     const topic = query
368:       .replace(/^(how|what|why|explain|tell me about|the)\s+/i, "")
369:       .replace(/\?$/, "")
370:       .trim();
371:     const capitalizedTopic = topic.charAt(0).toUpperCase() + topic.slice(1);
372:     return [
373:       {
374:         title: "Core idea",
375:         body: `At its heart, ${topic} is best understood as one central principle — name it in a single sentence before adding any detail.`,
376:       },
377:       {
378:         title: "Why it matters",
379:         body: `${capitalizedTopic} matters because it changes what you can predict or do; tie it to a concrete outcome you care about.`,
380:       },
381:       {
382:         title: "How it works",
383:         body: `Break ${topic} into the two or three moving parts that interact, and describe what each one does on its own.`,
384:       },
385:       {
386:         title: "Common mistake",
387:         body: `The usual error with ${topic} is to confuse it with a surface-similar idea — note the one distinction that keeps them apart.`,
388:       },
389:     ];
390:   }
