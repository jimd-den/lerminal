 495:   /**
 496:    * Accepts the draft: creates the mission cards, sets the workspace mission, and leaves
 497:    * the user on the canvas with a receipt they can undo.
 498:    *
 499:    * The receipt is built from what the session actually recorded — whether a model
 500:    * contributed, whether a search really ran — so it can never credit work that did not
 501:    * happen.
 502:    */
 503:   async acceptMission(): Promise<boolean> {
 504:     const session = this.goalArchitect.state;
 505:     const proposal = session.proposal;
 506:     const workspaceId = this.domain.activeWorkspaceId;
 507:     if (!proposal || !workspaceId) return false;
 508:     const operationId = this.addPendingOperation("Creating mission");
 509:     try {
 510:       const outcome = await this.createMissionPlanInteractor.execute({
 511:         workspaceId,
 512:         proposal,
 513:         map: session.map,
 514:         answerIds: session.answers.map((answer) => answer.questionId),
 515:         modelUsed: session.modelUsed,
 516:         webUsed: session.webUsed,
 517:         model: session.modelUsed ? this.domain.selectedModel : undefined,
 518:         startedAt: this.goalSessionStartedAt || Date.now(),
 519:       });
 520:       this.removePendingOperation(operationId);
 521:       this.goalArchitect.close();
 522:       await this.loadCardsForActiveWorkspace();
 523:       this.domain.selection = new Set(
 524:         outcome.cards.filter((card) => card.id !== outcome.group.id).map((card) => card.id),
 525:       );
 526:       this.domain.workspaces = this.domain.workspaces.map((workspace) =>
 527:         workspace.id === outcome.workspace.id ? outcome.workspace : workspace,
 528:       );
 529:       this.operations.present({
 530:         summary: outcome.operation.summary,
 531:         createdCardIds: outcome.operation.createdCardIds,
 532:         destination: { spaceId: workspaceId, groupId: outcome.group.id },
 533:         primaryActionLabel: "Open mission",
 534:       });
 535:       this.operations.markUndoable(outcome.operation.id);
 536:       this.emit();
 537:       return true;
 538:     } catch (error: any) {
 539:       this.setPendingOperationError(
 540:         operationId,
 541:         error instanceof UseCaseError ? error.userMessage : "Couldn't create the mission",
 542:       );
 543:       return false;
 544:     }
 545:   }
 546:   private buildMissionWorkflow(deps: GriotControllerDeps): MissionWorkflow {
