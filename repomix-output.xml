  4: import {
  5:   AppearanceSettings,
  6:   FontChoice,
  7:   resolveAppearance,
  8: } from "../../../entities/appearance";
  9: export type AccentName = AppState["accent"];
 10: export const TypeScale = {
 11:   label: 12,
 12:   meta: 13,
 13:   body: 16,
 14:   bodyStrong: 18,
 15:   title: 22,
 16:   display: 28,
 17: } as const;
 18: export const Structure = {
 19:   rail: 6,
 20:   railBold: 10,
 21:   radius: 16,
 22:   radiusElbow: 5,
 23:   radiusControl: 10,
 24:   tap: 44,
 25:   tapLarge: 56,
 26:   gutter: 16,
 27: } as const;
 28: const ROLE_COLORS: Record<SemanticRole, string> = {
 29:   goal: "#C5A8FF",
 30:   question: "#FFB45B",
 31:   concept: "#75C8FF",
 32:   source: "#63E6D5",
 33:   experiment: "#8FD16A",
 34:   claim: "#E8829B",
 35:   task: "#FFD466",
 36:   deliverable: "#FF7895",
 37: };
 38: export function roleColor(role: SemanticRole | undefined): string | null {
 39:   return role ? ROLE_COLORS[role] : null;
 40: }
 41: export interface GriotTheme {
 42:   mode: AppState["theme"];
 43:   background: string;
 44:   panel: string;
 45:   panelStrong: string;
 46:   panelMuted: string;
 47:   text: string;
 48:   textMuted: string;
 49:   textFaint: string;
 50:   line: string;
 51:   accent: string;
 52:   accentSoft: string;
 53:   accentInk: string;
 54:   danger: string;
 55:   warning: string;
 56:   evidence: string;
 57:   fontMono: string;
 58:   fontSans: string | undefined;
 59: }
 60: export const ACCENT_OPTIONS: { name: AccentName; color: string; label: string }[] = [
 61:   { name: "teal", color: "#63E6D5", label: "Ion" },
 62:   { name: "lilac", color: "#C5A8FF", label: "Violet" },
 63:   { name: "amber", color: "#FFB45B", label: "Solar" },
 64:   { name: "rose", color: "#FF7895", label: "Coral" },
 65:   { name: "arctic", color: "#75C8FF", label: "Arctic" },
 66: ];
 67: const SYSTEM_MONO_FAMILY = Platform.select({
 68:   ios: "Menlo",
 69:   android: "monospace",
 70:   default: "monospace",
 71: }) as string;
 72: function resolveFontFamily(choice: FontChoice, role: "mono" | "sans"): string | undefined {
 73:   if (choice.source === "system") {
 74:     return role === "mono" ? SYSTEM_MONO_FAMILY : undefined;
 75:   }
 76:   return choice.family;
 77: }
 78: export function resolveGriotTheme(
 79:   mode: AppState["theme"],
 80:   accentName: AccentName,
 81:   appearance?: AppearanceSettings
 82: ): GriotTheme {
 83:   const legacyAccent =
 84:     ACCENT_OPTIONS.find(option => option.name === accentName)?.color ?? ACCENT_OPTIONS[0].color;
 85:   const resolved = resolveAppearance(appearance);
 86:   const usingCustomPalette = Boolean(appearance?.paletteId);
 87:   const palette = resolved.palette;
 88:   const dark = usingCustomPalette ? palette.mode === "dark" : mode === "dark";
 89:   const accent = appearance?.accentOverride
 90:     ? resolved.accent
 91:     : usingCustomPalette
 92:       ? palette.accent
 93:       : legacyAccent;
 94:   const base = usingCustomPalette
 95:     ? palette
 96:     : {
 97:         background: dark ? "#090E13" : "#EEF1EC",
 98:         panel: dark ? "#101820" : "#FBFCF7",
 99:         panelStrong: dark ? "#17232C" : "#FFFFFF",
100:         panelMuted: dark ? "#0D141A" : "#E4E9E2",
101:         text: dark ? "#F2F6F1" : "#131A1A",
102:         textMuted: dark ? "#A7B6B5" : "#536260",
103:         textFaint: dark ? "#637574" : "#7B8884",
104:         line: dark ? "#26363D" : "#CBD4CE",
105:         accentInk: dark ? "#06110F" : "#07110F",
106:         danger: "#FF5F69",
107:         warning: "#FFB45B",
108:         evidence: dark ? "#8AB4FF" : "#1F5FBF",
109:       };
110:   const text = resolved.highContrast ? (dark ? "#FFFFFF" : "#000000") : base.text;
111:   const line = resolved.highContrast ? (dark ? "#5A6B72" : "#8A9490") : base.line;
112:   const accentSoftAlpha = resolved.highContrast ? "3A" : "22";
113:   return {
114:     mode: dark ? "dark" : "light",
115:     background: base.background,
116:     panel: base.panel,
117:     panelStrong: base.panelStrong,
118:     panelMuted: base.panelMuted,
119:     text,
120:     textMuted: base.textMuted,
121:     textFaint: base.textFaint,
122:     line,
123:     accent,
124:     accentSoft: `${accent}${accentSoftAlpha}`,
125:     accentInk: base.accentInk,
126:     danger: base.danger,
127:     warning: base.warning,
128:     evidence: base.evidence,
129:     fontMono: resolveFontFamily(resolved.monoFont, "mono") ?? SYSTEM_MONO_FAMILY,
130:     fontSans: resolveFontFamily(resolved.sansFont, "sans"),
131:   };
132: }
