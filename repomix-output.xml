101: export interface AgentRunRequest {
102:   presetId: string;
103:   actionLabel: string;
104:   scope: AgentScopeKind;
105:   webUsed: boolean;
106:   workspaceId: string;
107:   parentId: string | null;
108:   destinationLabel: string;
109:   selectedCardIds: string[];
110:   contextCardIds: string[];
111:   contextTruncated: boolean;
112:   contextConsideredCount: number;
113:   query?: string;
114:   outputDescription: string;
115: }
116: export interface BuildAgentRunRequestParams {
117:   preset: OperationPreset;
118:   workspaceId: string;
119:   parentId: string | null;
120:   allCards: Card[];
121:   selectedCards: Card[];
122:   query?: string;
123:   budget?: ScopeBudget;
124: }
125: export function buildAgentRunRequest(params: BuildAgentRunRequestParams): AgentRunRequest {
126:   const { preset } = params;
127:   const context = resolveScopedContext({
128:     scope: preset.defaultScope,
129:     allCards: params.allCards,
130:     selectedCards: params.selectedCards,
131:     parentId: params.parentId,
132:     budget: params.budget,
133:   });
134:   const destinationCard = params.parentId
135:     ? params.allCards.find(c => c.id === params.parentId)
136:     : undefined;
137:   return {
138:     presetId: preset.id,
139:     actionLabel: preset.label,
140:     scope: preset.defaultScope,
141:     webUsed: preset.defaultScope === "web" || preset.defaultScope === "selected-plus-web",
142:     workspaceId: params.workspaceId,
143:     parentId: params.parentId,
144:     destinationLabel: destinationCard ? destinationCard.title : "Workspace root",
145:     selectedCardIds: params.selectedCards.map(c => c.id),
146:     contextCardIds: context.cards.map(c => c.id),
147:     contextTruncated: context.truncated,
148:     contextConsideredCount: context.totalConsideredCount,
149:     query: params.query?.trim() || undefined,
150:     outputDescription: preset.outputDescription,
151:   };
152: }
153: function escapePipelineArg(value: string): string {
154:   return value.replace(/\\/g, "\\\\").replace(/"/g, '\\"');
155: }
156: export function buildPipelineText(preset: OperationPreset, query?: string): string {
157:   const resolvedQuery = (query?.trim() || preset.defaultQuery || "").trim();
158:   switch (preset.command) {
159:     case "ask": {
160:       const profile = preset.profileId ? `--profile ${preset.profileId} ` : "";
161:       return `ask ${profile}"${escapePipelineArg(resolvedQuery)}"`;
162:     }
163:     case "search":
164:       return `search "${escapePipelineArg(resolvedQuery)}"`;
165:     case "recall":
166:       return "recall";
167:     case "research":
168:       throw new Error("research-flow presets dispatch via GriotController.startResearch, not a pipeline string");
169:   }
170: }
