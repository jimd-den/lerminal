<file path="src/usecases/agent/SuggestSearchQueriesInteractor.ts">
 1: import { AgentGateway } from "../ports/gateways/AgentGateway";
 2: import { BUILTIN_ASSISTANT_PROFILES } from "../../entities/assistantProfile";
 3: import { WorkspaceMission } from "../../entities/workspace";
 4: import { AgentRequestError, MissingApiKeyError } from "../errors";
 5: const QUERY_STRATEGIST_PROFILE = BUILTIN_ASSISTANT_PROFILES.find(p => p.id === "builtin-query-strategist")!;
 6: const MAX_QUERIES = 6;
 7: export interface SuggestSearchQueriesRequest {
 8:   topic: string;
 9:   mission?: WorkspaceMission;
10:   apiKey: string;
11:   model: string;
12: }
13: export function buildQueryStrategistPrompt(topic: string, mission?: WorkspaceMission): string {
14:   const lines: string[] = [`Topic: ${topic}`];
15:   if (mission) {
16:     lines.push(`Learner's goal: ${mission.goalTitle}`);
17:     if (mission.goalDescription) lines.push(`Why: ${mission.goalDescription}`);
18:     if (mission.targetDeliverable) lines.push(`Target deliverable: ${mission.targetDeliverable}`);
19:     if (mission.successCriteria.length > 0) {
20:       lines.push(`Success criteria: ${mission.successCriteria.join("; ")}`);
21:     }
22:     lines.push(`Current phase: ${mission.currentPhase}`);
23:   }
24:   return lines.join("\n");
25: }
26: export class SuggestSearchQueriesInteractor {
27:   constructor(private readonly agentGateway: AgentGateway) {}
28:   async execute(request: SuggestSearchQueriesRequest): Promise<string[]> {
29:     if (!request.apiKey?.trim()) {
30:       throw new MissingApiKeyError("Suggesting search queries");
31:     }
32:     const result = await this.agentGateway.ask(
33:       buildQueryStrategistPrompt(request.topic, request.mission),
34:       [],
35:       request.apiKey,
36:       request.model,
37:       QUERY_STRATEGIST_PROFILE.systemPrompt,
38:       "cards-v1"
39:     );
40:     if (result.isLocalFallback) {
41:       throw new AgentRequestError(
42:         result.fallbackReason ?? "No model answered, so no queries were suggested"
43:       );
44:     }
45:     const cards = result.cards;
46:     const seen = new Set<string>();
47:     const queries: string[] = [];
48:     for (const card of cards) {
49:       const title = typeof card?.title === "string" ? card.title.trim() : "";
50:       if (!title) continue;
51:       const key = title.toLowerCase();
52:       if (seen.has(key)) continue;
53:       seen.add(key);
54:       queries.push(title);
55:       if (queries.length >= MAX_QUERIES) break;
56:     }
57:     if (queries.length === 0) {
58:       throw new AgentRequestError("The model didn't return any usable query suggestions.");
59:     }
60:     return queries;
61:   }
62: }
</file>

