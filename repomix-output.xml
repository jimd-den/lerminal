479:     const citation = item?.url_citation;
480:     const url = citation?.url;
481:     if (typeof url !== "string" || !url) continue;
482:     citations.push({
483:       url,
484:       title: typeof citation?.title === "string" && citation.title ? citation.title : url,
485:     });
486:   }
487:   return citations;
488: }
