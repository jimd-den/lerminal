<file path="src/usecases/card/MarkdownChunkerService.ts">
 1: import { marked } from "marked";
 2: export interface MarkdownSection {
 3:   title: string;
 4:   body: string;
 5:   depth: number;
 6: }
 7: export interface MarkdownNode {
 8:   title: string;
 9:   body: string;
10:   depth: number;
11:   children: MarkdownNode[];
12: }
13: const STRUCTURAL_DEPTHS = new Set([1, 2, 3]);
14: export class MarkdownChunkerService {
15:   static chunk(markdown: string, fallbackTitle: string): MarkdownSection[] {
16:     const tokens = marked.lexer(markdown);
17:     const sections: MarkdownSection[] = [];
18:     let currentTitle = fallbackTitle;
19:     let currentBody = "";
20:     let currentDepth = 0;
21:     const flushSection = () => {
22:       const trimmedBody = currentBody.trim();
23:       if (trimmedBody.length > 0) {
24:         sections.push({ title: currentTitle, body: trimmedBody, depth: currentDepth });
25:       }
26:     };
27:     for (const token of tokens) {
28:       if (token.type === "heading" && STRUCTURAL_DEPTHS.has(token.depth)) {
29:         flushSection();
30:         currentTitle = token.text;
31:         currentBody = token.raw;
32:         currentDepth = token.depth;
33:       } else {
34:         currentBody += token.raw;
35:       }
36:     }
37:     flushSection();
38:     return sections;
39:   }
40:   static chunkTree(markdown: string, fallbackTitle: string): MarkdownNode[] {
41:     const sections = this.chunk(markdown, fallbackTitle);
42:     const roots: MarkdownNode[] = [];
43:     const stack: MarkdownNode[] = [];
44:     for (const section of sections) {
45:       const node: MarkdownNode = { title: section.title, body: section.body, depth: section.depth, children: [] };
46:       if (node.depth === 0) {
47:         roots.push(node);
48:         continue;
49:       }
50:       while (stack.length > 0 && stack[stack.length - 1].depth >= node.depth) {
51:         stack.pop();
52:       }
53:       if (stack.length === 0) {
54:         roots.push(node);
55:       } else {
56:         stack[stack.length - 1].children.push(node);
57:       }
58:       stack.push(node);
59:     }
60:     return roots;
61:   }
62: }
</file>

