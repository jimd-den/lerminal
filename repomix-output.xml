 37:   new JsonCollectionStore<Item>("k", store, "items");
 38: const identify = (item: Item) => item.id;
 39: describe("JsonCollectionStore", () => {
 40:   it("reads an empty collection only when nothing was ever stored", async () => {
 41:     const store = new FakeStore();
 42:     expect(await collection(store).readAll()).toEqual([]);
 43:   });
 44:   it("throws instead of reporting empty when the read fails", async () => {
 45:     const store = new FakeStore();
 46:     store.failRead = true;
 47:     expect(collection(store).readAll()).rejects.toBeInstanceOf(PersistenceError);
 48:   });
 49:   it("throws instead of reporting empty when the stored data is damaged", async () => {
 50:     const store = new FakeStore();
 51:     store.data.set("k", "{not json");
 52:     expect(collection(store).readAll()).rejects.toBeInstanceOf(CorruptedDataError);
 53:   });
 54:   it("treats a non-array payload as damage rather than coercing it", async () => {
 55:     const store = new FakeStore();
 56:     store.data.set("k", JSON.stringify({ id: "a" }));
 57:     expect(collection(store).readAll()).rejects.toBeInstanceOf(CorruptedDataError);
 58:   });
 59:   it("never overwrites stored data when the read half of a mutation fails", async () => {
 60:     const store = new FakeStore();
 61:     await collection(store).writeAll([{ id: "a", value: 1 }]);
 62:     const before = store.data.get("k");
 63:     store.failRead = true;
 64:     expect(
 65:       collection(store).mutate((items) => [...items, { id: "b", value: 2 }]),
 66:     ).rejects.toBeInstanceOf(PersistenceError);
 67:     store.failRead = false;
 68:     expect(store.data.get("k")).toBe(before!);
 69:   });
 70:   it("surfaces write failures to the caller", async () => {
 71:     const store = new FakeStore();
 72:     store.failWrite = true;
 73:     expect(collection(store).writeAll([{ id: "a", value: 1 }])).rejects.toBeInstanceOf(
 74:       PersistenceError,
 75:     );
 76:   });
