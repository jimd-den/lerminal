171: function generateId(): string {
172:   return Math.random().toString(36).substring(2, 10);
173: }
174: export function createAssistantProfile(params: CreateAssistantProfileParams): AssistantProfile {
175:   const now = Date.now();
176:   return {
177:     id: params.id || `prof-${generateId()}`,
178:     name: params.name.trim(),
179:     description: (params.description || "").trim(),
180:     goal: (params.goal || "").trim(),
181:     capability: params.capability,
182:     systemPrompt: params.systemPrompt.trim(),
183:     outputContract: params.outputContract,
184:     createdAt: now,
185:     updatedAt: now,
186:     builtin: params.builtin ?? false,
187:   };
188: }
189: export function resolveAssistantProfile(
190:   capability: AssistantCapability,
191:   activeProfileIds: Partial<Record<AssistantCapability, string>> = {},
192:   customProfiles: AssistantProfile[] = [],
193:   builtinProfiles: AssistantProfile[] = BUILTIN_ASSISTANT_PROFILES,
194:   targetProfileIdOrName?: string
195: ): AssistantProfile {
196:   const allProfiles = [...customProfiles, ...builtinProfiles];
197:   if (targetProfileIdOrName) {
198:     const targetKey = targetProfileIdOrName.trim().toLowerCase();
199:     const found = allProfiles.find(
200:       (p) => p.id.toLowerCase() === targetKey || p.name.toLowerCase() === targetKey
201:     );
202:     if (found) return found;
203:   }
204:   const activeId = activeProfileIds[capability];
205:   if (activeId) {
206:     const found = allProfiles.find((p) => p.id === activeId);
207:     if (found) return found;
208:   }
209:   const matchingCustom = customProfiles.find((p) => p.capability === capability);
210:   if (matchingCustom) return matchingCustom;
211:   const matchingBuiltin = builtinProfiles.find((p) => p.capability === capability);
212:   if (matchingBuiltin) return matchingBuiltin;
213:   return BUILTIN_ASSISTANT_PROFILES[0];
214: }
