127:       }
128:       const cards: AgentCardResponse[] = parsed.map((item: any) => ({
129:         title: String(item.title || "Concept").substring(0, 100),
130:         body: String(item.body || "").substring(0, 1000),
131:         ...(item.sourceCardId ? { sourceCardId: String(item.sourceCardId) } : {}),
132:         ...(item.sourceExcerpt ? { sourceExcerpt: String(item.sourceExcerpt).substring(0, 300) } : {}),
