 2: import { BUILTIN_ASSISTANT_PROFILES } from "../../entities/assistantProfile";
 3: import { WorkspaceMission } from "../../entities/workspace";
 4: import { AgentRequestError, MissingApiKeyError } from "../errors";
 5: const QUERY_STRATEGIST_PROFILE = BUILTIN_ASSISTANT_PROFILES.find(p => p.id === "builtin-query-strategist")!;
 6: const MAX_QUERIES = 6;
 7: export interface SuggestSearchQueriesRequest {
 8:   topic: string;
 9:   mission?: WorkspaceMission;
10:   apiKey: string;
11:   model: string;
12:   systemPrompt?: string;
13: }
14: export function buildQueryStrategistPrompt(topic: string, mission?: WorkspaceMission): string {
15:   const lines: string[] = [`Topic: ${topic}`];
16:   if (mission) {
17:     lines.push(`Learner's goal: ${mission.goalTitle}`);
18:     if (mission.goalDescription) lines.push(`Why: ${mission.goalDescription}`);
19:     if (mission.targetDeliverable) lines.push(`Target deliverable: ${mission.targetDeliverable}`);
20:     if (mission.successCriteria.length > 0) {
21:       lines.push(`Success criteria: ${mission.successCriteria.join("; ")}`);
22:     }
23:     lines.push(`Current phase: ${mission.currentPhase}`);
24:   }
25:   return lines.join("\n");
26: }
27: export class SuggestSearchQueriesInteractor {
28:   constructor(private readonly agentGateway: AgentGateway) {}
29:   async execute(request: SuggestSearchQueriesRequest): Promise<string[]> {
30:     if (!request.apiKey?.trim()) {
31:       throw new MissingApiKeyError("Suggesting search queries");
32:     }
33:     const result = await this.agentGateway.ask(
34:       buildQueryStrategistPrompt(request.topic, request.mission),
35:       [],
36:       request.apiKey,
37:       request.model,
38:       request.systemPrompt?.trim() || QUERY_STRATEGIST_PROFILE.systemPrompt,
39:       "cards-v1"
40:     );
41:     if (result.isLocalFallback) {
42:       throw new AgentRequestError(
43:         result.fallbackReason ?? "No model answered, so no queries were suggested"
44:       );
45:     }
46:     const cards = result.cards;
47:     const seen = new Set<string>();
48:     const queries: string[] = [];
49:     for (const card of cards) {
50:       const title = typeof card?.title === "string" ? card.title.trim() : "";
51:       if (!title) continue;
52:       const key = title.toLowerCase();
53:       if (seen.has(key)) continue;
54:       seen.add(key);
55:       queries.push(title);
56:       if (queries.length >= MAX_QUERIES) break;
57:     }
58:     if (queries.length === 0) {
59:       throw new AgentRequestError("The model didn't return any usable query suggestions.");
60:     }
61:     return queries;
62:   }
63: }
</file>

<file path="src/usecases/card/ExtractUrlInteractor.ts">
 1: import { Card, createCard } from "../../entities/card";
 2: import { ExtractionGateway } from "../ports/gateways/ExtractionGateway";
 3: import { CardRepository } from "../ports/repositories/CardRepository";
 4: export interface ExtractUrlRequest {
 5:   url: string;
 6:   title: string;
 7:   workspaceId: string;
 8:   parentId?: string;
 9: }
10: export class ExtractUrlInteractor {
11:   constructor(
12:     private readonly extractionGateway: ExtractionGateway,
13:     private readonly cardRepo: CardRepository
14:   ) {}
15:   async execute(request: ExtractUrlRequest): Promise<Card> {
16:     const text = await this.extractionGateway.extractText(request.url);
17:     const mainTitle = request.title || request.url;
18:     const sourceCard = createCard({
19:       workspaceId: request.workspaceId,
20:       type: "source",
21:       title: mainTitle,
22:       body: text,
23:       cite: request.url,
24:       parentId: request.parentId,
25:     });
26:     await this.cardRepo.saveCard(sourceCard);
27:     return sourceCard;
28:   }
29: }
