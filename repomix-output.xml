<file path="src/usecases/goal/CreateMissionPlanInteractor.ts">
  1: import { Card, createCard } from "../../entities/card";
  2: import {
  3:   describeAssumptions,
  4:   describeKnownGaps,
  5:   InsightOrigin,
  6:   MissionProposal,
  7:   WorkingMap,
  8: } from "../../entities/goalArchitect";
  9: import {
 10:   createOperationRecord,
 11:   OperationRecord,
 12: } from "../../entities/operationLog";
 13: import { createProvenance, CreationMode } from "../../entities/provenance";
 14: import {
 15:   createWorkspaceMission,
 16:   updateWorkspaceMission,
 17:   Workspace,
 18: } from "../../entities/workspace";
 19: import { CardRepository } from "../ports/repositories/CardRepository";
 20: import { OperationLogRepository } from "../ports/repositories/OperationLogRepository";
 21: import { WorkspaceRepository } from "../ports/repositories/WorkspaceRepository";
 22: import { UseCaseError } from "../errors";
 23: export class MissionPlanError extends UseCaseError {
 24:   constructor(userMessage: string) {
 25:     super(userMessage);
 26:   }
 27: }
 28: export interface CreateMissionPlanInput {
 29:   workspaceId: string;
 30:   proposal: MissionProposal;
 31:   map: WorkingMap;
 32:   answerIds: string[];
 33:   modelUsed: boolean;
 34:   webUsed: boolean;
 35:   model?: string;
 36:   searchQueries?: string[];
 37:   startedAt: number;
 38: }
 39: export interface MissionPlanOutcome {
 40:   group: Card;
 41:   cards: Card[];
 42:   workspace: Workspace;
 43:   operation: OperationRecord;
 44: }
 45: function modeForOrigin(origin: InsightOrigin): CreationMode {
 46:   switch (origin) {
 47:     case "agent":
 48:       return "agent";
 49:     case "web":
 50:       return "search";
 51:     case "app":
 52:       return "command";
 53:     case "user":
 54:     default:
 55:       return "manual";
 56:   }
 57: }
 58: export class CreateMissionPlanInteractor {
 59:   constructor(
 60:     private readonly cardRepo: CardRepository,
 61:     private readonly workspaceRepo: WorkspaceRepository,
 62:     private readonly operationLogRepo?: OperationLogRepository
 63:   ) {}
 64:   async execute(input: CreateMissionPlanInput): Promise<MissionPlanOutcome> {
 65:     const { proposal, map, workspaceId } = input;
 66:     if (!proposal.goalStatement.trim()) {
 67:       throw new MissionPlanError("This mission has no goal statement yet.");
 68:     }
 69:     const workspaces = await this.workspaceRepo.getWorkspaces();
 70:     const workspace = workspaces.find(item => item.id === workspaceId);
 71:     if (!workspace) {
 72:       throw new MissionPlanError("That workspace no longer exists.");
 73:     }
 74:     const operationId = Math.random().toString(36).substring(2, 10);
 75:     const createdAt = Date.now();
 76:     const provenanceFor = (origin: InsightOrigin) =>
 77:       createProvenance({
 78:         mode: modeForOrigin(origin),
 79:         operationId,
 80:         model: input.modelUsed ? input.model : undefined,
 81:         searchQuery: input.searchQueries?.[0],
 82:         createdAt,
 83:       });
 84:     const group = createCard({
 85:       workspaceId,
 86:       type: "group",
 87:       role: "goal",
 88:       title: proposal.title,
 89:       body: proposal.goalStatement,
 90:       createdAt,
 91:       provenance: provenanceFor(map.goal?.origin ?? "user"),
 92:     });
 93:     const children: Card[] = proposal.suggestedCards.map(proposed =>
 94:       createCard({
 95:         workspaceId,
 96:         type: proposed.type,
 97:         role: proposed.role,
 98:         title: proposed.title,
 99:         body: proposed.body,
100:         parentId: group.id,
101:         createdAt,
102:         provenance: provenanceFor(proposed.origin),
103:       })
104:     );
105:     const assumptionsNote = createCard({
106:       workspaceId,
107:       type: "note",
108:       role: "claim",
109:       title: "Mission assumptions",
110:       body: describeAssumptions(map),
111:       parentId: group.id,
112:       createdAt,
113:       provenance: provenanceFor("app"),
114:     });
115:     const gapsNote = createCard({
116:       workspaceId,
117:       type: "note",
118:       role: "question",
119:       title: "Known gaps",
120:       body: describeKnownGaps(map),
121:       parentId: group.id,
122:       createdAt,
123:       provenance: provenanceFor("app"),
124:     });
125:     const created = [group, ...children, assumptionsNote, gapsNote];
126:     await this.cardRepo.saveCards(created);
127:     const mission = workspace.mission
128:       ? updateWorkspaceMission(workspace.mission, {
129:           goalTitle: proposal.title,
130:           goalDescription: proposal.goalStatement,
131:           successCriteria: proposal.successCriteria,
132:           targetDeliverable: proposal.targetDeliverable,
133:         })
134:       : createWorkspaceMission({
135:           goalTitle: proposal.title,
136:           goalDescription: proposal.goalStatement,
137:           successCriteria: proposal.successCriteria,
138:           targetDeliverable: proposal.targetDeliverable,
139:         });
140:     const updatedWorkspace: Workspace = { ...workspace, mission };
141:     await this.workspaceRepo.saveWorkspace(updatedWorkspace);
142:     const operation = createOperationRecord({
143:       id: operationId,
144:       commandName: "goal",
145:       workspaceId,
146:       inputCardIds: input.answerIds,
147:       createdCardIds: created.map(card => card.id),
148:       createdCardSnapshots: created.map(card => ({ ...card })),
149:       webUsed: input.webUsed,
150:       searchQuery: input.searchQueries?.[0],
151:       model: input.modelUsed ? input.model : undefined,
152:       startedAt: input.startedAt,
153:       completedAt: createdAt,
154:       summary: this.summarize(created.length, input),
155:     });
156:     await this.operationLogRepo?.saveRecord(operation);
157:     return { group, cards: created, workspace: updatedWorkspace, operation };
158:   }
159:   private summarize(cardCount: number, input: CreateMissionPlanInput): string {
160:     const parts = [`Created ${cardCount} mission cards`];
161:     parts.push(input.modelUsed ? `with model ${input.model ?? "unknown"}` : "without a model");
162:     if (input.webUsed) {
163:       parts.push(`using ${input.searchQueries?.length ?? 0} web search(es)`);
164:     } else {
165:       parts.push("without web access");
166:     }
167:     return parts.join(", ");
168:   }
169: }
</file>

