<file path="src/entities/cloze.ts">
  1: import { Card } from "./card";
  2: export interface ClozeBlank {
  3:   id: string;
  4:   answer: string;
  5:   acceptedAnswers?: string[];
  6: }
  7: export interface ClozeCardFields {
  8:   template: string;
  9:   blanks: ClozeBlank[];
 10: }
 11: export interface ClozeResult {
 12:   template: string;
 13:   blanks: ClozeBlank[];
 14:   fullAnswer: string;
 15: }
 16: export interface ClozeCardData {
 17:   template: string;
 18:   blanks: ClozeBlank[];
 19:   fullAnswer: string;
 20:   isLegacy?: boolean;
 21: }
 22: export type ClozePart =
 23:   | { kind: "text"; value: string }
 24:   | { kind: "blank"; id: string };
 25: export function parseClozeTemplate(template: string): ClozePart[] {
 26:   return template
 27:     .split(/(\{\{c\d+\}\})/)
 28:     .filter(Boolean)
 29:     .map((part) => {
 30:       const match = part.match(/^\{\{(c\d+)\}\}$/);
 31:       return match
 32:         ? { kind: "blank", id: match[1] }
 33:         : { kind: "text", value: part };
 34:     });
 35: }
 36: export function normalizeAnswer(text: string): string {
 37:   return text
 38:     .trim()
 39:     .toLocaleLowerCase()
 40:     .replace(/[^\p{L}\p{N}\s-]/gu, "")
 41:     .replace(/\s+/g, " ")
 42:     .replace(/-+/g, "-");
 43: }
 44: /**
 45:  * # Answer Matcher
 46:  *
 47:  * ## Business Value & Purpose
 48:  * Evaluates whether a user's typed string matches a specific blank's primary or accepted answers.
 49:  */
 50: export function answerMatches(typed: string, blank: ClozeBlank): boolean {
 51:   if (!typed || !typed.trim()) return false;
 52:   const candidates = [blank.answer, ...(blank.acceptedAnswers ?? [])];
 53:   const normalizedTyped = normalizeAnswer(typed);
 54:   return candidates.some(candidate => normalizeAnswer(candidate) === normalizedTyped);
 55: }
 56: /**
 57:  * # Cloze Card Detector
 58:  *
 59:  * ## Business Value & Purpose
 60:  * Determines whether a given card is a fill-in-the-blank cloze card regardless of whether
 61:  * its base `type` string is "question" or "cloze".
 62:  */
 63: export function isClozeCard(card: Card): boolean {
 64:   if (!card) return false;
 65:   if (card.typeId) return card.typeId === "cloze";
 66:   return (
 67:     card.type === "cloze" ||
 68:     !!card.fields?.template ||
 69:     !!card.fields?.blanks ||
 70:     (card.type === "question" && typeof card.title === "string" && card.title.includes("_____"))
 71:   );
 72: }
 73: export function readClozeCard(card: Card): ClozeCardData {
 74:   const template = card.fields?.template;
 75:   const rawBlanks = card.fields?.blanks;
 76:   if (template && rawBlanks) {
 77:     try {
 78:       const blanks: ClozeBlank[] = JSON.parse(rawBlanks);
 79:       if (Array.isArray(blanks) && blanks.length > 0) {
 80:         return {
 81:           template,
 82:           blanks,
 83:           fullAnswer: card.answer ?? "",
 84:           isLegacy: false,
 85:         };
 86:       }
 87:     } catch {
 88:       // Fallback to legacy reader
 89:     }
 90:   }
 91:   // Legacy fallback: convert blanked title and comma-separated answer into structured template & blanks
 92:   const legacyAnswers = (card.answer || "").split(",").map(s => s.trim()).filter(Boolean);
 93:   const titleText = card.title || "";
 94:   let blankCount = 0;
 95:   const legacyTemplate = titleText.replace(/_____/g, () => {
 96:     blankCount++;
 97:     return `{{c${blankCount}}}`;
 98:   });
 99:   const legacyBlanks: ClozeBlank[] = legacyAnswers.map((ans, idx) => ({
100:     id: `c${idx + 1}`,
101:     answer: ans,
102:   }));
103:   return {
104:     template: legacyTemplate || titleText,
105:     blanks: legacyBlanks.length > 0 ? legacyBlanks : [{ id: "c1", answer: card.answer || "" }],
106:     fullAnswer: card.answer || "",
107:     isLegacy: true,
108:   };
109: }
110: /**
111:  * # Cloze Generation
112:  *
113:  * Blanks the most salient terms in a passage so the reader has to retrieve them. Salience
114:  * is deliberately conservative — proper nouns, numbers, and long content words — because
115:  * blanking a filler word produces a card that tests nothing.
116:  */
117: /** Common words never worth blanking. */
118: const CLOZE_STOPWORDS = new Set([
119:   "the", "and", "for", "that", "this", "with", "from", "their", "there", "which",
120:   "while", "where", "these", "those", "into", "about", "would", "could", "should",
121:   "because", "between", "through", "however", "therefore",
122: ]);
123: const MIN_SOURCE_LENGTH = 12;
124: const MAX_SNIPPET_LENGTH = 220;
125: const MAX_BLANKS = 3;
126: function escapeRegExp(value: string): string {
127:   return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
128: }
129: function toSnippet(source: string): string {
130:   const text = source.trim().replace(/\s+/g, " ");
131:   return text.length > MAX_SNIPPET_LENGTH
132:     ? text.slice(0, MAX_SNIPPET_LENGTH).trimEnd() + "…"
133:     : text;
134: }
135: function isSalient(word: string): boolean {
136:   return /^[A-Z]/.test(word) || /\d/.test(word) || word.length >= 7;
137: }
138: function salientTerms(words: string[]): string[] {
139:   const seen = new Set<string>();
140:   const terms: string[] = [];
141:   for (const word of words) {
142:     const key = word.toLowerCase();
143:     if (seen.has(key) || CLOZE_STOPWORDS.has(key)) continue;
144:     if (!isSalient(word)) continue;
145:     terms.push(word);
146:     seen.add(key);
147:   }
148:   return terms;
149: }
150: export function makeCloze(source: string): ClozeResult | null {
151:   const text = source.trim().replace(/\s+/g, " ");
152:   if (text.length < MIN_SOURCE_LENGTH) return null;
153:   const snippet = toSnippet(source);
154:   const words = snippet.match(/[A-Za-z0-9][A-Za-z0-9'’\-]*/g) || [];
155:   const candidates = salientTerms(words);
156:   const chosenTerms =
157:     candidates.length > 0
158:       ? candidates.slice(0, MAX_BLANKS)
159:       : [[...words].sort((a, b) => b.length - a.length)[0]].filter(Boolean);
160:   if (chosenTerms.length === 0) return null;
161:   const blanks: ClozeBlank[] = [];
162:   let template = snippet;
163:   chosenTerms.forEach((term, index) => {
164:     const id = `c${index + 1}`;
165:     blanks.push({ id, answer: term });
166:     template = template.replace(new RegExp(`\\b${escapeRegExp(term)}\\b`), `{{${id}}}`);
167:   });
168:   return { template, blanks, fullAnswer: snippet };
169: }
</file>

