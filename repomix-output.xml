50:   question: () => [researchAction(), prerequisitesAction(), explainAction()],
51:   concept: () => [explainAction(), studyCardsAction(), prerequisitesAction()],
52:   source: () => [extractKeyIdeasAction(), studyCardsAction(), researchAction()],
53:   experiment: () => [planExperimentAction(), prerequisitesAction(), createTaskAction()],
54:   claim: () => [researchAction(), explainAction(), studyCardsAction()],
55:   task: () => [createTaskAction(), prerequisitesAction(), attachToMissionAction()],
56:   deliverable: () => [createTaskAction(), attachToMissionAction(), explainAction()],
57:   goal: () => [prerequisitesAction(), researchAction(), attachToMissionAction()],
58: };
