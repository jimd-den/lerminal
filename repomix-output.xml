<file path="src/usecases/appearance/SearchFontsInteractor.ts">
 1: import {
 2:   FontCategory,
 3:   FontFamilySummary,
 4:   RankedFontFamily,
 5:   rankFontFamilies,
 6: } from "../../entities/fontCatalog";
 7: import { FontGateway } from "../ports/gateways/FontGateway";
 8: import { UseCaseError } from "../errors";
 9: export class FontCatalogError extends UseCaseError {
10:   constructor(userMessage: string) {
11:     super(userMessage);
12:   }
13: }
14: export interface FontSearchQuery {
15:   text: string;
16:   category?: FontCategory | null;
17:   limit?: number;
18: }
19: export class SearchFontsInteractor {
20:   private catalog: FontFamilySummary[] | null = null;
21:   constructor(private readonly fontGateway: FontGateway) {}
22:   async execute(query: FontSearchQuery): Promise<RankedFontFamily[]> {
23:     const catalog = await this.loadCatalog();
24:     return rankFontFamilies(query.text, catalog, {
25:       limit: query.limit,
26:       category: query.category ?? null,
27:     });
28:   }
29:   isReady(): boolean {
30:     return this.catalog !== null;
31:   }
32:   private async loadCatalog(): Promise<FontFamilySummary[]> {
33:     if (this.catalog) return this.catalog;
34:     try {
35:       this.catalog = await this.fontGateway.listFamilies();
36:     } catch (err: any) {
37:       throw new FontCatalogError(
38:         err?.message ?? "Couldn't load the font catalog"
39:       );
40:     }
41:     return this.catalog;
42:   }
43: }
</file>

