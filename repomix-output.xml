 8: export interface CommandFactoryDeps {
 9:   agentGateway: AgentGateway;
10:   cardRepo: CardRepository;
11:   getRunner: () => PipelineRunner;
12: }
13: export function createPipelineCommand(
14:   definition: CommandDefinition,
15:   deps: CommandFactoryDeps
16: ): PipelineCommand {
17:   switch (definition.kind) {
18:     case "agent":
19:       return new CustomAgentCommand(definition, deps.agentGateway, deps.cardRepo);
20:     case "pipeline":
21:       return new PipelineMacroCommand(definition, deps.getRunner);
22:     default: {
23:       const unhandled: never = definition;
24:       throw new Error(`Unsupported command kind: ${JSON.stringify(unhandled)}`);
25:     }
26:   }
27: }
