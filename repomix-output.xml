139: /**
140:  * Holds the session's state and broadcasts changes.
141:  *
142:  * @typeParam TSnapshot The render-ready view model listeners receive; the owner supplies
143:  * a projector so the store never has to know how the view model is composed.
144:  */
145: export class AppSessionStore<TSnapshot> {
146:   readonly domain: DomainState = createInitialDomainState();
147:   readonly ui: UiState = createInitialUiState();
148:   private readonly listeners = new Set<(snapshot: TSnapshot) => void>();
149:   constructor(private readonly project: () => TSnapshot) {}
150:   subscribe(listener: (snapshot: TSnapshot) => void): () => void {
151:     this.listeners.add(listener);
152:     listener(this.project());
153:     return () => {
154:       this.listeners.delete(listener);
155:     };
156:   }
157:   /** Projects once and hands the same snapshot to every listener. */
158:   emit(): void {
159:     const snapshot = this.project();
160:     for (const listener of this.listeners) {
161:       listener(snapshot);
162:     }
163:   }
164:   /** Shows a transient message, which clears itself unless something newer replaced it. */
165:   showToast(message: string): void {
166:     this.ui.toastMessage = message;
167:     this.emit();
168:     setTimeout(() => {
169:       if (this.ui.toastMessage === message) {
170:         this.ui.toastMessage = "";
171:         this.emit();
172:       }
173:     }, TOAST_DURATION_MS);
174:   }
175:   select(cardIds: Iterable<string>): void {
176:     this.domain.selection = new Set(cardIds);
177:   }
178:   forgetCards(removedCardIds: Iterable<string>): void {
179:     const removed = new Set(removedCardIds);
180:     if (removed.size === 0) return;
181:     this.domain.selection = new Set(
182:       [...this.domain.selection].filter((id) => !removed.has(id)),
183:     );
184:     if (this.ui.openCardId && removed.has(this.ui.openCardId)) {
185:       this.ui.openCardId = null;
186:     }
187:     if (this.domain.currentGroupId && removed.has(this.domain.currentGroupId)) {
188:       this.domain.currentGroupId = null;
189:     }
190:   }
191: }
