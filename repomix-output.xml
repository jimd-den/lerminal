<file path="src/usecases/pipeline/PipelineRunner.ts">
  1: import { Card } from "../../entities/card";
  2: import { Workspace } from "../../entities/workspace";
  3: import {
  4:   AssistantProfile,
  5:   AssistantCapability,
  6: } from "../../entities/assistantProfile";
  7: import { CardTypeDefinition } from "../../entities/cardTypeDefinition";
  8: import { Logger, silentLogger } from "../ports/Logger";
  9: import { UnknownCommandError } from "../errors";
 10: import { CommandContext, PipelineCommand } from "./Command";
 11: export interface PipelineEnvironment {
 12:   workspaceId: string;
 13:   parentId: string | null;
 14:   initialInputCards: Card[];
 15:   workspaces: Workspace[];
 16:   apiKey: string;
 17:   model: string;
 18:   systemPrompt: string;
 19:   chunkSystemPrompt: string;
 20:   assistantProfiles?: AssistantProfile[];
 21:   activeProfileIds?: Partial<Record<AssistantCapability, string>>;
 22:   cardTypes?: CardTypeDefinition[];
 23:   autoGroup?: boolean;
 24:   expansionStack?: string[];
 25: }
 26: interface ParsedStage {
 27:   cmd: string;
 28:   arg: string;
 29: }
 30: export type PipelineOutcome =
 31:   | { kind: "completed"; cards: Card[] }
 32:   | {
 33:       kind: "needsInput";
 34:       mode: "ask" | "source";
 35:       command: string;
 36:       resume?: {
 37:         command: string;
 38:         inputCards: Card[];
 39:         remainingPipeline: string;
 40:       };
 41:     }
 42:   | { kind: "review" }
 43:   | { kind: "goal" };
 44: export class PipelineRunner {
 45:   private readonly commands: Map<string, PipelineCommand>;
 46:   private readonly logger: Logger;
 47:   constructor(commands: PipelineCommand[], logger: Logger = silentLogger) {
 48:     this.commands = new Map(commands.map((c) => [c.name, c]));
 49:     this.logger = logger;
 50:   }
 51:   async run(
 52:     pipelineText: string,
 53:     env: PipelineEnvironment,
 54:   ): Promise<PipelineOutcome> {
 55:     const stages = this.parse(pipelineText);
 56:     let cards = env.initialInputCards;
 57:     for (let index = 0; index < stages.length; index += 1) {
 58:       const { cmd, arg } = stages[index];
 59:       const command = this.commands.get(cmd);
 60:       if (!command) {
 61:         throw new UnknownCommandError(cmd);
 62:       }
 63:       const ctx: CommandContext = {
 64:         workspaceId: env.workspaceId,
 65:         parentId: env.parentId,
 66:         inputCards: cards,
 67:         workspaces: env.workspaces,
 68:         apiKey: env.apiKey,
 69:         model: env.model,
 70:         systemPrompt: env.systemPrompt,
 71:         chunkSystemPrompt: env.chunkSystemPrompt,
 72:         assistantProfiles: env.assistantProfiles,
 73:         activeProfileIds: env.activeProfileIds,
 74:         cardTypes: env.cardTypes,
 75:         expansionStack: env.expansionStack ?? [],
 76:       };
 77:       const result = await command.execute(arg, ctx);
 78:       if (result.kind === "needsInput") {
 79:         this.logger.debug("pipeline.halted", { reason: "needsInput", stage: cmd });
 80:         const outerRemainder = stages
 81:           .slice(index + 1)
 82:           .map(formatPipelineStage)
 83:           .join(" | ");
 84:         const resume = result.resume ?? {
 85:           command: cmd,
 86:           inputCards: cards,
 87:           remainingPipeline: "",
 88:         };
 89:         const remainingPipeline = [resume.remainingPipeline, outerRemainder]
 90:           .filter(Boolean)
 91:           .join(" | ");
 92:         const needsContinuation = Boolean(
 93:           remainingPipeline || resume.inputCards.length || result.resume,
 94:         );
 95:         return {
 96:           kind: "needsInput",
 97:           mode: result.mode,
 98:           command: needsContinuation ? resume.command : cmd,
 99:           ...(needsContinuation
100:             ? { resume: { ...resume, remainingPipeline } }
101:             : {}),
102:         };
103:       }
104:       if (result.kind === "review") {
105:         this.logger.debug("pipeline.halted", { reason: "review" });
106:         return { kind: "review" };
107:       }
108:       if (result.kind === "goal") {
109:         this.logger.debug("pipeline.halted", { reason: "goal" });
110:         return { kind: "goal" };
111:       }
112:       cards = result.kind === "cards" ? result.cards : [];
113:     }
114:     this.logger.debug("pipeline.completed", { outputCards: cards.length });
115:     return { kind: "completed", cards };
116:   }
117:   private parse(pipelineText: string): ParsedStage[] {
118:     const stages: ParsedStage[] = [];
119:     for (const raw of splitPipelineStages(pipelineText)) {
120:       const match = raw.match(/^([a-zA-Z0-9_-]+)\s*([\s\S]*)$/);
121:       if (!match) continue;
122:       const rawArg = match[2].trim();
123:       stages.push({
124:         cmd: match[1].toLowerCase(),
125:         arg: unquotePipelineArg(rawArg),
126:       });
127:     }
128:     return stages;
129:   }
130: }
131: function formatPipelineStage(stage: ParsedStage): string {
132:   if (!stage.arg) return stage.cmd;
133:   return `${stage.cmd} "${stage.arg.replace(/\\/g, "\\\\").replace(/"/g, '\\"')}"`;
134: }
135: function splitPipelineStages(input: string): string[] {
136:   const stages: string[] = [];
137:   let current = "";
138:   let quote: '"' | "'" | null = null;
139:   let escaped = false;
140:   for (const char of input) {
141:     if (escaped) {
142:       current += char;
143:       escaped = false;
144:       continue;
145:     }
146:     if (char === "\\") {
147:       current += char;
148:       escaped = true;
149:       continue;
150:     }
151:     if (char === '"' || char === "'") {
152:       quote = quote === char ? null : (quote ?? char);
153:       current += char;
154:       continue;
155:     }
156:     if (char === "|" && !quote) {
157:       if (current.trim()) stages.push(current.trim());
158:       current = "";
159:       continue;
160:     }
161:     current += char;
162:   }
163:   if (current.trim()) stages.push(current.trim());
164:   return stages;
165: }
166: function unquotePipelineArg(arg: string): string {
167:   const quote = arg[0];
168:   const quoted =
169:     (quote === '"' || quote === "'") && arg[arg.length - 1] === quote;
170:   const value = quoted ? arg.slice(1, -1) : arg;
171:   return value.replace(/\\([\\"'])/g, "$1");
172: }
</file>

