<file path="src/adapters/presenters/CommandPalettePresenter.ts">
 1: import { AppState } from "./GriotController";
 2: import { CommandDefinition } from "../../entities/commandDefinition";
 3: import {
 4:   CanonicalAction,
 5:   CommandAvailability,
 6:   CommandDoc,
 7:   CANONICAL_ACTIONS,
 8:   COMMAND_DOCS,
 9:   commandAvailability,
10: } from "../../usecases/commands/commandCatalog";
11: import { expandForPipe } from "../../entities/tree";
12: export interface PaletteCommand {
13:   doc: CommandDoc;
14:   availability: CommandAvailability;
15: }
16: export interface PaletteAction {
17:   action: CanonicalAction;
18:   availability: CommandAvailability;
19: }
20: export interface CommandPaletteModel {
21:   selectionSummary: string;
22:   selectedCount: number;
23:   actions: PaletteAction[];
24:   commands: PaletteCommand[];
25:   customCommands: CommandDefinition[];
26:   pinnedCommands: string[];
27: }
28: function summarizeSelection(count: number): string {
29:   if (count === 0) return "Nothing selected — commands that need input will say so";
30:   return `${count} card${count === 1 ? "" : "s"} selected`;
31: }
32: function actionAvailability(action: CanonicalAction, selectedCount: number): CommandAvailability {
33:   if (action.requiresSelection && selectedCount === 0) {
34:     return { runnable: false, reason: "Select cards first" };
35:   }
36:   return { runnable: true, reason: null };
37: }
38: export function presentCommandPalette(state: AppState): CommandPaletteModel {
39:   const selectedCount = expandForPipe(state.cards, state.selection).length;
40:   return {
41:     selectionSummary: summarizeSelection(selectedCount),
42:     selectedCount,
43:     actions: CANONICAL_ACTIONS.map(action => ({
44:       action,
45:       availability: actionAvailability(action, selectedCount),
46:     })),
47:     commands: COMMAND_DOCS.map(doc => ({
48:       doc,
49:       availability: commandAvailability(doc, selectedCount),
50:     })),
51:     customCommands: state.commandDefinitions,
52:     pinnedCommands: state.pinnedCommands,
53:   };
54: }
