  1: import React, { useState } from "react";
  2: import { ScrollView, Text, View } from "react-native";
  3: import {
  4:   GriotDeckModel,
  5:   MaterialFilter,
  6:   filterMaterials,
  7: } from "../../../../adapters/presenters/GriotDeckPresenter";
  8: import { presentMissionCanvas } from "../../../../adapters/presenters/MissionCanvasPresenter";
  9: import { Card } from "../../../../entities/card";
 10: import { Chip, SectionLabel, SystemHeader } from "../components";
 11: import { MissionCanvasHeader } from "../MissionCanvas";
 12: import { ContextCardRow } from "../ContextCards";
 13: import { CaptureIntent, SharedProps } from "./types";
 14: import { EmptyReadout } from "./shared";
 15: import { styles } from "./screenStyles";
 16: export function SpaceScreen({
 17:   controller,
 18:   state,
 19:   theme,
 20:   model,
 21:   onBack,
 22:   onOpenDocument,
 23:   onOpenCard,
 24:   onCapture,
 25: }: SharedProps & {
 26:   model: GriotDeckModel;
 27:   onBack: () => void;
 28:   onOpenDocument: (groupId: string) => void;
 29:   onOpenCard: (cardId: string) => void;
 30:   onCapture: (intent: CaptureIntent) => void;
 31: }) {
 32:   const [filter, setFilter] = useState<MaterialFilter>("all");
 33:   const materials = filterMaterials(model.rootMaterials, filter);
 34:   const selectionMode = state.selection.size > 0;
 35:   const mission = presentMissionCanvas(
 36:     state.gapReport,
 37:     model.activeSpace?.name ?? "",
 38:   );
 39:   const openMaterial = (card: Card) => {
 40:     if (selectionMode) controller.toggleSelect(card.id);
 41:     else if (card.type === "group") onOpenDocument(card.id);
 42:     else onOpenCard(card.id);
 43:   };
 44:   return (
 45:     <View style={styles.screen}>
 46:       <ScrollView
 47:         style={styles.screen}
 48:         contentContainerStyle={styles.content}
 49:         showsVerticalScrollIndicator={false}
 50:       >
 51:         <SystemHeader
 52:           eyebrow="MISSION // WORKSTATION"
 53:           title={model.activeSpace?.name ?? "Learning space"}
 54:           theme={theme}
 55:           leftAction={{ label: "< LIBRARY", onPress: onBack }}
 56:           rightAction={{ label: "+ ADD", onPress: () => onCapture("note") }}
 57:         />
 58:         <MissionCanvasHeader
 59:           view={mission}
 60:           theme={theme}
 61:           onOpenReport={() => controller.openGapReport()}
 62:           onDefineMission={() => controller.openGoalArchitect()}
 63:           onRunNextAction={() =>
 64:             void controller.dispatchSuggestedAction(
 65:               mission.nextAction?.presetId
 66:                 ? { kind: "preflight", presetId: mission.nextAction.presetId }
 67:                 : { kind: "status" },
 68:             )
 69:           }
 70:         />
 71:         <SectionLabel theme={theme}>MATERIAL FILTER</SectionLabel>
 72:         <ScrollView
 73:           horizontal
 74:           showsHorizontalScrollIndicator={false}
 75:           contentContainerStyle={styles.chipRow}
 76:         >
 77:           {(["all", "notes", "sources", "practice", "due"] as MaterialFilter[]).map(
 78:             (option) => (
 79:               <Chip
 80:                 key={option}
 81:                 label={option.toUpperCase()}
 82:                 active={filter === option}
 83:                 theme={theme}
 84:                 onPress={() => setFilter(option)}
 85:               />
 86:             ),
 87:           )}
 88:         </ScrollView>
 89:         <SectionLabel
 90:           theme={theme}
 91:           code={`${materials.length.toString().padStart(2, "0")} CARDS`}
 92:         >
 93:           CONTEXT / CARDS
 94:         </SectionLabel>
 95:         {materials.length === 0 ? (
 96:           <EmptyReadout theme={theme} text="Nothing matches this filter." />
 97:         ) : (
 98:           materials.map((card) => (
 99:             <ContextCardRow
100:               key={card.id}
101:               card={card}
102:               theme={theme}
103:               selected={state.selection.has(card.id)}
104:               onPress={() => openMaterial(card)}
105:               onLongPress={() => controller.toggleSelect(card.id)}
106:             />
107:           ))
108:         )}
109:         {selectionMode ? (
110:           <Text style={[styles.selectionHint, { color: theme.textFaint }]}>
111:             Selected cards are the input to whatever you run next.
112:           </Text>
113:         ) : null}
114:       </ScrollView>
115:     </View>
116:   );
117: }
</file>

