 39:   return role ? ROLE_COLORS[role] : null;
 40: }
 41: export interface GriotTheme {
 42:   mode: AppState["theme"];
 43:   background: string;
 44:   panel: string;
 45:   panelStrong: string;
 46:   panelMuted: string;
 47:   text: string;
 48:   textMuted: string;
 49:   textFaint: string;
 50:   line: string;
 51:   accent: string;
 52:   accentSoft: string;
 53:   accentInk: string;
 54:   danger: string;
 55:   warning: string;
 56:   evidence: string;
 57:   fontMono: string;
 58:   fontSans: string | undefined;
 59: }
 60: export const ACCENT_OPTIONS: { name: AccentName; color: string; label: string }[] = [
 61:   { name: "teal", color: "#63E6D5", label: "Ion" },
 62:   { name: "lilac", color: "#C5A8FF", label: "Violet" },
 63:   { name: "amber", color: "#FFB45B", label: "Solar" },
 64:   { name: "rose", color: "#FF7895", label: "Coral" },
 65:   { name: "arctic", color: "#75C8FF", label: "Arctic" },
 66: ];
 67: const SYSTEM_MONO_FAMILY = Platform.select({
 68:   ios: "Menlo",
 69:   android: "monospace",
 70:   default: "monospace",
 71: }) as string;
 72: function resolveFontFamily(choice: FontChoice, role: "mono" | "sans"): string | undefined {
 73:   if (choice.source === "system") {
 74:     return role === "mono" ? SYSTEM_MONO_FAMILY : undefined;
 75:   }
 76:   return choice.family;
 77: }
 78: export function resolveGriotTheme(
 79:   mode: AppState["theme"],
 80:   accentName: AccentName,
 81:   appearance?: AppearanceSettings
 82: ): GriotTheme {
 83:   const legacyAccent =
 84:     ACCENT_OPTIONS.find(option => option.name === accentName)?.color ?? ACCENT_OPTIONS[0].color;
 85:   const resolved = resolveAppearance(appearance);
 86:   const usingCustomPalette = Boolean(appearance?.paletteId);
 87:   const palette = resolved.palette;
 88:   const dark = usingCustomPalette ? palette.mode === "dark" : mode === "dark";
 89:   const accent = appearance?.accentOverride
 90:     ? resolved.accent
 91:     : usingCustomPalette
 92:       ? palette.accent
 93:       : legacyAccent;
 94:   const base = usingCustomPalette
 95:     ? palette
 96:     : {
 97:         background: dark ? "#090E13" : "#EEF1EC",
 98:         panel: dark ? "#101820" : "#FBFCF7",
 99:         panelStrong: dark ? "#17232C" : "#FFFFFF",
100:         panelMuted: dark ? "#0D141A" : "#E4E9E2",
101:         text: dark ? "#F2F6F1" : "#131A1A",
102:         textMuted: dark ? "#A7B6B5" : "#536260",
103:         textFaint: dark ? "#637574" : "#7B8884",
104:         line: dark ? "#26363D" : "#CBD4CE",
105:         accentInk: dark ? "#06110F" : "#07110F",
106:         danger: "#FF5F69",
107:         warning: "#FFB45B",
108:         evidence: dark ? "#8AB4FF" : "#1F5FBF",
109:       };
110:   return {
111:     mode: dark ? "dark" : "light",
112:     background: base.background,
113:     panel: base.panel,
114:     panelStrong: base.panelStrong,
115:     panelMuted: base.panelMuted,
116:     text: base.text,
117:     textMuted: base.textMuted,
118:     textFaint: base.textFaint,
119:     line: base.line,
120:     accent,
121:     accentSoft: `${accent}22`,
122:     accentInk: base.accentInk,
123:     danger: base.danger,
124:     warning: base.warning,
125:     evidence: base.evidence,
126:     fontMono: resolveFontFamily(resolved.monoFont, "mono") ?? SYSTEM_MONO_FAMILY,
127:     fontSans: resolveFontFamily(resolved.sansFont, "sans"),
128:   };
129: }
