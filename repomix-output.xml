<file path="src/adapters/presenters/GriotDeckPresenter.ts">
 1: import { Card } from "../../entities/card";
 2: import { AppState } from "./GriotController";
 3: export type MaterialFilter = "all" | "notes" | "sources" | "practice" | "due";
 4: export interface LearningSpaceSummary {
 5:   id: string;
 6:   name: string;
 7:   active: boolean;
 8:   materialCount?: number;
 9:   dueCount?: number;
10: }
11: export interface GriotDeckModel {
12:   activeSpace: LearningSpaceSummary | null;
13:   spaces: LearningSpaceSummary[];
14:   dueCards: Card[];
15:   reviewMinutes: number;
16:   nextDocument: Card | null;
17:   rootMaterials: Card[];
18:   recentCards: Card[];
19: }
20: export interface DocumentModel {
21:   group: Card;
22:   source: Card | null;
23:   materials: Card[];
24:   chunkCount: number;
25:   practiceCount: number;
26:   materialCount: number;
27:   learningCards: Card[];
28: }
29: export function presentGriotDeck(state: AppState, now: number = Date.now()): GriotDeckModel {
30:   const dueCards = state.cards.filter(card => card.schedule && card.schedule.dueAt <= now);
31:   const rootMaterials = state.cards.filter(card => !card.parentId);
32:   const nextDocument = rootMaterials.find(card => card.type === "group" && card.documentGroupFor)
33:     ?? rootMaterials.find(card => card.type === "group")
34:     ?? null;
35:   const activeWorkspace = state.workspaces.find(space => space.id === state.activeWorkspaceId) ?? null;
36:   const spaces = state.workspaces.map(space => ({
37:     id: space.id,
38:     name: space.name,
39:     active: space.id === state.activeWorkspaceId,
40:     materialCount: space.id === state.activeWorkspaceId ? state.cards.length : undefined,
41:     dueCount: space.id === state.activeWorkspaceId ? dueCards.length : undefined,
42:   }));
43:   return {
44:     activeSpace: activeWorkspace ? spaces.find(space => space.id === activeWorkspace.id) ?? null : null,
45:     spaces,
46:     dueCards,
47:     reviewMinutes: Math.max(2, Math.ceil(dueCards.length * 1.5)),
48:     nextDocument,
49:     rootMaterials,
50:     recentCards: [...state.cards].sort((left, right) => right.createdAt - left.createdAt).slice(0, 4),
51:   };
52: }
53: export function presentDocument(cards: Card[], groupId: string): DocumentModel | null {
54:   const group = cards.find(card => card.id === groupId && card.type === "group");
55:   if (!group) return null;
56:   const materials = cards.filter(card => card.parentId === groupId);
57:   const source = materials.find(card => card.id === group.documentGroupFor)
58:     ?? materials.find(card => card.type === "source")
59:     ?? null;
60:   const descendants = descendantCards(cards, groupId);
61:   return {
62:     group,
63:     source,
64:     materials,
65:     chunkCount: descendants.filter(card => card.type === "chunk").length,
66:     practiceCount: descendants.filter(card => card.schedule || card.type === "question").length,
67:     materialCount: descendants.length,
68:     learningCards: descendants.filter(card => card.type === "chunk" || card.type === "note"),
69:   };
70: }
71: function descendantCards(cards: Card[], parentId: string): Card[] {
72:   const direct = cards.filter(card => card.parentId === parentId);
73:   return direct.flatMap(card => card.type === "group" ? [card, ...descendantCards(cards, card.id)] : [card]);
74: }
75: export function filterMaterials(cards: Card[], filter: MaterialFilter, now: number = Date.now()): Card[] {
76:   if (filter === "all") return cards;
77:   if (filter === "notes") return cards.filter(card => card.type === "note");
78:   if (filter === "sources") return cards.filter(card => card.type === "source");
79:   if (filter === "practice") return cards.filter(card => card.type === "question" || !!card.schedule);
80:   return cards.filter(card => card.schedule && card.schedule.dueAt <= now);
81: }
82: export function materialLabel(card: Card): string {
83:   if (card.type === "group") return card.documentGroupFor ? "DOCUMENT" : "GROUP";
84:   if (card.schedule || card.type === "question") return "PRACTICE";
85:   return card.type.toUpperCase();
86: }
</file>

