1402:         const sourceCard = this.domain.cards.find(
1403:           (c) => c.id === sourceCardIdForGrouping,
1404:         );
1405:         if (sourceCard) {
1406:           const group = await this.groupCardsInteractor.execute({
1407:             workspaceId,
