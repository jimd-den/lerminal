 87:   });
 88:   it("keeps accepting mutations after one of them fails", async () => {
 89:     const store = new FakeStore();
 90:     const items = collection(store);
 91:     store.failWrite = true;
 92:     await items.mutate((all) => all).catch(() => undefined);
 93:     store.failWrite = false;
 94:     await items.mutate((all) => upsert(all, { id: "a", value: 1 }, identify));
 95:     expect(await items.readAll()).toEqual([{ id: "a", value: 1 }]);
