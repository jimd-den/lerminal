  1: import React, { useEffect, useRef } from "react";
  2: import { Animated, Easing, ViewStyle } from "react-native";
  3: import { useReducedMotion } from "../useReducedMotion";
  4: const DURATION = 220;
  5: export function ArrivalView({
  6:   children,
  7:   style,
  8:   delay = 0,
  9: }: {
 10:   children: React.ReactNode;
 11:   style?: ViewStyle | ViewStyle[];
 12:   delay?: number;
 13: }) {
 14:   const reducedMotion = useReducedMotion();
 15:   const progress = useRef(new Animated.Value(reducedMotion ? 1 : 0)).current;
 16:   useEffect(() => {
 17:     if (reducedMotion) {
 18:       progress.setValue(1);
 19:       return;
 20:     }
 21:     const animation = Animated.timing(progress, {
 22:       toValue: 1,
 23:       duration: DURATION,
 24:       delay,
 25:       easing: Easing.out(Easing.cubic),
 26:       useNativeDriver: true,
 27:     });
 28:     animation.start();
 29:     return () => animation.stop();
 30:   }, [delay, progress, reducedMotion]);
 31:   return (
 32:     <Animated.View
 33:       style={[
 34:         style,
 35:         {
 36:           opacity: progress,
 37:           transform: [
 38:             { translateY: progress.interpolate({ inputRange: [0, 1], outputRange: [8, 0] }) },
 39:           ],
 40:         },
 41:       ]}
 42:     >
 43:       {children}
 44:     </Animated.View>
 45:   );
 46: }
 47: export function PlaceTransition({
 48:   place,
 49:   children,
 50:   style,
 51: }: {
 52:   place: string;
 53:   children: React.ReactNode;
 54:   style?: ViewStyle | ViewStyle[];
 55: }) {
 56:   const reducedMotion = useReducedMotion();
 57:   const fade = useRef(new Animated.Value(1)).current;
 58:   const previous = useRef(place);
 59:   useEffect(() => {
 60:     if (previous.current === place) return;
 61:     previous.current = place;
 62:     if (reducedMotion) {
 63:       fade.setValue(1);
 64:       return;
 65:     }
 66:     fade.setValue(0.35);
 67:     const animation = Animated.timing(fade, {
 68:       toValue: 1,
 69:       duration: DURATION,
 70:       easing: Easing.out(Easing.cubic),
 71:       useNativeDriver: true,
 72:     });
 73:     animation.start();
 74:     return () => animation.stop();
 75:   }, [fade, place, reducedMotion]);
 76:   return <Animated.View style={[style, { opacity: fade }]}>{children}</Animated.View>;
 77: }
 78: export function CountPulse({
 79:   value,
 80:   children,
 81:   style,
 82: }: {
 83:   value: number | string;
 84:   children: React.ReactNode;
 85:   style?: ViewStyle | ViewStyle[];
 86: }) {
 87:   const reducedMotion = useReducedMotion();
 88:   const scale = useRef(new Animated.Value(1)).current;
 89:   const previous = useRef(value);
 90:   useEffect(() => {
 91:     if (previous.current === value) return;
 92:     previous.current = value;
 93:     if (reducedMotion) return;
 94:     const animation = Animated.sequence([
 95:       Animated.timing(scale, {
 96:         toValue: 1.12,
 97:         duration: 90,
 98:         easing: Easing.out(Easing.quad),
 99:         useNativeDriver: true,
100:       }),
101:       Animated.timing(scale, {
102:         toValue: 1,
103:         duration: 130,
104:         easing: Easing.out(Easing.quad),
105:         useNativeDriver: true,
106:       }),
107:     ]);
108:     animation.start();
109:     return () => animation.stop();
110:   }, [reducedMotion, scale, value]);
111:   return <Animated.View style={[style, { transform: [{ scale }] }]}>{children}</Animated.View>;
112: }
113: export function WorkingBar({
114:   active,
115:   color,
116:   trackColor,
117: }: {
118:   active: boolean;
119:   color: string;
120:   trackColor: string;
121: }) {
122:   const reducedMotion = useReducedMotion();
123:   const sweep = useRef(new Animated.Value(0)).current;
124:   useEffect(() => {
125:     if (!active || reducedMotion) {
126:       sweep.setValue(0);
127:       return;
128:     }
129:     const animation = Animated.loop(
130:       Animated.timing(sweep, {
131:         toValue: 1,
132:         duration: 1100,
133:         easing: Easing.inOut(Easing.quad),
134:         useNativeDriver: true,
135:       })
136:     );
137:     animation.start();
138:     return () => animation.stop();
139:   }, [active, reducedMotion, sweep]);
140:   if (!active) return null;
141:   return (
142:     <Animated.View
143:       accessibilityRole="progressbar"
144:       accessibilityValue={{ text: "Working" }}
145:       style={{ height: 3, backgroundColor: trackColor, overflow: "hidden", borderRadius: 2 }}
146:     >
147:       <Animated.View
148:         style={{
149:           height: 3,
150:           width: "40%",
151:           backgroundColor: color,
152:           transform: [
153:             {
154:               translateX: sweep.interpolate({
155:                 inputRange: [0, 1],
156:                 outputRange: reducedMotion ? [0, 0] : [-80, 240],
157:               }),
158:             },
159:           ],
160:         }}
161:       />
162:     </Animated.View>
163:   );
164: }
