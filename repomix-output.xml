1747:   /**
1748:    * Re-runs a failed pipeline operation, restoring the exact selection and group it
1749:    * originally ran against so the retry is faithful (not dependent on whatever is
1750:    * selected now).
1751:    */
1752:   async retryPipeline(opId: string): Promise<void> {
1753:     const op = this.operations.find(opId);
1754:     if (!op) return;
1755:     if (!op.pipelineText) {
1756:       this.showToast("This operation must be started again from its source");
1757:       return;
1758:     }
1759:     if (op.workspaceId && op.workspaceId !== this.domain.activeWorkspaceId) {
1760:       await this.switchWorkspace(op.workspaceId);
1761:       if (this.domain.activeWorkspaceId !== op.workspaceId) return;
1762:     }
1763:     const text = op.pipelineText;
1764:     const retry =
1765:       op.inputCardIds !== undefined
1766:         ? { inputCardIds: op.inputCardIds, parentId: op.parentId ?? null }
1767:         : undefined;
1768:     this.removePendingOperation(opId);
1769:     await this.runPipeline(text, retry);
1770:   }
