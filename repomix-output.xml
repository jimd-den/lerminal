 83:     expect(session.state.isOpen).toBe(true);
 84:     expect(session.state.queue).toHaveLength(3);
 85:     expect(session.state.index).toBe(0);
 86:     expect(session.state.revealAnswer).toBe(false);
 87:   });
 88:   it("explains why a session could not start, and stays closed", () => {
 89:     host.cardList = [];
 90:     session.start();
 91:     expect(session.state.isOpen).toBe(false);
 92:     expect(host.messages).toHaveLength(1);
 93:   });
 94:   it("reveals the answer on request", async () => {
 95:     await seed(1);
 96:     session.start();
 97:     session.reveal();
 98:     expect(session.state.revealAnswer).toBe(true);
 99:   });
100:   it("hides the answer again on every advance", async () => {
101:     await seed(3);
102:     session.start();
103:     session.reveal();
104:     expect(await session.grade("good")).toBe(true);
105:     expect(session.state.revealAnswer).toBe(false);
106:     expect(session.state.index).toBe(1);
107:     session.reveal();
108:     await session.grade("good");
109:     expect(session.state.revealAnswer).toBe(false);
110:   });
111:   it("persists each grade as it happens and tells the app", async () => {
112:     const [card] = await seed(2);
113:     session.start();
114:     await session.grade("good");
115:     expect(host.graded).toHaveLength(1);
116:     const stored = await cardRepo.getCard(card.id);
117:     expect(stored?.schedule?.dueAt).toBeGreaterThan(NOW);
118:   });
119:   it("shows the graded card's new schedule in the queue rather than the stale copy", async () => {
120:     await seed(2);
121:     session.start();
122:     const before = session.state.queue[0].schedule?.dueAt;
123:     await session.grade("good");
124:     expect(session.state.queue[0].schedule?.dueAt).not.toBe(before);
125:   });
126:   it("closes itself after the last card and reloads", async () => {
