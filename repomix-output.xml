 1: import { useEffect, useState } from "react";
 2: import { AccessibilityInfo } from "react-native";
 3: export function useReducedMotion(): boolean {
 4:   const [reduced, setReduced] = useState(false);
 5:   useEffect(() => {
 6:     let active = true;
 7:     AccessibilityInfo.isReduceMotionEnabled().then(enabled => {
 8:       if (active) setReduced(enabled);
 9:     });
10:     const subscription = AccessibilityInfo.addEventListener(
11:       "reduceMotionChanged",
12:       setReduced
13:     );
14:     return () => {
15:       active = false;
16:       subscription.remove();
17:     };
18:   }, []);
19:   return reduced;
20: }
21: export function modalAnimation(reducedMotion: boolean, preferred: "slide" | "fade"): "slide" | "fade" | "none" {
22:   return reducedMotion ? "none" : preferred;
23: }
</file>

