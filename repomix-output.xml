<file path="src/entities/chunking.ts">
 1: import { Card, createCard } from "./card";
 2: const MIN_BLOCK_LENGTH = 12;
 3: const MAX_CHUNKS = 6;
 4: const TITLE_PREFIX_LENGTH = 30;
 5: function splitIntoBlocks(body: string): string[] {
 6:   const blocks = body
 7:     .split(/\n\s*\n/)
 8:     .map((block) => block.trim())
 9:     .filter((block) => block.length > MIN_BLOCK_LENGTH);
10:   return blocks.length > 0 ? blocks : [body];
11: }
12: export function chunkCard(card: Card): Card[] {
13:   const parentTitle = card.title.substring(0, TITLE_PREFIX_LENGTH);
14:   return splitIntoBlocks(card.body)
15:     .slice(0, MAX_CHUNKS)
16:     .map((paragraph, index) =>
17:       createCard({
18:         workspaceId: card.workspaceId,
19:         type: "chunk",
20:         title: `${parentTitle} · ${index + 1}`,
21:         body: paragraph,
22:         sourceRef: card.sourceRef || card.id,
23:         cite: card.cite,
24:       }),
25:     );
26: }
</file>

