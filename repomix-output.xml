156: const CATEGORIES = new Set<string>([
157:   "Sans Serif",
158:   "Serif",
159:   "Display",
160:   "Handwriting",
161:   "Monospace",
162: ]);
163: export function parseFontCatalog(payload: string): FontFamilySummary[] {
164:   const json = payload.replace(JSON_GUARD, "").trim();
165:   let parsed: any;
166:   try {
167:     parsed = JSON.parse(json);
168:   } catch {
169:     throw new Error("Google Fonts returned an unreadable catalog");
170:   }
171:   const list = parsed?.familyMetadataList;
172:   if (!Array.isArray(list)) {
173:     throw new Error("Google Fonts returned an unreadable catalog");
174:   }
175:   const families: FontFamilySummary[] = [];
176:   list.forEach((entry: any, index: number) => {
177:     const family = typeof entry?.family === "string" ? entry.family.trim() : "";
178:     if (!family) return;
179:     families.push({
180:       family,
181:       category: CATEGORIES.has(entry?.category)
182:         ? (entry.category as FontCategory)
183:         : "Sans Serif",
184:       popularity:
185:         typeof entry?.popularity === "number" ? entry.popularity : index + 1,
186:       designers: Array.isArray(entry?.designers)
187:         ? entry.designers.filter((d: unknown) => typeof d === "string")
188:         : [],
189:       axes: Array.isArray(entry?.axes)
190:         ? entry.axes
191:             .map((axis: any) => axis?.tag)
192:             .filter((tag: unknown): tag is string => typeof tag === "string")
193:         : [],
194:     });
195:   });
196:   return families;
197: }
</file>

