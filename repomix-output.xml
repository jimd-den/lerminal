  6: } from "../fontCatalog";
  7: const family = (
  8:   name: string,
  9:   popularity: number,
 10:   category: FontFamilySummary["category"] = "Sans Serif"
 11: ): FontFamilySummary => ({
 12:   family: name,
 13:   category,
 14:   popularity,
 15:   designers: [],
 16:   axes: [],
 17: });
 18: const CATALOG: FontFamilySummary[] = [
 19:   family("Roboto", 1),
 20:   family("Open Sans", 2),
 21:   family("Roboto Condensed", 5),
 22:   family("Lato", 6),
 23:   family("Inter", 8),
 24:   family("JetBrains Mono", 120, "Monospace"),
 25:   family("Roboto Mono", 40, "Monospace"),
 26:   family("EB Garamond", 200, "Serif"),
 27:   family("Cormorant Garamond", 300, "Serif"),
 28:   family("Dancing Script", 150, "Handwriting"),
 29: ];
 30: const names = (query: string, options = {}) =>
 31:   rankFontFamilies(query, CATALOG, options).map(r => r.summary.family);
 32: describe("scoreFontFamily", () => {
 33:   it("ranks an exact match above a prefix, and a prefix above a substring", () => {
 34:     const exact = scoreFontFamily("roboto", "Roboto")!;
 35:     const prefix = scoreFontFamily("roboto", "Roboto Mono")!;
 36:     const substring = scoreFontFamily("mono", "Roboto Mono")!;
 37:     expect(exact).toBeGreaterThan(prefix);
 38:     expect(prefix).toBeGreaterThan(substring);
 39:   });
 40:   it("ignores case and punctuation, which are the user's least reliable input", () => {
 41:     expect(scoreFontFamily("JETBRAINS-MONO", "JetBrains Mono")).toBe(
 42:       scoreFontFamily("jetbrains mono", "JetBrains Mono")
 43:     );
 44:   });
 45:   it("matches a word in the middle of a name", () => {
 46:     expect(scoreFontFamily("garamond", "Cormorant Garamond")).not.toBeNull();
 47:   });
 48:   it("tolerates dropped letters, so a misremembered name still finds the font", () => {
 49:     expect(scoreFontFamily("garamnd", "EB Garamond")).not.toBeNull();
 50:     expect(scoreFontFamily("jetbrans", "JetBrains Mono")).not.toBeNull();
 51:   });
 52:   it("matches words in any order", () => {
 53:     expect(scoreFontFamily("mono jetbrains", "JetBrains Mono")).not.toBeNull();
 54:   });
 55:   it("rejects a family that shares no ordered run of letters", () => {
 56:     expect(scoreFontFamily("zzzz", "Roboto")).toBeNull();
 57:   });
 58:   it("treats an empty query as matching everything equally", () => {
 59:     expect(scoreFontFamily("", "Roboto")).toBe(0);
 60:   });
 61: });
 62: describe("rankFontFamilies", () => {
 63:   it("puts the exact match first even when a rival is far more popular", () => {
 64:     expect(names("cormorant garamond")[0]).toBe("Cormorant Garamond");
 65:   });
 66:   it("prefers the shortest name among equally-good prefix matches", () => {
 67:     expect(names("roboto")).toEqual(["Roboto", "Roboto Mono", "Roboto Condensed"]);
 68:   });
 69:   it("breaks a genuine tie by popularity", () => {
 70:     const tied = [family("Alpha Sans", 90), family("Omega Sans", 4)];
 71:     expect(rankFontFamilies("sans", tied).map(r => r.summary.family)).toEqual([
 72:       "Omega Sans",
 73:       "Alpha Sans",
 74:     ]);
 75:   });
 76:   it("lists the most popular families when nothing has been typed", () => {
 77:     expect(names("", { limit: 3 })).toEqual(["Roboto", "Open Sans", "Roboto Condensed"]);
 78:   });
 79:   it("restricts results to a category when one is chosen", () => {
 80:     expect(names("", { category: "Monospace" })).toEqual([
 81:       "Roboto Mono",
 82:       "JetBrains Mono",
 83:     ]);
 84:   });
 85:   it("applies the category filter and the query together", () => {
 86:     expect(names("roboto", { category: "Monospace" })).toEqual(["Roboto Mono"]);
 87:   });
 88:   it("honours the result limit, since every shown row costs a font download", () => {
 89:     expect(names("", { limit: 2 })).toHaveLength(2);
 90:   });
 91:   it("returns nothing when the query genuinely matches nothing", () => {
 92:     expect(names("qqqqzzzz")).toEqual([]);
 93:   });
 94:   it("treats a kind of font as a search term", () => {
 95:     expect(names("handwriting")).toEqual(["Dancing Script"]);
 96:     expect(names("hand writing")).toEqual(["Dancing Script"]);
 97:   });
 98:   it("puts monospace faces above display fonts that merely start with 'mono'", () => {
 99:     const withDecoy = [...CATALOG, family("Monoton", 150, "Display")];
100:     const ranked = rankFontFamilies("mono", withDecoy).map(r => r.summary.family);
101:     expect(ranked.slice(0, 2)).toEqual(["Roboto Mono", "JetBrains Mono"]);
102:     expect(ranked).toContain("Monoton");
103:   });
104:   it("still finds a family whose full name is typed, even if it looks like a category", () => {
105:     const withDecoy = [...CATALOG, family("Monoton", 150, "Display")];
106:     expect(rankFontFamilies("monoton", withDecoy)[0].summary.family).toBe("Monoton");
107:   });
108: });
