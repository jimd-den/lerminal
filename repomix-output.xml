 9:   make("g1", undefined, "group"),
10:   make("g2", "g1", "group"),
11:   make("deep", "g2"),
12:   make("child", "g1"),
13:   make("loose"),
14: ];
15: const plan = (
16:   selected: string[],
17:   options: { currentGroupId?: string | null; recursiveGroups?: boolean } = {},
18: ) =>
19:   planDeletion({
