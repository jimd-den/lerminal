 8:     expect(schedule.interval).toBe(1);
 9:     expect(schedule.reps).toBe(0);
10:     expect(schedule.dueAt).toBe(mockNow + DAY_IN_MS);
11:   });
12:   it("should increase interval and reps on successful review (ok: true)", () => {
13:     const initial = createInitialSchedule(mockNow);
14:     const step1 = updateSchedule(initial, true, mockNow);
15:     expect(step1.interval).toBe(3);
16:     expect(step1.reps).toBe(1);
17:     expect(step1.dueAt).toBe(mockNow + 3 * DAY_IN_MS);
18:     const step2 = updateSchedule(step1, true, mockNow);
19:     expect(step2.interval).toBe(8);
20:     expect(step2.reps).toBe(2);
21:     expect(step2.dueAt).toBe(mockNow + 8 * DAY_IN_MS);
22:   });
23:   it("should reset interval to 1 and set due to 10 minutes on failed review (ok: false)", () => {
24:     const initial = { interval: 8, reps: 2, dueAt: mockNow };
25:     const failed = updateSchedule(initial, false, mockNow);
26:     expect(failed.interval).toBe(1);
27:     expect(failed.reps).toBe(2);
