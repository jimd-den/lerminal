124:                 },
125:               ]}
126:             >
127:               {option.toUpperCase()}
128:             </Text>
129:           </Pressable>
130:         ))}
131:       </View>
132:       <View
133:         style={[
134:           styles.overview,
135:           { backgroundColor: theme.panelStrong, borderColor: theme.line },
136:         ]}
137:       >
138:         <Text
139:           style={[
140:             styles.kicker,
141:             { color: theme.accent, fontFamily: theme.fontMono },
142:           ]}
143:         >
144:           DOCUMENT MAP
145:         </Text>
146:         <Text style={[styles.overviewText, { color: theme.text }]}>
147:           {document.source
148:             ? "Original source connected"
149:             : "Grouped learning material"}
150:         </Text>
151:         <Text
152:           style={[
153:             styles.overviewMeta,
154:             { color: theme.textMuted, fontFamily: theme.fontMono },
155:           ]}
156:         >
157:           {document.chunkCount} chunks
158:           {document.materialCount} total
159:         </Text>
160:       </View>
161:       {mode === "discuss" ? (
162:         <View
163:           style={[
164:             styles.discussPanel,
165:             { backgroundColor: theme.accentSoft, borderColor: theme.accent },
166:           ]}
167:         >
168:           <Text style={[styles.discussTitle, { color: theme.text }]}>
169:             Open a grounded channel
