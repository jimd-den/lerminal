<file path="src/adapters/presenters/ActivityPresenter.ts">
 1: import { AppState } from "./GriotController";
 2: import { findCommandDoc } from "../../usecases/commands/commandCatalog";
 3: export interface ActivityModel {
 4:   label: string;
 5:   usesModel: boolean;
 6:   usesWeb: boolean;
 7:   error: { message: string; operationId: string; canRetry: boolean } | null;
 8: }
 9: function leadingCommand(pipelineText: string): string {
10:   return pipelineText.trim().split(/[\s|]/)[0]?.toLowerCase() ?? "";
11: }
12: /** Turns a raw pipeline string into something worth reading on a banner. */
13: function describeRun(pipelineText: string): { label: string; usesModel: boolean; usesWeb: boolean } {
14:   const command = leadingCommand(pipelineText);
15:   const doc = findCommandDoc(command);
16:   if (!doc) {
17:     // A custom command or macro — we can't know its exposure, so we don't claim to.
18:     return { label: `Running ${command || "command"}`, usesModel: false, usesWeb: false };
19:   }
20:   return { label: doc.label, usesModel: doc.usesModel, usesWeb: doc.usesWeb };
21: }
22: export function presentActivity(state: AppState): ActivityModel | null {
23:   const failed = state.pendingOperations.find(operation => operation.status === "error");
24:   if (failed) {
25:     return {
26:       label: describeRun(failed.pipelineText ?? failed.commandName).label,
27:       usesModel: false,
28:       usesWeb: false,
29:       error: {
30:         message: failed.errorMessage ?? "Something went wrong",
31:         operationId: failed.id,
32:         canRetry: Boolean(failed.pipelineText && !failed.pipelineText.includes("|")),
33:       },
34:     };
35:   }
36:   const running = state.pendingOperations.find(operation => operation.status === "loading");
37:   if (running) {
38:     const described = describeRun(running.pipelineText ?? running.commandName);
39:     return { ...described, error: null };
40:   }
41:   if (state.isCreatingBrief) {
42:     return { label: "Writing a cited brief", usesModel: true, usesWeb: false, error: null };
43:   }
44:   if (state.isSuggestingQueries) {
45:     return { label: "Suggesting search queries", usesModel: true, usesWeb: false, error: null };
46:   }
47:   if (state.chatStreamingCardId) {
48:     return { label: "Replying", usesModel: true, usesWeb: false, error: null };
49:   }
50:   if (state.researchLoading) {
51:     return { label: "Searching the web", usesModel: false, usesWeb: true, error: null };
52:   }
53:   if (state.isInstallingFont) {
54:     return { label: "Downloading a font", usesModel: false, usesWeb: true, error: null };
55:   }
56:   return null;
57: }
</file>

<file path="src/adapters/presenters/MissionCanvasPresenter.ts">
 1: import { SemanticRole } from "../../entities/card";
 2: import { GapReport } from "../../usecases/report/GapReportInteractor";
 3: export type SemanticTone = "accent" | "caution" | "evidence" | "neutral" | "positive";
 4: export interface MissionCounter {
 5:   label: string;
 6:   value: number;
 7:   tone: SemanticTone;
 8: }
 9: export interface MissionNextAction {
10:   label: string;
11:   reason: string;
12:   presetId?: string;
13: }
14: export interface MissionCanvasViewModel {
15:   hasMission: boolean;
16:   title: string;
17:   deliverable: string;
18:   contextLine: string;
19:   statusLabel: string;
20:   counters: MissionCounter[];
21:   nextAction: MissionNextAction | null;
22:   groupId: string | null;
23: }
24: export interface RolePresentation {
25:   label: string;
26:   tone: SemanticTone;
27: }
28: const ROLE_PRESENTATION: Record<SemanticRole, RolePresentation> = {
29:   goal: { label: "GOAL", tone: "accent" },
30:   question: { label: "BLOCKER", tone: "caution" },
31:   concept: { label: "CONCEPT", tone: "neutral" },
32:   source: { label: "SOURCE", tone: "evidence" },
33:   experiment: { label: "EXPERIMENT", tone: "accent" },
34:   claim: { label: "CLAIM", tone: "neutral" },
35:   task: { label: "TASK", tone: "neutral" },
36:   deliverable: { label: "DELIVERABLE", tone: "positive" },
37: };
38: export function presentRole(role: SemanticRole | undefined): RolePresentation | null {
39:   return role ? ROLE_PRESENTATION[role] : null;
40: }
41: export function presentMissionCanvas(
42:   report: GapReport | null,
43:   workspaceName: string,
44:   missionGroupId: string | null = null
45: ): MissionCanvasViewModel {
46:   const contextLine = workspaceName ? `Workspace / ${workspaceName}` : "Workspace";
47:   if (!report || !report.hasMission) {
48:     return {
49:       hasMission: false,
50:       title: "Define what you're working toward",
51:       deliverable: "",
52:       contextLine,
53:       statusLabel: "NO MISSION",
54:       counters: [],
55:       nextAction: null,
56:       groupId: null,
57:     };
58:   }
59:   const { evidence } = report;
60:   const candidates: MissionCounter[] = [
61:     { label: "Blockers", value: report.blockers.length, tone: "caution" },
62:     { label: "Evidence", value: evidence.sources, tone: "evidence" },
63:     { label: "Next tasks", value: evidence.tasks, tone: "neutral" },
64:     { label: "Prerequisites", value: evidence.concepts, tone: "neutral" },
65:   ];
66:   const recommended = report.recommendedActions[0];
67:   return {
68:     hasMission: true,
69:     title: report.missionTitle ?? "Untitled mission",
70:     deliverable: report.missionDeliverable ?? "",
71:     contextLine,
72:     statusLabel: "ACTIVE",
73:     counters: candidates.slice(0, 3),
74:     nextAction: recommended
75:       ? {
76:           label: recommended.label,
77:           reason: recommended.reason,
78:           presetId: recommended.presetId,
79:         }
80:       : null,
81:     groupId: missionGroupId,
82:   };
83: }
84: export function formatCounter(value: number): string {
85:   return value < 10 ? `0${value}` : String(value);
86: }
</file>

