<file path="src/frameworks/storage/JsonStore.ts">
  1: import { KeyValueStore } from "./KeyValueStore";
  2: import {
  3:   CorruptedDataError,
  4:   PersistenceError,
  5: } from "../../usecases/ports/PersistenceError";
  6: import { Logger, silentLogger } from "../../usecases/ports/Logger";
  7: export interface JsonStoreOptions {
  8:   logger?: Logger;
  9: }
 10: function createMutex(): (work: () => Promise<void>) => Promise<void> {
 11:   let tail: Promise<unknown> = Promise.resolve();
 12:   return (work) => {
 13:     const run = tail.then(work, work);
 14:     tail = run.catch(() => undefined);
 15:     return run;
 16:   };
 17: }
 18: async function readJson<T>(
 19:   store: KeyValueStore,
 20:   key: string,
 21:   name: string,
 22: ): Promise<T | undefined> {
 23:   let raw: string | null;
 24:   try {
 25:     raw = await store.getItem(key);
 26:   } catch (error) {
 27:     throw new PersistenceError(name, "read", error);
 28:   }
 29:   if (raw === null || raw === "") return undefined;
 30:   try {
 31:     return JSON.parse(raw) as T;
 32:   } catch (error) {
 33:     throw new CorruptedDataError(name, error);
 34:   }
 35: }
 36: /** Encodes and writes one key. Encoding failures are write failures from the caller's view. */
 37: async function writeJson(
 38:   store: KeyValueStore,
 39:   key: string,
 40:   name: string,
 41:   value: unknown,
 42: ): Promise<void> {
 43:   let encoded: string;
 44:   try {
 45:     encoded = JSON.stringify(value);
 46:   } catch (error) {
 47:     throw new PersistenceError(name, "write", error);
 48:   }
 49:   try {
 50:     await store.setItem(key, encoded);
 51:   } catch (error) {
 52:     throw new PersistenceError(name, "write", error);
 53:   }
 54: }
 55: export class JsonDocumentStore<T> {
 56:   private readonly logger: Logger;
 57:   constructor(
 58:     private readonly key: string,
 59:     private readonly store: KeyValueStore,
 60:     private readonly name: string,
 61:     options: JsonStoreOptions = {},
 62:   ) {
 63:     this.logger = options.logger ?? silentLogger;
 64:   }
 65:   async read(): Promise<T | null> {
 66:     const value = await readJson<T>(this.store, this.key, this.name);
 67:     return value ?? null;
 68:   }
 69:   async write(value: T): Promise<void> {
 70:     await writeJson(this.store, this.key, this.name, value);
 71:     this.logger.debug(`${this.name}.write`);
 72:   }
 73: }
 74: export class JsonCollectionStore<T> {
 75:   private readonly logger: Logger;
 76:   private readonly withLock = createMutex();
 77:   constructor(
 78:     private readonly key: string,
 79:     private readonly store: KeyValueStore,
 80:     private readonly name: string,
 81:     options: JsonStoreOptions = {},
 82:   ) {
 83:     this.logger = options.logger ?? silentLogger;
 84:   }
 85:   async readAll(): Promise<T[]> {
 86:     const value = await readJson<T[]>(this.store, this.key, this.name);
 87:     if (value === undefined) return [];
 88:     if (!Array.isArray(value)) throw new CorruptedDataError(this.name, "expected an array");
 89:     return value;
 90:   }
 91:   async writeAll(items: T[]): Promise<void> {
 92:     await this.withLock(() => writeJson(this.store, this.key, this.name, items));
 93:   }
 94:   async mutate(transform: (items: T[]) => T[]): Promise<void> {
 95:     await this.withLock(async () => {
 96:       const current = await this.readAll();
 97:       await writeJson(this.store, this.key, this.name, transform(current));
 98:       this.logger.debug(`${this.name}.mutate`);
 99:     });
100:   }
101: }
102: export type Identify<T> = (item: T) => string;
103: export function upsert<T>(items: T[], next: T, identify: Identify<T>): T[] {
104:   const id = identify(next);
105:   const index = items.findIndex((item) => identify(item) === id);
106:   if (index < 0) return [...items, next];
107:   const copy = [...items];
108:   copy[index] = next;
109:   return copy;
110: }
111: export function upsertAll<T>(items: T[], next: T[], identify: Identify<T>): T[] {
112:   return next.reduce((acc, item) => upsert(acc, item, identify), items);
113: }
114: export function removeById<T>(items: T[], id: string, identify: Identify<T>): T[] {
115:   return items.filter((item) => identify(item) !== id);
116: }
</file>

