 690:   private computeLinkedCardsForOpenCard(): Array<{
 691:     cardId: string;
 692:     title: string;
 693:     relation?: string;
 694:   }> {
 695:     const openCardId = this.ui.openCardId;
 696:     if (!openCardId) return [];
 697:     const result: Array<{ cardId: string; title: string; relation?: string }> = [];
 698:     for (const link of this.cardLinks) {
 699:       let otherId: string | null = null;
 700:       if (link.fromCardId === openCardId) otherId = link.toCardId;
 701:       else if (link.toCardId === openCardId) otherId = link.fromCardId;
 702:       if (!otherId) continue;
 703:       const otherCard = this.domain.cards.find((c) => c.id === otherId);
 704:       if (!otherCard) continue;
 705:       result.push({ cardId: otherCard.id, title: otherCard.title, relation: link.relation });
 706:     }
 707:     return result;
 708:   }
