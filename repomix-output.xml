 81:     if (!card) return false;
 82:     const updated = await this.deps.gradeReview.execute(
 83:       card,
 84:       grade,
 85:       this.now(),
 86:       this.deps.host.schedulerConfig(),
 87:     );
 88:     if (!updated) return this.current.isOpen;
 89:     this.deps.host.onCardGraded(updated);
 90:     const queue = this.current.queue.map((queued) =>
 91:       queued.id === updated.id ? updated : queued,
 92:     );
 93:     const nextIndex = this.current.index + 1;
 94:     if (nextIndex >= queue.length) {
 95:       this.patch({ ...CLOSED });
 96:       await this.deps.host.refreshCards();
 97:       this.deps.host.notify("Review complete!");
 98:       return false;
 99:     }
100:     this.patch({ queue, index: nextIndex, revealAnswer: false });
101:     return true;
102:   }
103:   applyCardUpdate(card: Card): void {
104:     if (!this.current.queue.some((queued) => queued.id === card.id)) return;
105:     this.patch({
106:       queue: this.current.queue.map((queued) =>
107:         queued.id === card.id ? card : queued,
108:       ),
109:     });
110:   }
111:   close(): void {
112:     this.patch({ ...CLOSED });
113:   }
114: }
</file>

