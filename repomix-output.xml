11:   make("deep", "g2"),
12:   make("child", "g1"),
13:   make("loose"),
14: ];
15: const plan = (
16:   selected: string[],
17:   options: { currentGroupId?: string | null; recursiveGroups?: boolean } = {},
18: ) =>
19:   planDeletion({
20:     cards: graph,
21:     selectedIds: new Set(selected),
22:     currentGroupId: options.currentGroupId ?? null,
23:     recursiveGroups: options.recursiveGroups ?? false,
24:   });
25: describe("planDeletion", () => {
26:   it("deletes exactly what was selected when nothing is nested", () => {
27:     expect(plan(["loose"]).toDelete.map((c) => c.id)).toEqual(["loose"]);
28:   });
29:   it("orders deletions deepest first, so no parent goes before its children", () => {
30:     const order = plan(["g1", "deep", "child"]).toDelete.map((c) => c.id);
31:     expect(order.indexOf("deep")).toBeLessThan(order.indexOf("child"));
32:     expect(order.indexOf("child")).toBeLessThan(order.indexOf("g1"));
33:   });
34:   it("skips cards already covered by a recursive delete of their ancestor", () => {
35:     const result = plan(["g1", "deep", "child"], { recursiveGroups: true });
36:     expect(result.toDelete.map((c) => c.id)).toEqual(["g1"]);
37:     expect(result.selected).toHaveLength(3);
38:   });
39:   it("keeps nested selections when contents are promoted rather than deleted", () => {
40:     const result = plan(["g1", "child"], { recursiveGroups: false });
41:     expect(result.toDelete.map((c) => c.id).sort()).toEqual(["child", "g1"]);
42:   });
43:   it("leaves the user where they are when their group survives", () => {
44:     expect(plan(["loose"], { currentGroupId: "g1" }).nextGroupId).toBe("g1");
45:   });
46:   it("moves the user up when the group they are inside is deleted", () => {
47:     expect(plan(["g2"], { currentGroupId: "g2" }).nextGroupId).toBe("g1");
48:   });
49:   it("moves the user out to the root when a top-level group is deleted", () => {
50:     expect(plan(["g1"], { currentGroupId: "g1" }).nextGroupId).toBeNull();
51:   });
52:   it("moves the user up when an ancestor is recursively deleted around them", () => {
53:     expect(
54:       plan(["g1"], { currentGroupId: "g2", recursiveGroups: true }).nextGroupId,
55:     ).toBeNull();
