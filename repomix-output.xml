<file path="src/usecases/ports/PersistenceError.ts">
 1: export type PersistenceOperation = "read" | "write";
 2: export class PersistenceError extends Error {
 3:   constructor(
 4:     readonly store: string,
 5:     readonly operation: PersistenceOperation,
 6:     readonly cause?: unknown,
 7:   ) {
 8:     super(`${store}: ${operation} failed${causeSuffix(cause)}`);
 9:     this.name = "PersistenceError";
10:   }
11: }
12: export class CorruptedDataError extends PersistenceError {
13:   constructor(store: string, cause?: unknown) {
14:     super(store, "read", cause);
15:     this.name = "CorruptedDataError";
16:   }
17: }
18: export function isPersistenceError(error: unknown): error is PersistenceError {
19:   return error instanceof PersistenceError;
20: }
21: function causeSuffix(cause: unknown): string {
22:   const message = cause instanceof Error ? cause.message : cause ? String(cause) : "";
23:   return message ? ` (${message})` : "";
24: }
