<file path="src/__tests__/dependencyRule.test.ts">
 1: import { describe, expect, it } from "bun:test";
 2: import { readdirSync, readFileSync, statSync } from "fs";
 3: import { join, relative, resolve } from "path";
 4: const SRC_ROOT = resolve(import.meta.dir, "..");
 5: const LAYERS = ["entities", "usecases", "adapters", "frameworks"] as const;
 6: type Layer = (typeof LAYERS)[number];
 7: const layerRank = (layer: Layer): number => LAYERS.indexOf(layer);
 8: function layerOf(path: string): Layer | null {
 9:   const [head] = path.split("/");
10:   return (LAYERS as readonly string[]).includes(head) ? (head as Layer) : null;
11: }
12: const isTestFile = (path: string): boolean =>
13:   path.includes("__tests__/") || path.endsWith(".test.ts") || path.endsWith(".test.tsx");
14: function* walk(dir: string): Generator<string> {
15:   for (const entry of readdirSync(dir)) {
16:     const full = join(dir, entry);
17:     if (statSync(full).isDirectory()) yield* walk(full);
18:     else if (/\.tsx?$/.test(entry)) yield full;
19:   }
20: }
21: const IMPORT_PATTERN = /(?:from|import)\s+["'](\.[^"']+)["']/g;
22: function relativeImports(absPath: string, source: string): string[] {
23:   const fromDir = resolve(absPath, "..");
24:   return [...source.matchAll(IMPORT_PATTERN)].map((match) =>
25:     relative(SRC_ROOT, resolve(fromDir, match[1])).replace(/\\/g, "/"),
26:   );
27: }
28: interface Violation {
29:   file: string;
30:   imported: string;
31:   from: Layer;
32:   to: Layer;
33: }
34: function findViolations(): Violation[] {
35:   const violations: Violation[] = [];
36:   for (const absPath of walk(SRC_ROOT)) {
37:     const file = relative(SRC_ROOT, absPath).replace(/\\/g, "/");
38:     if (isTestFile(file)) continue;
39:     const from = layerOf(file);
40:     if (!from) continue;
41:     for (const imported of relativeImports(absPath, readFileSync(absPath, "utf8"))) {
42:       const to = layerOf(imported);
43:       if (!to) continue;
44:       if (layerRank(to) > layerRank(from)) {
45:         violations.push({ file, imported, from, to });
46:       }
47:     }
48:   }
49:   return violations;
50: }
51: const describeViolation = (v: Violation): string =>
52:   `${v.file} (${v.from}) imports ${v.imported} (${v.to})`;
53: const NO_CONSOLE_LAYERS: readonly Layer[] = ["entities", "usecases", "adapters"];
54: function findConsoleUses(): string[] {
55:   const offenders: string[] = [];
56:   for (const absPath of walk(SRC_ROOT)) {
57:     const file = relative(SRC_ROOT, absPath).replace(/\\/g, "/");
58:     if (isTestFile(file)) continue;
59:     const layer = layerOf(file);
60:     if (!layer || !NO_CONSOLE_LAYERS.includes(layer)) continue;
61:     const source = readFileSync(absPath, "utf8");
62:     source.split("\n").forEach((line, index) => {
63:       if (/\bconsole\.(log|warn|error|info|debug)\(/.test(line)) {
64:         offenders.push(`${file}:${index + 1}`);
65:       }
66:     });
67:   }
68:   return offenders;
69: }
70: describe("dependency rule", () => {
71:   it("never lets an inner layer import an outer one", () => {
72:     const violations = findViolations();
73:     expect(violations.map(describeViolation)).toEqual([]);
74:   });
75:   it("scans a meaningful number of files (guards against a broken walker)", () => {
76:     expect([...walk(SRC_ROOT)].length).toBeGreaterThan(50);
77:   });
78:   it("keeps logging policy out of the inner layers", () => {
79:     expect(findConsoleUses()).toEqual([]);
80:   });
81: });
</file>

