1144:         setPrompt(response.systemPrompt ?? "");
1145:         setMessages([
1146:           ...next,
1147:           {
1148:             role: "assistant",
1149:             content: response.systemPrompt ?? "Profile ready.",
1150:           },
1151:         ]);
1152:       }
1153:     } catch (error: any) {
1154:       Alert.alert(
1155:         "Designer failed",
