128: function normalizeFormat(raw: string | undefined): FontFormat | null {
129:   switch (raw?.toLowerCase()) {
130:     case "truetype":
131:     case "ttf":
132:       return "truetype";
133:     case "opentype":
134:     case "otf":
135:       return "opentype";
136:     case "woff2":
137:       return "woff2";
138:     case "woff":
139:       return "woff";
140:     case "embedded-opentype":
141:     case "eot":
142:       return "embedded-opentype";
