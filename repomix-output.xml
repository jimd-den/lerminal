 12: const NOW = 1_800_000_000_000;
 13: const DAY = 24 * 60 * 60 * 1000;
 14: const dueCard = (title: string): Card => ({
 15:   ...createCard({ workspaceId: "w1", type: "question", title, body: `body of ${title}` }),
 16:   schedule: { ...createInitialSchedule(NOW - 10 * DAY), dueAt: NOW - DAY },
 17: });
 18: class RecordingHost implements ReviewHost {
 19:   cardList: Card[] = [];
 20:   changes = 0;
 21:   messages: string[] = [];
 22:   graded: Card[] = [];
 23:   refreshes = 0;
 24:   cards() {
 25:     return this.cardList;
 26:   }
 27:   cardTypes() {
 28:     return [...BUILTIN_CARD_TYPES];
 29:   }
 30:   interleaveReviews() {
 31:     return true;
 32:   }
 33:   schedulerConfig() {
 34:     return DEFAULT_FSRS_CONFIG;
 35:   }
 36:   onChange() {
 37:     this.changes++;
 38:   }
 39:   notify(message: string) {
 40:     this.messages.push(message);
 41:   }
 42:   onCardGraded(card: Card) {
 43:     this.graded.push(card);
 44:     this.cardList = this.cardList.map((c) => (c.id === card.id ? card : c));
 45:   }
 46:   async refreshCards() {
 47:     this.refreshes++;
 48:   }
 49: }
 50: describe("ReviewSession", () => {
 51:   let host: RecordingHost;
 52:   let cardRepo: MemoryCardRepository;
 53:   let session: ReviewSession;
 54:   beforeEach(() => {
 55:     host = new RecordingHost();
 56:     cardRepo = new MemoryCardRepository();
 57:     const scheduler = new FsrsScheduler();
 58:     session = new ReviewSession({
 59:       startReview: new StartReviewInteractor(),
 60:       gradeReview: new GradeReviewInteractor(
 61:         cardRepo,
 62:         scheduler,
 63:         new MemoryReviewLogRepository(),
 64:       ),
 65:       scheduler,
 66:       host,
 67:       now: () => NOW,
 68:     });
 69:   });
 70:   const seed = async (count: number) => {
 71:     const cards = Array.from({ length: count }, (_, i) => dueCard(`Card ${i + 1}`));
 72:     await cardRepo.saveCards(cards);
 73:     host.cardList = cards;
 74:     return cards;
 75:   };
 76:   it("starts closed", () => {
