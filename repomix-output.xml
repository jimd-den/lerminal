100:             cite: item.sourceExcerpt?.trim() || fallbackCite,
101:             parentId: docGroup.id,
102:             provenance: createProvenance({
103:               mode: "agent",
104:               sourceCardIds: [source.id],
105:               assistantProfileId: profile.id,
106:               model: ctx.model,
107:               isLocalFallback: usedLocalFallback || undefined,
108:             }),
109:           })
110:         );
111:       if (sourceChunks.length === 0) {
112:         const fallbackResult = await this.executeFaithfulSplit([source], ctx);
113:         if (fallbackResult.kind === "cards") {
114:           created.push(...fallbackResult.cards);
115:         }
116:         continue;
117:       }
118:       created.push(...sourceChunks);
119:     }
120:     if (created.length === 0) {
121:       throw new EmptySelectionError("Nothing to chunk");
122:     }
123:     await this.cardRepo.saveCards(created);
124:     this.logger.debug("chunk.completed", {
125:       created: created.length,
126:       sources: chunkable.length,
127:     });
128:     return { kind: "cards", cards: created };
129:   }
130:   private async ensureDocumentGroup(
131:     source: Card,
132:     ctx: CommandContext
133:   ): Promise<Card> {
134:     const allWorkspaceCards = await this.cardRepo.getCardsByWorkspace(ctx.workspaceId);
135:     const existingGroup = allWorkspaceCards.find(
136:       c => c.type === "group" && c.documentGroupFor === source.id
137:     );
138:     if (existingGroup) {
139:       return existingGroup;
140:     }
141:     const documentGroup = createCard({
142:       workspaceId: ctx.workspaceId,
143:       type: "group",
144:       title: source.title,
145:       body: "",
146:       parentId: source.parentId ?? ctx.parentId ?? undefined,
147:       sourceRef: source.sourceRef ?? source.id,
148:       cite: source.cite,
149:       documentGroupFor: source.id,
150:     });
151:     await this.cardRepo.saveCard(documentGroup);
152:     if (source.parentId !== documentGroup.id) {
153:       const updatedSource = { ...source, parentId: documentGroup.id };
154:       await this.cardRepo.saveCard(updatedSource);
155:     }
156:     return documentGroup;
157:   }
158:   private async executeFaithfulSplit(chunkable: Card[], ctx: CommandContext): Promise<CommandResult> {
159:     const created: Card[] = [];
160:     for (const source of chunkable) {
161:       const docGroup = await this.ensureDocumentGroup(source, ctx);
162:       const sourceRef = source.sourceRef || source.id;
163:       const sections = MarkdownChunkerService.chunk(source.body, source.title);
164:       if (sections.length <= 1) {
165:         const generated = chunkCard(source).map(c => ({ ...c, parentId: docGroup.id }));
166:         created.push(...generated);
167:         continue;
168:       }
169:       const tree = MarkdownChunkerService.chunkTree(source.body, source.title);
170:       this.materializeTree(tree, docGroup.id, source, sourceRef, ctx.workspaceId, created);
171:     }
172:     if (created.length === 0) {
173:       throw new EmptySelectionError("Nothing to chunk");
174:     }
175:     await this.cardRepo.saveCards(created);
176:     return { kind: "cards", cards: created };
177:   }
178:   private materializeTree(
179:     nodes: MarkdownNode[],
180:     parentId: string | undefined,
181:     source: Card,
182:     sourceRef: string,
183:     workspaceId: string,
184:     out: Card[]
185:   ): void {
186:     for (const node of nodes) {
187:       if (node.children.length === 0) {
188:         out.push(createCard({
189:           workspaceId,
190:           type: "chunk",
191:           title: node.title,
192:           body: node.body,
193:           sourceRef,
194:           cite: source.cite,
195:           parentId,
196:         }));
197:         continue;
198:       }
199:       const group = createCard({
200:         workspaceId,
201:         type: "group",
202:         title: node.title,
203:         body: "",
204:         sourceRef,
205:         cite: source.cite,
206:         parentId,
207:       });
208:       out.push(group);
209:       const lead = stripLeadingHeading(node.body);
210:       if (lead.length > 0) {
211:         out.push(createCard({
212:           workspaceId,
213:           type: "chunk",
214:           title: `${node.title} · Overview`,
215:           body: lead,
216:           sourceRef,
217:           cite: source.cite,
218:           parentId: group.id,
219:         }));
220:       }
221:       this.materializeTree(node.children, group.id, source, sourceRef, workspaceId, out);
222:     }
223:   }
224: }
225: function stripLeadingHeading(body: string): string {
226:   return body.replace(/^\s*#{1,6}\s.*(?:\r?\n|$)/, "").trim();
227: }
