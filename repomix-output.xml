138:       expect(await workflow.undoLast()).toBe(false);
139:       expect(workflow.state.undoableOperationId).toBeNull();
140:     });
141:     it("makes a completed run undoable", async () => {
142:       const id = await runAndRecord();
143:       expect(workflow.state.undoableOperationId).toBe(id);
144:       expect(await operationLog.getRecord(id)).not.toBeNull();
145:     });
