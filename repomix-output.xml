 1: import { AppState } from "./GriotController";
 2: import { Card } from "../../entities/card";
 3: import { NextAction, nextActionsForCard } from "../../usecases/capture/nextActions";
 4: import {
 5:   SelectionAction,
 6:   canEnrollInStudy,
 7:   selectionActions,
 8: } from "../../usecases/selection/selectionActions";
 9: import { expandForPipe } from "../../entities/tree";
10: export interface CaptureReceiptModel {
11:   summary: string;
12:   destinationLabel: string;
13:   createdCards: Card[];
14:   primaryActionLabel: string;
15:   nextActions: NextAction[];
16:   selectionChanged: boolean;
17:   canUndo: boolean;
18:   localFallbackReason: string | null;
19: }
20: function resolveDestinationLabel(state: AppState, groupId: string | undefined): string {
21:   if (groupId) {
22:     const group = state.cards.find(card => card.id === groupId);
23:     if (group) return group.title;
24:   }
25:   const workspace = state.workspaces.find(w => w.id === state.activeWorkspaceId);
26:   return workspace ? workspace.name : "this workspace";
27: }
28: export function presentCaptureReceipt(state: AppState): CaptureReceiptModel | null {
29:   const result = state.operationResult;
30:   if (!result) return null;
31:   const createdCards = result.createdCardIds
32:     .map(id => state.cards.find(card => card.id === id))
33:     .filter((card): card is Card => Boolean(card));
34:   const hasMission = Boolean(state.gapReport?.hasMission);
35:   const nextActions = createdCards.length > 0
36:     ? nextActionsForCard(createdCards[0], { hasMission })
37:     : [];
38:   return {
39:     summary: result.summary,
40:     destinationLabel: resolveDestinationLabel(state, result.destination.groupId),
41:     createdCards,
42:     primaryActionLabel: result.primaryActionLabel,
43:     nextActions,
44:     selectionChanged: createdCards.some(card => state.selection.has(card.id)),
45:     canUndo: Boolean(state.undoableOperationId),
46:     localFallbackReason: createdCards.some(card => card.provenance?.isLocalFallback)
47:       ? "No model answered, so these were written from a local template — not an AI response."
48:       : null,
49:   };
50: }
51: export type { SelectionAction };
52: export interface SelectionTrayModel {
53:   count: number;
54:   actions: SelectionAction[];
55:   canEnrollInStudy: boolean;
56: }
57: export function presentSelectionTray(state: AppState): SelectionTrayModel {
58:   const selectedCards = expandForPipe(state.cards, state.selection);
59:   return {
60:     count: selectedCards.length,
61:     actions: selectionActions({ selectedCards, cardTypes: state.cardTypes }),
62:     canEnrollInStudy: canEnrollInStudy({ selectedCards, cardTypes: state.cardTypes }),
63:   };
64: }
</file>

