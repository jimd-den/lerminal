51:     action(
52:       "connect",
53:       "Connect",
54:       { kind: "pipeline", text: "group" },
55:       empty
56:         ? "Select cards first"
57:         : selectedCards.length < 2
58:           ? "Select two or more cards to connect them"
59:           : null
60:     ),
61:     action(
62:       "study",
63:       "Study",
64:       { kind: "preflight", presetId: "make-study-cards" },
