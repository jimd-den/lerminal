<file path="src/usecases/pipeline/PipelineMacroCommand.ts">
 1: import { PipelineCommandDefinition } from "../../entities/commandDefinition";
 2: import { PipelineCycleError } from "../errors";
 3: import { CommandContext, CommandResult, PipelineCommand } from "./Command";
 4: import type { PipelineRunner } from "./PipelineRunner";
 5: export class PipelineMacroCommand implements PipelineCommand {
 6:   readonly name: string;
 7:   constructor(
 8:     private readonly definition: PipelineCommandDefinition,
 9:     private readonly getRunner: () => PipelineRunner,
10:   ) {
11:     this.name = definition.name;
12:   }
13:   async execute(arg: string, ctx: CommandContext): Promise<CommandResult> {
14:     if (ctx.expansionStack.includes(this.name)) {
15:       throw new PipelineCycleError(this.name);
16:     }
17:     const safeArg = arg.replace(/["']/g, "");
18:     const body = this.definition.body
19:       .replace(/\$1/g, safeArg)
20:       .replace(/\$ARG/g, safeArg);
21:     const outcome = await this.getRunner().run(body, {
22:       workspaceId: ctx.workspaceId,
23:       parentId: ctx.parentId,
24:       initialInputCards: ctx.inputCards,
25:       workspaces: ctx.workspaces,
26:       apiKey: ctx.apiKey,
27:       model: ctx.model,
28:       systemPrompt: ctx.systemPrompt,
29:       chunkSystemPrompt: ctx.chunkSystemPrompt,
30:       assistantProfiles: ctx.assistantProfiles,
31:       activeProfileIds: ctx.activeProfileIds,
32:       cardTypes: ctx.cardTypes,
33:       // The outer pipeline applies auto-grouping to the macro's output as a whole;
34:       // disable it inside so a macro doesn't double-wrap its own stages.
35:       autoGroup: false,
36:       expansionStack: [...ctx.expansionStack, this.name],
37:     });
38:     if (outcome.kind === "needsInput") {
39:       return { kind: "needsInput", mode: outcome.mode, resume: outcome.resume };
40:     }
41:     if (outcome.kind === "review") {
42:       return { kind: "review" };
43:     }
44:     if (outcome.kind === "goal") {
45:       return { kind: "goal" };
46:     }
47:     return { kind: "cards", cards: outcome.cards };
48:   }
49: }
</file>

