 1: import { SearchGateway, SearchResult } from "../../usecases/ports/gateways/SearchGateway";
 2: export class DuckDuckGoSearchGateway implements SearchGateway {
 3:   async search(query: string): Promise<SearchResult[]> {
 4:     const url = `https://html.duckduckgo.com/html/?q=${encodeURIComponent(query)}`;
 5:     try {
 6:       const response = await fetch(url, {
 7:         headers: {
 8:           "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"
 9:         }
10:       });
11:       if (!response.ok) {
12:         throw new Error(`DuckDuckGo returned status ${response.status}`);
13:       }
14:       const html = await response.text();
15:       return this.parseHtml(html);
16:     } catch (err: any) {
17:       console.error(`[DuckDuckGoSearchGateway] Error fetching search results: ${err.message}`);
18:       return [];
19:     }
20:   }
21:   private parseHtml(html: string): SearchResult[] {
22:     const results: SearchResult[] = [];
23:     const resultBlocks = html.split('class="result ');
24:     for (let i = 1; i < resultBlocks.length; i++) {
25:       const block = resultBlocks[i];
26:       if (results.length >= 10) break;
27:       const urlMatch = block.match(/href="([^"]+)"/);
28:       // Extract Title
29:       const titleMatch = block.match(/<h2 class="result__title">[\s\S]*?<a[^>]*>(.*?)<\/a>[\s\S]*?<\/h2>/i);
30:       const snippetMatch = block.match(/<a class="result__snippet[^>]*>(.*?)<\/a>/i);
31:       if (urlMatch && titleMatch && snippetMatch) {
32:         let rawUrl = urlMatch[1];
33:         // DuckDuckGo often redirects URLs like "
34:         if (rawUrl.includes("uddg=")) {
35:           const params = new URLSearchParams(rawUrl.split("?")[1] || "");
36:           const targetUrl = params.get("uddg");
37:           if (targetUrl) {
38:             rawUrl = decodeURIComponent(targetUrl);
39:           }
40:         } else if (rawUrl.startsWith("//")) {
41:           rawUrl = "https:" + rawUrl;
42:         } else if (rawUrl.startsWith("/")) {
43:           rawUrl = "https://duckduckgo.com" + rawUrl;
44:         }
45:         if (rawUrl.includes("duckduckgo.com/lite") || rawUrl.includes("duckduckgo.com/html")) {
46:           continue;
47:         }
48:         results.push({
49:           url: rawUrl,
50:           title: this.stripHtmlTags(titleMatch[1]),
51:           snippet: this.stripHtmlTags(snippetMatch[1]),
52:         });
53:       }
54:     }
55:     return results;
56:   }
57:   private stripHtmlTags(str: string): string {
58:     return str
59:       .replace(/<[^>]*>?/gm, "")
60:       .replace(/&nbsp;/g, " ")
61:       .replace(/&quot;/g, "\"")
62:       .replace(/&apos;/g, "'")
63:       .replace(/&lt;/g, "<")
64:       .replace(/&gt;/g, ">")
65:       .replace(/&amp;/g, "&")
66:       .trim();
67:   }
68: }
</file>

<file path="src/frameworks/network/GoogleFontsGateway.ts">
  1: import {
  2:   FontCategory,
  3:   FontFamilySummary,
  4:   FontFormat,
  5: } from "../../entities/fontCatalog";
  6: import {
  7:   FontGateway,
  8:   ResolveFontOptions,
  9:   ResolvedFontFile,
 10: } from "../../usecases/ports/gateways/FontGateway";
 11: const FONT_FORMAT_USER_AGENTS: Partial<Record<FontFormat, string>> = {
 12:   truetype:
 13:     "Mozilla/5.0 (Linux; U; Android 2.2; en-us; Nexus One Build/FRF91) AppleWebKit/533.1 (KHTML, like Gecko) Version/4.0 Mobile Safari/533.1",
 14:   woff2:
 15:     "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
 16:   woff: "Mozilla/5.0 (Linux; Android 4.3; Nexus 7 Build/JSS15Q) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/30.0.0.0 Safari/537.36",
 17: };
 18: const CSS_ENDPOINT = "https://fonts.googleapis.com/css2";
 19: const METADATA_ENDPOINT = "https://fonts.google.com/metadata/fonts";
 20: const JSON_GUARD = /^\)\]\}'/;
 21: export class GoogleFontsGateway implements FontGateway {
 22:   /**
 23:    * The catalog is ~2.7 MB and changes on the order of weeks, so it is fetched at most
 24:    * once per app session. Cached as the in-flight promise, not the result, so several
 25:    * keystrokes racing to open the picker share one download instead of starting four.
 26:    */
 27:   private catalog: Promise<FontFamilySummary[]> | null = null;
 28:   async listFamilies(): Promise<FontFamilySummary[]> {
 29:     if (!this.catalog) {
 30:       this.catalog = this.fetchCatalog().catch(err => {
 31:         // A failed fetch must not poison the cache — the next search should retry.
 32:         this.catalog = null;
 33:         throw err;
 34:       });
 35:     }
 36:     return this.catalog;
 37:   }
 38:   async resolveFont(
 39:     family: string,
 40:     options: ResolveFontOptions
 41:   ): Promise<ResolvedFontFile> {
 42:     const trimmed = family.trim();
 43:     if (!trimmed) {
 44:       throw new Error("Enter a font family name");
 45:     }
 46:     const accepted = options.acceptedFormats.filter(
 47:       format => FONT_FORMAT_USER_AGENTS[format]
 48:     );
 49:     if (accepted.length === 0) {
 50:       throw new Error("No supported font format was requested");
 51:     }
 52:     // Ask for the caller's preferred format first and stop at the first real hit, so a
 53:     const offered: FontFormat[] = [];
 54:     for (const format of accepted) {
 55:       const css = await this.fetchCss(trimmed, FONT_FORMAT_USER_AGENTS[format]!);
 56:       const match = selectFontSource(css, accepted);
 57:       if (match) return { family: trimmed, uri: match.uri, format: match.format };
 58:       offered.push(...describeOfferedFormats(css));
 59:     }
 60:     const seen = [...new Set(offered)];
 61:     throw new Error(
 62:       seen.length > 0
 63:         ? `"${trimmed}" is only offered as ${seen.join(", ")}, which this device can't load`
 64:         : `"${trimmed}" has no downloadable font file`
 65:     );
 66:   }
 67:   private async fetchCss(family: string, userAgent: string): Promise<string> {
 68:     const query = encodeURIComponent(family).replace(/%20/g, "+");
 69:     const url = `${CSS_ENDPOINT}?family=${query}&display=swap`;
 70:     let response: Response;
 71:     try {
 72:       response = await fetch(url, { headers: { "User-Agent": userAgent } });
 73:     } catch (err: any) {
 74:       throw new Error(`Couldn't reach Google Fonts: ${err?.message ?? "network error"}`);
 75:     }
 76:     if (response.status === 400) {
 77:       throw new Error(`Google Fonts has no family called "${family}"`);
 78:     }
 79:     if (!response.ok) {
 80:       throw new Error(`Google Fonts returned ${response.status}`);
 81:     }
 82:     return response.text();
 83:   }
 84:   private async fetchCatalog(): Promise<FontFamilySummary[]> {
 85:     let response: Response;
 86:     try {
 87:       response = await fetch(METADATA_ENDPOINT);
 88:     } catch (err: any) {
 89:       throw new Error(
 90:         `Couldn't reach Google Fonts: ${err?.message ?? "network error"}`
 91:       );
 92:     }
 93:     if (!response.ok) {
 94:       throw new Error(`Google Fonts returned ${response.status}`);
 95:     }
 96:     return parseFontCatalog(await response.text());
 97:   }
 98: }
 99: export interface FontSource {
100:   uri: string;
101:   format: FontFormat;
102: }
103: export function selectFontSource(
104:   css: string,
105:   acceptedFormats: FontFormat[]
106: ): FontSource | null {
107:   const sources = parseFontSources(css);
108:   for (const format of acceptedFormats) {
109:     const match = sources.find(source => source.format === format);
110:     if (match) return match;
111:   }
112:   return null;
113: }
114: export function parseFontSources(css: string): FontSource[] {
115:   const pattern = /url\((https:\/\/[^)]+?)\)(?:\s*format\(['"]?([a-z0-9-]+)['"]?\))?/gi;
116:   const sources: FontSource[] = [];
117:   for (const match of css.matchAll(pattern)) {
118:     const uri = match[1];
119:     const format = normalizeFormat(match[2]) ?? formatFromExtension(uri);
120:     if (format) sources.push({ uri, format });
121:   }
122:   return sources;
123: }
124: /** Formats a stylesheet offered, for an error message that says what went wrong. */
125: function describeOfferedFormats(css: string): FontFormat[] {
126:   return parseFontSources(css).map(source => source.format);
127: }
128: function normalizeFormat(raw: string | undefined): FontFormat | null {
129:   switch (raw?.toLowerCase()) {
130:     case "truetype":
131:     case "ttf":
132:       return "truetype";
133:     case "opentype":
134:     case "otf":
135:       return "opentype";
136:     case "woff2":
137:       return "woff2";
138:     case "woff":
139:       return "woff";
140:     case "embedded-opentype":
141:     case "eot":
142:       return "embedded-opentype";
143:     default:
144:       return null;
145:   }
146: }
147: function formatFromExtension(uri: string): FontFormat | null {
148:   const path = uri.split("?")[0].toLowerCase();
149:   if (path.endsWith(".ttf")) return "truetype";
150:   if (path.endsWith(".otf")) return "opentype";
151:   if (path.endsWith(".woff2")) return "woff2";
152:   if (path.endsWith(".woff")) return "woff";
153:   if (path.endsWith(".eot")) return "embedded-opentype";
154:   return null;
155: }
156: const CATEGORIES = new Set<string>([
157:   "Sans Serif",
158:   "Serif",
159:   "Display",
160:   "Handwriting",
161:   "Monospace",
162: ]);
163: export function parseFontCatalog(payload: string): FontFamilySummary[] {
164:   const json = payload.replace(JSON_GUARD, "").trim();
165:   let parsed: any;
166:   try {
167:     parsed = JSON.parse(json);
168:   } catch {
169:     throw new Error("Google Fonts returned an unreadable catalog");
170:   }
171:   const list = parsed?.familyMetadataList;
172:   if (!Array.isArray(list)) {
173:     throw new Error("Google Fonts returned an unreadable catalog");
174:   }
175:   const families: FontFamilySummary[] = [];
176:   list.forEach((entry: any, index: number) => {
177:     const family = typeof entry?.family === "string" ? entry.family.trim() : "";
178:     if (!family) return;
179:     families.push({
180:       family,
181:       category: CATEGORIES.has(entry?.category)
182:         ? (entry.category as FontCategory)
183:         : "Sans Serif",
184:       popularity:
185:         typeof entry?.popularity === "number" ? entry.popularity : index + 1,
186:       designers: Array.isArray(entry?.designers)
187:         ? entry.designers.filter((d: unknown) => typeof d === "string")
188:         : [],
189:       axes: Array.isArray(entry?.axes)
190:         ? entry.axes
191:             .map((axis: any) => axis?.tag)
192:             .filter((tag: unknown): tag is string => typeof tag === "string")
193:         : [],
194:     });
195:   });
196:   return families;
197: }
</file>

