461: export function extractReasoning(message: any): string | undefined {
462:   const direct = message?.reasoning;
463:   if (typeof direct === "string" && direct.trim()) return direct.trim();
464:   const details = message?.reasoning_details;
465:   if (!Array.isArray(details)) return undefined;
466:   const parts: string[] = [];
467:   for (const detail of details) {
468:     const text = detail?.text ?? detail?.summary;
469:     if (typeof text === "string" && text.trim()) parts.push(text.trim());
470:   }
471:   const joined = parts.join("\n\n").trim();
472:   return joined ? joined : undefined;
473: }
474: export function extractWebCitations(message: any): WebCitation[] {
