156: /**
157:  * Holds the session's state and broadcasts changes.
158:  *
159:  * @typeParam TSnapshot The render-ready view model listeners receive; the owner supplies
160:  * a projector so the store never has to know how the view model is composed.
161:  */
162: export class AppSessionStore<TSnapshot> {
163:   readonly domain: DomainState = createInitialDomainState();
164:   readonly ui: UiState = createInitialUiState();
165:   private readonly listeners = new Set<(snapshot: TSnapshot) => void>();
166:   constructor(private readonly project: () => TSnapshot) {}
167:   subscribe(listener: (snapshot: TSnapshot) => void): () => void {
168:     this.listeners.add(listener);
169:     listener(this.project());
170:     return () => {
171:       this.listeners.delete(listener);
172:     };
173:   }
174:   /** Projects once and hands the same snapshot to every listener. */
175:   emit(): void {
176:     const snapshot = this.project();
177:     for (const listener of this.listeners) {
178:       listener(snapshot);
179:     }
180:   }
181:   /** Shows a transient message, which clears itself unless something newer replaced it. */
182:   showToast(message: string): void {
183:     this.ui.toastMessage = message;
184:     this.emit();
185:     setTimeout(() => {
186:       if (this.ui.toastMessage === message) {
187:         this.ui.toastMessage = "";
188:         this.emit();
189:       }
190:     }, TOAST_DURATION_MS);
191:   }
192:   select(cardIds: Iterable<string>): void {
193:     this.domain.selection = new Set(cardIds);
194:   }
195:   forgetCards(removedCardIds: Iterable<string>): void {
196:     const removed = new Set(removedCardIds);
197:     if (removed.size === 0) return;
198:     this.domain.selection = new Set(
199:       [...this.domain.selection].filter((id) => !removed.has(id)),
200:     );
201:     if (this.ui.openCardId && removed.has(this.ui.openCardId)) {
202:       this.ui.openCardId = null;
203:     }
204:     if (this.domain.currentGroupId && removed.has(this.domain.currentGroupId)) {
205:       this.domain.currentGroupId = null;
