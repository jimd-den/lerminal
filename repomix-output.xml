1091:       case "preflight":
1092:         this.operations.dismissResult();
1093:         this.openPreflight(dispatch.presetId);
1094:         return;
1095:       case "pipeline":
1096:         this.operations.dismissResult();
1097:         this.emit();
1098:         await this.runPipeline(dispatch.text);
1099:         return;
1100:       case "mission":
1101:         this.operations.dismissResult();
1102:         this.openMissionEditor();
1103:         return;
1104:       case "palette":
1105:         this.operations.dismissResult();
1106:         this.setModalOpen(true);
1107:         return;
