 42:             document.source?.id ??
 43:               document.materials.find((card) => card.type === "note")?.id,
 44:           ].filter((id): id is string => !!id)
 45:         : (document.learningCards.length > 0
 46:             ? document.learningCards
 47:             : [document.source].filter((card): card is Card => !!card)
 48:           ).map((card) => card.id);
