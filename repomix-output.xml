 555:           model: () => this.domain.selectedModel,
 556:           onChange: () => this.emit(),
 557:           notify: (message) => this.showToast(message),
 558:           onWorkspaceSaved: (workspace) => {
 559:             this.domain.workspaces = this.domain.workspaces.map((w) =>
 560:               w.id === workspace.id ? workspace : w,
 561:             );
 562:           },
 563:           openStatusReportPreflight: (prompt) => {
 564:             this.ui.activePreflightPresetId = "status-report";
 565:             this.ui.preflightQuery = prompt;
 566:             this.emit();
 567:           },
 568:           onSyllabusCreated: async ({ group, items, workspaceId }) => {
 569:             if (this.domain.activeWorkspaceId === workspaceId) {
 570:               await this.loadCardsForActiveWorkspace();
 571:               this.domain.selection = new Set(items.map((card) => card.id));
