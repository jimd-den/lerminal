287: export function resolveAssistantProfile(
288:   capability: AssistantCapability,
289:   activeProfileIds: Partial<Record<AssistantCapability, string>> = {},
290:   customProfiles: AssistantProfile[] = [],
291:   builtinProfiles: AssistantProfile[] = BUILTIN_ASSISTANT_PROFILES,
292:   targetProfileIdOrName?: string,
293:   activeWorkspaceId?: string
294: ): AssistantProfile {
295:   const visibleCustom = customProfiles.filter(
296:     (p) => resolveProfileScope(p) !== "workspace" || p.workspaceId === activeWorkspaceId
297:   );
298:   const allProfiles = [...visibleCustom, ...builtinProfiles];
299:   const customProfilesInScope = visibleCustom;
300:   if (targetProfileIdOrName) {
301:     const targetKey = targetProfileIdOrName.trim().toLowerCase();
302:     const found = allProfiles.find(
303:       (p) => p.id.toLowerCase() === targetKey || p.name.toLowerCase() === targetKey
304:     );
305:     if (found) return found;
306:   }
307:   const activeId = activeProfileIds[capability];
308:   if (activeId) {
309:     const found = allProfiles.find((p) => p.id === activeId);
310:     if (found) return found;
311:   }
312:   const matchingCustom = customProfilesInScope.find((p) => p.capability === capability);
313:   if (matchingCustom) return matchingCustom;
314:   const matchingBuiltin = builtinProfiles.find((p) => p.capability === capability);
315:   if (matchingBuiltin) return matchingBuiltin;
316:   return BUILTIN_ASSISTANT_PROFILES[0];
317: }
