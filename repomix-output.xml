<file path="src/usecases/pipeline/__tests__/runOutcome.test.ts">
 1: import { describe, expect, it } from "bun:test";
 2: import {
 3:   commandNameOf,
 4:   commonParentId,
 5:   describeRunOutput,
 6:   shouldAutoGroup,
 7:   wasGeneratedTogether,
 8: } from "../runOutcome";
 9: import { Card, createCard } from "../../../entities/card";
10: const START = 1_800_000_000_000;
11: const made = (
12:   id: string,
13:   options: { parentId?: string; createdAt?: number; type?: Card["type"] } = {},
14: ): Card => ({
15:   ...createCard({
16:     workspaceId: "w1",
17:     type: options.type ?? "note",
18:     title: id,
19:     body: "b",
20:     parentId: options.parentId,
21:   }),
22:   id,
23:   createdAt: options.createdAt ?? START + 1,
24: });
25: describe("commonParentId", () => {
26:   it("reports the shared parent", () => {
27:     expect(commonParentId([made("a", { parentId: "g1" }), made("b", { parentId: "g1" })])).toBe(
28:       "g1",
29:     );
30:   });
31:   it("reports nothing when the cards landed in different places", () => {
32:     expect(
33:       commonParentId([made("a", { parentId: "g1" }), made("b", { parentId: "g2" })]),
34:     ).toBeUndefined();
35:   });
36:   it("reports nothing for root-level cards or an empty result", () => {
37:     expect(commonParentId([made("a")])).toBeUndefined();
38:     expect(commonParentId([])).toBeUndefined();
39:   });
40: });
41: describe("wasGeneratedTogether", () => {
42:   it("is true when every card postdates the run's start", () => {
43:     expect(wasGeneratedTogether([made("a"), made("b")], START)).toBe(true);
44:   });
45:   it("is false when a card predates the run — it was passed through, not made", () => {
46:     expect(
47:       wasGeneratedTogether([made("a"), made("old", { createdAt: START - 5000 })], START),
48:     ).toBe(false);
49:   });
50: });
51: describe("shouldAutoGroup", () => {
52:   const decide = (cards: Card[], autoGroupEnabled = true) =>
53:     shouldAutoGroup({ cards, startedAt: START, autoGroupEnabled });
54:   it("groups a single created card, not just multi-card results", () => {
55:     expect(decide([made("a")])).toBe(true);
56:   });
57:   it("does not group when the user turned auto-grouping off", () => {
58:     expect(decide([made("a"), made("b")], false)).toBe(false);
59:   });
60:   it("does not group an empty result", () => {
61:     expect(decide([])).toBe(false);
62:   });
63:   it("does not group cards the run merely passed through", () => {
64:     expect(decide([made("existing", { createdAt: START - 1000 })])).toBe(false);
65:   });
66:   it("does not group output that landed in different places", () => {
67:     expect(decide([made("a", { parentId: "g1" }), made("b", { parentId: "g2" })])).toBe(
68:       false,
69:     );
70:   });
71: });
72: describe("commandNameOf", () => {
73:   it("takes the leading command of a pipeline", () => {
74:     expect(commandNameOf("chunk | recall | space")).toBe("chunk");
75:     expect(commandNameOf('  ask "React hooks"')).toBe("ask");
76:     expect(commandNameOf("status-report")).toBe("status-report");
77:   });
78:   it("falls back to a neutral label when there is nothing to read", () => {
79:     expect(commandNameOf("   ")).toBe("command");
80:   });
81: });
82: describe("describeRunOutput", () => {
83:   it("names chunks as study chunks and everything else as items", () => {
84:     expect(describeRunOutput([made("a", { type: "chunk" })])).toBe("1 study chunk created");
85:     expect(describeRunOutput([made("a"), made("b")])).toBe("2 items created");
86:   });
87:   it("stops calling a mixed result chunks", () => {
88:     expect(describeRunOutput([made("a", { type: "chunk" }), made("b")])).toBe(
89:       "2 items created",
