 5: import { CommandContext, CommandResult, PipelineCommand } from "./Command";
 6: export class SourceCommand implements PipelineCommand {
 7:   readonly name = "source";
 8:   constructor(
 9:     private readonly cardRepo: CardRepository,
10:     private readonly extractionGateway?: ExtractionGateway,
11:     private readonly logger: Logger = silentLogger
12:   ) {}
13:   async execute(arg: string, ctx: CommandContext): Promise<CommandResult> {
14:     if (!arg) {
15:       return { kind: "needsInput", mode: "source" };
16:     }
17:     const isUrl = /^https?:\/\//i.test(arg.trim());
18:     if (isUrl) {
19:       const url = arg.trim();
20:       const derivedTitle = url
21:         .replace(/^https?:\/\/(www\.)?/, "")
22:         .split("/")
23:         .pop()
24:         ?.replace(/[-_]/g, " ") || url;
25:       let extractedBody = url;
26:       if (this.extractionGateway) {
27:         try {
28:           extractedBody = await this.extractionGateway.extractText(url);
29:         } catch (err: any) {
30:           // The card is still created, but holds the URL rather than its text — the user
31:           // should be able to find out why what they saved looks thinner than expected.
32:           this.logger.warn("source.extractionFailed.fallbackToUrl", {
33:             reason: err.message,
34:           });
35:           extractedBody = `Extraction failed for ${url}: ${err.message}`;
36:         }
37:       }
38:       const sourceCard = createCard({
39:         workspaceId: ctx.workspaceId,
40:         type: "source",
41:         title: derivedTitle,
42:         body: extractedBody,
43:         cite: url,
44:         parentId: ctx.parentId ?? undefined,
45:       });
46:       await this.cardRepo.saveCard(sourceCard);
47:       return { kind: "cards", cards: [sourceCard] };
48:     }
49:     const textContent = arg.trim();
50:     const title = textContent.substring(0, 40);
51:     const sourceCard = createCard({
52:       workspaceId: ctx.workspaceId,
53:       type: "source",
54:       title,
55:       body: textContent,
56:       cite: "user source",
57:       parentId: ctx.parentId ?? undefined,
58:     });
59:     await this.cardRepo.saveCard(sourceCard);
60:     return { kind: "cards", cards: [sourceCard] };
