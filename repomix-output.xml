 1: import type { OutputContractKind } from "./assistantProfile";
 2: export const RESPONSE_FORMAT_PROMPT = `OUTPUT FORMAT (STRICT — this overrides any conflicting instruction above):
 3: Respond ONLY with a valid JSON array of objects. Output nothing else — no prose, no explanation, no markdown, no code fences, nothing before or after the array.
 4: Each object MUST have exactly these keys:
 5: - "title": string — a specific, descriptive heading (max 8 words; never a generic label like "Card 1")
 6: - "body": string — the card's content as plain text or light markdown
 7: For every non-empty query, return at least one useful card. Return [] only when both the query and source context are empty.`;
 8: export const CHUNK_RESPONSE_FORMAT_PROMPT = `OUTPUT FORMAT (STRICT — this overrides any conflicting instruction above):
 9: Respond ONLY with a valid JSON array of objects. Output nothing else — no prose, no explanation, no markdown, no code fences, nothing before or after the array.
10: Each object MUST have exactly these keys:
11: - "title": string — a specific, descriptive heading for this chunk (max 8 words)
12: - "body": string — a clear, self-contained explanation of this chunk as plain text or light markdown
13: - "sourceCardId": string — the exact id of the source card this chunk was drawn from
14: - "sourceExcerpt": string — a short supporting quote copied from that source card
15: For every non-empty query, return at least one useful chunk. Return [] only when both the query and source context are empty.`;
16: const FORMAT_PROMPTS_BY_CONTRACT: Record<OutputContractKind, string> = {
17:   "cards-v1": RESPONSE_FORMAT_PROMPT,
18:   "chunks-v1": CHUNK_RESPONSE_FORMAT_PROMPT,
19:   "cloze-v1": RESPONSE_FORMAT_PROMPT,
20:   "conversation-v1": "",
21: };
22: /** Default instruction for a direct single-answer card (the `ask` flow). */
23: export const DEFAULT_CARD_INSTRUCTION = `You are a precise, knowledgeable tutor. Answer the user's query directly and accurately in a single card. Name the key idea in the title, then in the body explain it clearly and state why it matters or give a concrete example. When source context is provided, ground the answer strictly in it. Never invent facts.`;
24: /** Default instruction for breaking material into a sequence of cards (the `ask`/`chunk` agent flow). */
25: export const DEFAULT_CHUNK_INSTRUCTION = `You are an expert learning designer. Break the provided material into the smallest set of distinct, self-contained, recall-ready cards — one idea per card, ordered so earlier cards scaffold later ones. For each idea: state it precisely, give the reason or mechanism behind it, and add a concrete example or contrast where it aids memory. Cover the material faithfully without inventing facts; prefer fewer, sharper cards over many vague ones.`;
26: /**
27:  * Combines a custom/preset instruction with the strict format contract for the given
28:  * output kind (defaults to `cards-v1`, the plain generate/ask shape). The instruction
29:  * leads (it's what the model should do); the format contract trails and is marked as
30:  * overriding, so format compliance is guaranteed regardless of the instruction, and each
31:  * capability's own contract (e.g. `chunks-v1`'s provenance fields) is never dropped in
32:  * favor of the generic card shape.
33:  */
34: export function composeCardPrompt(
35:   instruction: string,
36:   contract: OutputContractKind = "cards-v1"
37: ): string {
38:   const trimmed = (instruction || "").trim() || DEFAULT_CARD_INSTRUCTION;
39:   const formatPrompt = FORMAT_PROMPTS_BY_CONTRACT[contract] ?? RESPONSE_FORMAT_PROMPT;
40:   return formatPrompt ? `${trimmed}\n\n${formatPrompt}` : trimmed;
41: }
42: export interface PromptPreset {
43:   /** Unique id. */
44:   id: string;
45:   /** Display name shown in the preset dropdown. */
46:   name: string;
47:   /** The instruction text (no format boilerplate needed — the contract is appended). */
48:   prompt: string;
49:   /** True for seeded presets (cannot be deleted, only used as a starting point). */
50:   builtin: boolean;
51: }
52: /** Seeded presets covering common card styles. Users can add more. */
53: export const BUILTIN_PROMPT_PRESETS: PromptPreset[] = [
54:   { id: "informative", name: "Informative cards", builtin: true, prompt: DEFAULT_CHUNK_INSTRUCTION },
