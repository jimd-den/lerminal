<file path="src/usecases/appearance/InstallFontInteractor.ts">
 1: import { FontGateway } from "../ports/gateways/FontGateway";
 2: import { FontChoice } from "../../entities/appearance";
 3: import { FontFormat, NATIVE_FONT_FORMATS } from "../../entities/fontCatalog";
 4: import { UseCaseError } from "../errors";
 5: export class FontInstallError extends UseCaseError {
 6:   constructor(userMessage: string) {
 7:     super(userMessage);
 8:   }
 9: }
10: export interface FontLoader {
11:   load(family: string, uri: string): Promise<void>;
12: }
13: export class InstallFontInteractor {
14:   constructor(
15:     private readonly fontGateway: FontGateway,
16:     private readonly loader: FontLoader,
17:     private readonly acceptedFormats: FontFormat[] = NATIVE_FONT_FORMATS
18:   ) {}
19:   async execute(family: string): Promise<FontChoice> {
20:     let resolved;
21:     try {
22:       resolved = await this.fontGateway.resolveFont(family, {
23:         acceptedFormats: this.acceptedFormats,
24:       });
25:     } catch (err: any) {
26:       throw new FontInstallError(err?.message ?? "Couldn't find that font");
27:     }
28:     try {
29:       await this.loader.load(resolved.family, resolved.uri);
30:     } catch (err: any) {
31:       throw new FontInstallError(
32:         `Downloaded "${resolved.family}" but couldn't load it: ${err?.message ?? "unknown error"}`
33:       );
34:     }
35:     return {
36:       family: resolved.family,
37:       source: "google",
38:       uri: resolved.uri,
39:       format: resolved.format,
40:     };
41:   }
42: }
43: export async function reloadInstalledFonts(
44:   fonts: FontChoice[],
45:   loader: FontLoader
46: ): Promise<FontChoice[]> {
47:   const loaded: FontChoice[] = [];
48:   for (const font of fonts) {
49:     if (font.source !== "google" || !font.uri) continue;
50:     try {
51:       await loader.load(font.family, font.uri);
52:       loaded.push(font);
53:     } catch {
54:     }
55:   }
56:   return loaded;
57: }
</file>

