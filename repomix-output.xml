 631:   async init(): Promise<void> {
 632:     try {
 633:       this.ui.storageError = null;
 634:       this.domain.workspaces = await this.workspaceRepo.getWorkspaces();
 635:       const settings = await this.settingsRepo.getSettings();
 636:       if (settings) {
 637:         this.domain.theme = settings.theme || "dark";
 638:         this.domain.accent = settings.accent || "teal";
 639:         this.domain.appearance = settings.appearance ?? {};
 640:         this.domain.openRouterKey = settings.openRouterKey || "";
 641:         this.domain.selectedModel = settings.selectedModel || "";
 642:         this.domain.customSystemPrompt =
 643:           settings.customSystemPrompt || DEFAULT_SYSTEM_PROMPT;
 644:         this.domain.customChunkSystemPrompt =
 645:           settings.customChunkSystemPrompt || DEFAULT_CHUNK_SYSTEM_PROMPT;
 646:         this.domain.autoGroupByCommand = settings.autoGroupByCommand ?? true;
 647:         this.domain.interleaveReviews = settings.interleaveReviews ?? true;
 648:         if (settings.activeProfileIds) {
 649:           this.domain.activeProfileIds = {
 650:             ...this.domain.activeProfileIds,
 651:             ...settings.activeProfileIds,
 652:           } as Partial<Record<AssistantCapability, string>>;
 653:         }
 654:         if (settings.searchSiteFlags) {
 655:           this.domain.searchSiteFlags = settings.searchSiteFlags;
 656:         }
 657:       } else {
 658:         this.domain.customSystemPrompt = DEFAULT_SYSTEM_PROMPT;
 659:         this.domain.customChunkSystemPrompt = DEFAULT_CHUNK_SYSTEM_PROMPT;
 660:       }
 661:       this.domain.commandDefinitions =
 662:         await this.commandDefinitionRepo.getDefinitions();
 663:       this.domain.cardTypes = await this.loadCardTypes();
 664:       this.domain.promptPresets = await this.loadPromptPresets();
 665:       this.domain.assistantProfiles = await this.loadAssistantProfiles();
 666:       this.rebuildPipeline();
 667:       // Captured before the default workspace is created, so "nothing here yet" is
 668:       const isFirstLaunch = this.domain.workspaces.length === 0;
 669:       if (isFirstLaunch) {
 670:         const defaultWs =
 671:           await this.createWorkspaceInteractor.execute("My Workspace");
 672:         this.domain.workspaces.push(defaultWs);
 673:         this.domain.activeWorkspaceId = defaultWs.id;
 674:       } else {
 675:         this.domain.activeWorkspaceId = this.domain.workspaces[0].id;
 676:       }
 677:       await this.loadCardsForActiveWorkspace();
 678:       if (isFirstLaunch && this.domain.cards.length === 0) {
 679:         this.openGoalArchitect();
 680:         this.goalArchitect.markFirstRun();
 681:       }
 682:       this.loadAvailableModels();
 683:       void this.restoreInstalledFonts();
 684:       this.emit();
 685:       this.logger.debug("controller.init.success");
 686:     } catch (error) {
 687:       this.logger.error("controller.init.failed", error);
 688:       this.ui.storageError = isPersistenceError(error)
 689:         ? "Your saved work could not be opened. Nothing has been changed."
 690:         : null;
 691:       this.showToast(
 692:         this.ui.storageError ? "Could not open your library" : "Initialization failed",
 693:       );
 694:       this.emit();
 695:     }
 696:   }
