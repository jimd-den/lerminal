147: function formatFromExtension(uri: string): FontFormat | null {
148:   const path = uri.split("?")[0].toLowerCase();
149:   if (path.endsWith(".ttf")) return "truetype";
150:   if (path.endsWith(".otf")) return "opentype";
151:   if (path.endsWith(".woff2")) return "woff2";
152:   if (path.endsWith(".woff")) return "woff";
153:   if (path.endsWith(".eot")) return "embedded-opentype";
