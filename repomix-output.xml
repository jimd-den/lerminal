 995:   private async restoreInstalledFonts(): Promise<void> {
 996:     const installed = this.domain.appearance.installedFonts ?? [];
 997:     if (installed.length === 0) return;
 998:     const loaded = await reloadInstalledFonts(installed, this.fontLoader);
 999:     if (loaded.length === installed.length) return;
1000:     const survivors = new Set(loaded.map(font => font.family));
1001:     const stillValid = (font: FontChoice | undefined) =>
1002:       font && (font.source === "system" || survivors.has(font.family)) ? font : undefined;
1003:     this.domain.appearance = {
1004:       ...this.domain.appearance,
1005:       installedFonts: loaded,
1006:       monoFont: stillValid(this.domain.appearance.monoFont),
1007:       sansFont: stillValid(this.domain.appearance.sansFont),
1008:     };
1009:     await this.saveCurrentSettings();
1010:     this.emit();
1011:   }
