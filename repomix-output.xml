1412:           finalParentId = group.id;
1413:         }
1414:       }
1415:       this.domain.selection = new Set([card.id]);
1416:       await this.loadCardsForActiveWorkspace();
1417:       this.removePendingOperation(opId);
1418:       this.showToast(
1419:         finalParentId ? "Extracted to related group" : "Extracted to new card",
1420:       );
1421:       this.logger.debug("url.extracted", { cardId: card.id });
