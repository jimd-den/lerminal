40:     id: params.id || Math.random().toString(36).substring(2, 10),
41:     commandName: params.commandName,
42:     workspaceId: params.workspaceId,
43:     parentId: params.parentId,
44:     inputCardIds: params.inputCardIds ?? [],
45:     createdCardIds: params.createdCardIds ?? [],
46:     createdCardSnapshots: params.createdCardSnapshots,
47:     updatedCardSnapshots: params.updatedCardSnapshots,
48:     deletedCardSnapshots: params.deletedCardSnapshots,
49:     webUsed: params.webUsed ?? false,
50:     searchQuery: params.searchQuery,
51:     model: params.model,
52:     usedLocalFallback: params.usedLocalFallback,
53:     startedAt: params.startedAt,
54:     completedAt: params.completedAt ?? Date.now(),
55:     summary: params.summary,
56:   };
57: }
58: function cardContentSignature(card: Card): string {
59:   return JSON.stringify({
60:     title: card.title,
61:     body: card.body,
62:     answer: card.answer,
63:     fields: card.fields,
64:     parentId: card.parentId,
65:   });
66: }
67: export function canUndoCreate(record: OperationRecord, currentCards: Card[]): boolean {
68:   if (record.createdCardIds.length === 0) return false;
69:   if (!record.createdCardSnapshots || record.createdCardSnapshots.length !== record.createdCardIds.length) {
70:     return false;
71:   }
72:   const currentById = new Map(currentCards.map(c => [c.id, c]));
73:   const snapshotById = new Map(record.createdCardSnapshots.map(c => [c.id, c]));
74:   return record.createdCardIds.every(id => {
75:     const current = currentById.get(id);
76:     const snapshot = snapshotById.get(id);
77:     if (!current || !snapshot) return false;
78:     return cardContentSignature(current) === cardContentSignature(snapshot);
79:   });
80: }
