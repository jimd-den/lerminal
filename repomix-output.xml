1796:   async suggestSearchQueries(topic: string): Promise<void> {
1797:     const trimmed = topic.trim();
1798:     if (!trimmed) {
1799:       this.showToast("Type a topic first, then suggest queries");
1800:       return;
1801:     }
1802:     if (!this.domain.openRouterKey?.trim()) {
1803:       this.showToast("Add your OpenRouter key in Settings");
1804:       return;
1805:     }
1806:     this.ui.isSuggestingQueries = true;
1807:     this.emit();
1808:     try {
1809:       const queries = await this.suggestSearchQueriesInteractor.execute({
1810:         topic: trimmed,
1811:         mission: this.activeWorkspace()?.mission,
1812:         apiKey: this.domain.openRouterKey,
1813:         model: this.domain.selectedModel,
1814:       });
1815:       this.ui.aiQuerySuggestions = queries;
1816:     } catch (err: any) {
1817:       this.showToast(
1818:         err instanceof UseCaseError ? err.userMessage : "Could not suggest queries",
1819:       );
1820:     } finally {
1821:       this.ui.isSuggestingQueries = false;
1822:       this.emit();
1823:     }
1824:   }
