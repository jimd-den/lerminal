 42: const receipt = (): OperationResult => ({
 43:   summary: "2 items created",
 44:   createdCardIds: ["a", "b"],
 45:   destination: { spaceId: "w1" },
 46:   primaryActionLabel: "Open result",
 47: });
 48: describe("OperationsWorkflow", () => {
 49:   let host: RecordingHost;
 50:   let cardRepo: MemoryCardRepository;
 51:   let operationLog: MemoryOperationLogRepository;
 52:   let workflow: OperationsWorkflow;
 53:   let nextId: number;
 54:   beforeEach(() => {
 55:     host = new RecordingHost();
 56:     cardRepo = new MemoryCardRepository();
 57:     operationLog = new MemoryOperationLogRepository();
 58:     nextId = 0;
 59:     workflow = new OperationsWorkflow({
 60:       operationLog,
 61:       undoOperation: new UndoOperationInteractor(cardRepo, operationLog),
 62:       host,
 63:       generateId: () => `op-${++nextId}`,
 64:     });
 65:   });
 66:   const runAndRecord = async (): Promise<string> => {
 67:     const created = [
 68:       createCard({ workspaceId: "w1", type: "note", title: "One", body: "b" }),
 69:       createCard({ workspaceId: "w1", type: "note", title: "Two", body: "b" }),
 70:     ];
 71:     await cardRepo.saveCards(created);
 72:     host.cardList = [...created];
 73:     return workflow.recordCompletedRun({
 74:       commandName: "chunk",
 75:       workspaceId: "w1",
 76:       inputCardIds: [],
 77:       createdCards: created,
 78:       startedAt: Date.now() - 100,
 79:       summary: "2 items created",
 80:     });
 81:   };
 82:   describe("in-flight work", () => {
 83:     it("tracks a run from start to finish", () => {
 84:       const id = workflow.begin("chunk");
 85:       expect(workflow.state.pending).toHaveLength(1);
 86:       expect(workflow.state.pending[0]).toMatchObject({
 87:         commandName: "chunk",
 88:         status: "loading",
 89:         workspaceId: "w1",
 90:       });
 91:       workflow.end(id);
 92:       expect(workflow.state.pending).toEqual([]);
 93:     });
 94:     it("keeps a failed run on screen with the retry scope it originally had", () => {
 95:       const id = workflow.begin("chunk", {
 96:         pipelineText: "chunk",
 97:         inputCardIds: ["c1"],
 98:         parentId: "g1",
 99:       });
100:       workflow.fail(id, "Model unavailable");
101:       expect(workflow.find(id)).toMatchObject({
102:         status: "error",
103:         errorMessage: "Model unavailable",
104:         pipelineText: "chunk",
105:         inputCardIds: ["c1"],
106:         parentId: "g1",
107:       });
108:     });
109:     it("tracks concurrent runs independently", () => {
110:       const first = workflow.begin("chunk");
111:       const second = workflow.begin("ask");
112:       workflow.fail(first, "boom");
113:       expect(workflow.find(second)?.status).toBe("loading");
114:       workflow.end(second);
115:       expect(workflow.state.pending.map((op) => op.id)).toEqual([first]);
116:     });
117:   });
118:   describe("receipts", () => {
119:     it("publishes and dismisses a receipt", () => {
120:       workflow.present(receipt());
121:       expect(workflow.state.result?.summary).toBe("2 items created");
122:       workflow.dismissResult();
123:       expect(workflow.state.result).toBeNull();
124:     });
125:     it("navigates to the result and clears the receipt", async () => {
126:       workflow.present(receipt());
127:       await workflow.openResult();
128:       expect(host.navigations).toHaveLength(1);
129:       expect(workflow.state.result).toBeNull();
130:     });
131:     it("does nothing when there is no receipt to open", async () => {
132:       await workflow.openResult();
133:       expect(host.navigations).toEqual([]);
134:     });
135:   });
136:   describe("undo", () => {
