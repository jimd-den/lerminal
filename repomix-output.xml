 540: export function PendingInputModal({
 541:   controller,
 542:   state,
 543:   theme,
 544:   onPipelineComplete,
 545:   onCancel,
 546: }: {
 547:   controller: GriotController;
 548:   state: AppState;
 549:   theme: GriotTheme;
 550:   onPipelineComplete?: () => void;
 551:   onCancel?: () => void;
 552: }) {
 553:   const [value, setValue] = useState("");
 554:   const [flags, setFlags] = useState<string[]>([]);
 555:   const [submitting, setSubmitting] = useState(false);
 556:   useEffect(() => {
 557:     if (state.isInputSheetOpen) {
 558:       setValue("");
 559:       setFlags([]);
 560:       setSubmitting(false);
 561:     }
 562:   }, [state.isInputSheetOpen, state.pendingCommandName]);
 563:   const command =
 564:     state.pendingCommandName ||
 565:     (state.inputSheetMode === "ask"
 566:       ? "ask"
 567:       : state.inputSheetMode === "note"
 568:         ? "note"
 569:         : "source");
 570:   const submit = async () => {
 571:     if (!value.trim() || submitting) return;
 572:     setSubmitting(true);
 573:     try {
 574:       if (state.inputSheetMode === "note") {
 575:         await controller.createNote({ content: value });
 576:         controller.setInputSheetOpen(false);
 577:         onPipelineComplete?.();
 578:       } else {
 579:         const succeeded = await controller.submitPendingPipelineInput(value, flags);
 580:         if (succeeded) onPipelineComplete?.();
 581:       }
 582:     } finally {
 583:       setSubmitting(false);
 584:     }
 585:   };
 586:   const cancel = () => {
 587:     if (submitting) return;
 588:     controller.setInputSheetOpen(false);
 589:     onCancel?.();
 590:   };
 591:   return (
 592:     <Modal
 593:       visible={state.isInputSheetOpen}
 594:       transparent
 595:       animationType="fade"
 596:       onRequestClose={cancel}
 597:     >
 598:       <KeyboardAvoidingView
 599:         style={styles.scrim}
 600:         behavior={Platform.OS === "ios" ? "padding" : undefined}
 601:       >
 602:         <View
 603:           style={[
 604:             styles.inputSheet,
 605:             { backgroundColor: theme.panelStrong, borderColor: theme.accent },
 606:           ]}
 607:         >
 608:           <Text
 609:             style={[
 610:               styles.status,
 611:               { color: theme.accent, fontFamily: theme.fontMono },
 612:             ]}
 613:           >
 614:             {command.toUpperCase()}
 615:           </Text>
 616:           {command === "search" ? (
 617:             <View style={styles.chips}>
 618:               {Object.keys(state.searchSiteFlags).map((flag) => (
 619:                 <Pressable
 620:                   key={flag}
 621:                   disabled={submitting}
 622:                   onPress={() =>
 623:                     setFlags((current) =>
 624:                       current.includes(flag)
 625:                         ? current.filter((item) => item !== flag)
 626:                         : [...current, flag],
 627:                     )
 628:                   }
 629:                   style={[
 630:                     styles.chip,
 631:                     {
 632:                       borderColor: flags.includes(flag)
 633:                         ? theme.accent
 634:                         : theme.line,
 635:                       backgroundColor: flags.includes(flag)
 636:                         ? theme.accentSoft
 637:                         : theme.panelMuted,
 638:                     },
 639:                   ]}
 640:                 >
 641:                   <Text
 642:                     style={[
 643:                       styles.chipText,
 644:                       {
 645:                         color: flags.includes(flag)
 646:                           ? theme.accent
 647:                           : theme.textMuted,
 648:                         fontFamily: theme.fontMono,
 649:                       },
 650:                     ]}
 651:                   >
 652:                     --{flag}
 653:                   </Text>
 654:                 </Pressable>
 655:               ))}
 656:             </View>
 657:           ) : null}
 658:           <TextInput
 659:             autoFocus
 660:             multiline
 661:             editable={!submitting}
 662:             value={value}
 663:             onChangeText={setValue}
 664:             placeholder="Enter input..."
 665:             placeholderTextColor={theme.textFaint}
 666:             style={[
 667:               styles.pendingInput,
 668:               {
 669:                 color: theme.text,
 670:                 borderColor: theme.line,
 671:                 fontFamily: theme.fontMono,
 672:               },
 673:             ]}
 674:           />
 675:           <View style={styles.footerRow}>
 676:             <Pressable
 677:               disabled={submitting}
 678:               onPress={cancel}
 679:               style={[styles.sheetButton, { borderColor: theme.line }]}
 680:             >
 681:               <Text
 682:                 style={[
 683:                   styles.sheetButtonText,
 684:                   { color: theme.text, fontFamily: theme.fontMono },
 685:                 ]}
 686:               >
 687:                 CANCEL
 688:               </Text>
 689:             </Pressable>
 690:             <Pressable
 691:               disabled={!value.trim() || submitting}
 692:               onPress={() => void submit()}
 693:               style={[
 694:                 styles.sheetButton,
