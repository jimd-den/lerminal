<file path="src/usecases/undo/UndoOperationInteractor.ts">
 1: import { Card } from "../../entities/card";
 2: import { OperationRecord, canUndoCreate } from "../../entities/operationLog";
 3: import { CardRepository } from "../ports/repositories/CardRepository";
 4: import { OperationLogRepository } from "../ports/repositories/OperationLogRepository";
 5: import { UseCaseError } from "../errors";
 6: export class UndoUnavailableError extends UseCaseError {
 7:   constructor(userMessage: string) {
 8:     super(userMessage);
 9:   }
10: }
11: export interface UndoResult {
12:   removedCardIds: string[];
13:   summary: string;
14: }
15: export class UndoOperationInteractor {
16:   constructor(
17:     private readonly cardRepo: CardRepository,
18:     private readonly operationLog: OperationLogRepository
19:   ) {}
20:   async execute(record: OperationRecord, currentCards: Card[]): Promise<UndoResult> {
21:     const createdCount = record.createdCardIds.length;
22:     if (createdCount === 0) {
23:       throw new UndoUnavailableError("This operation didn't create anything to undo");
24:     }
25:     const byId = new Map(currentCards.map(card => [card.id, card]));
26:     const missing = record.createdCardIds.filter(id => !byId.has(id));
27:     if (missing.length === createdCount) {
28:       await this.operationLog.deleteRecord(record.id);
29:       throw new UndoUnavailableError("These cards are already gone");
30:     }
31:     if (missing.length > 0) {
32:       throw new UndoUnavailableError(
33:         "Some of these cards were already deleted, so undoing the rest would leave this half-reversed"
34:       );
35:     }
36:     if (!canUndoCreate(record, currentCards)) {
37:       throw new UndoUnavailableError(
38:         "You've edited some of these cards since — undoing would discard that work"
39:       );
40:     }
41:     for (const id of record.createdCardIds) {
42:       await this.cardRepo.deleteCard(id);
43:     }
44:     for (const snapshot of record.updatedCardSnapshots ?? []) {
45:       await this.cardRepo.saveCard(snapshot);
46:     }
47:     await this.operationLog.deleteRecord(record.id);
48:     return {
49:       removedCardIds: [...record.createdCardIds],
50:       summary: `Undid ${record.commandName} — removed ${createdCount} card${createdCount === 1 ? "" : "s"}`,
51:     };
52:   }
53: }
</file>

