<file path="src/usecases/agent/AgentScope.ts">
 1: import { Card } from "../../entities/card";
 2: export type AgentScopeKind = "selected-only" | "workspace" | "web" | "selected-plus-web";
 3: export interface ScopeBudget {
 4:   maxCards: number;
 5:   maxCharacters: number;
 6: }
 7: export const DEFAULT_SCOPE_BUDGET: ScopeBudget = { maxCards: 12, maxCharacters: 6000 };
 8: export interface ScopedContext {
 9:   cards: Card[];
10:   truncated: boolean;
11:   totalConsideredCount: number;
12:   totalCharacters: number;
13: }
14: export interface ResolveScopeInput {
15:   scope: AgentScopeKind;
16:   allCards: Card[];
17:   selectedCards: Card[];
18:   parentId: string | null;
19:   budget?: ScopeBudget;
20: }
21: export function resolveScopedContext(input: ResolveScopeInput): ScopedContext {
22:   const budget = input.budget ?? DEFAULT_SCOPE_BUDGET;
23:   if (input.scope === "web") {
24:     return { cards: [], truncated: false, totalConsideredCount: 0, totalCharacters: 0 };
25:   }
26:   const candidates: Card[] = [];
27:   const seen = new Set<string>();
28:   const push = (card: Card) => {
29:     if (seen.has(card.id)) return;
30:     seen.add(card.id);
31:     candidates.push(card);
32:   };
33:   for (const card of input.selectedCards) push(card);
34:   if (input.scope === "workspace" || input.scope === "selected-plus-web") {
35:     const byId = new Map(input.allCards.map(c => [c.id, c]));
36:     let current = input.parentId ? byId.get(input.parentId) : undefined;
37:     while (current) {
38:       push(current);
39:       current = current.parentId ? byId.get(current.parentId) : undefined;
40:     }
41:     const siblings = input.allCards
42:       .filter(c => (c.parentId ?? null) === input.parentId && !seen.has(c.id))
43:       .sort((a, b) => b.createdAt - a.createdAt);
44:     for (const card of siblings) push(card);
45:   }
46:   const totalConsideredCount = candidates.length;
47:   const cardBounded = candidates.slice(0, budget.maxCards);
48:   const cardTruncated = cardBounded.length < candidates.length;
49:   const finalCards: Card[] = [];
50:   let totalCharacters = 0;
51:   let charTruncated = false;
52:   for (const card of cardBounded) {
53:     const len = (card.title?.length ?? 0) + (card.body?.length ?? 0);
54:     if (finalCards.length > 0 && totalCharacters + len > budget.maxCharacters) {
55:       charTruncated = true;
56:       break;
57:     }
58:     finalCards.push(card);
59:     totalCharacters += len;
60:   }
61:   return {
62:     cards: finalCards,
63:     truncated: cardTruncated || charTruncated,
64:     totalConsideredCount,
65:     totalCharacters,
66:   };
67: }
</file>

