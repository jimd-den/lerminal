 60:   "card-generation": {
 61:     id: "card-generation",
 62:     label: "Card generation",
 63:     description:
 64:       "How cards are written when you ask a question or generate from a source: depth, tone, and what belongs in a title versus a body.",
 65:     defaultBody: `You are a precise, knowledgeable tutor. Answer the user's query directly and accurately. Name the key idea in each title, then in the body explain it clearly and state why it matters or give a concrete example. When source context is provided, ground the answer strictly in it. Never invent facts.`,
 66:   },
 67:   "workspace-agent": {
 68:     id: "workspace-agent",
 69:     label: "Workspace agent",
 70:     description:
 71:       'The assistant behind "Ask GRIOT" inside a space. Controls how conversational it is and how readily it proposes actions.',
 72:     defaultBody: `You are GRIOT's assistant inside one workspace of a notes app.
 73: You are given some of the user's cards, numbered, and the conversation so far.
 74: Talk to the user. Answer the question they asked, in a few plain sentences. That is the whole job most of the time.
 75: When your answer contains one specific thing worth keeping — an idea, a question, a link, a name for a set of cards — mark it with a tag as you write it. Mark at most one or two things. Never add a tag to look useful.
 76: You do not do anything. You cannot search, read, save, or change a card. If you are unsure, say so.`,
 77:   },
 78:   "prompt-architect": {
 79:     id: "prompt-architect",
 80:     label: "Prompt architect",
 81:     description:
 82:       "The designer that writes assistant profiles for you. Controls the style of the instructions it drafts.",
 83:     defaultBody: `You are a prompt architect for a study application.
 84: Convert the learner's goal into a concise system instruction for one named assistant capability. Ask at most one clarifying question if needed.
 85: The instruction you write must:
 86: - Define the assistant's role and learning outcome
 87: - State preferred depth, style, and priorities
 88: - Require grounding in supplied material
 89: - Tell the assistant to say when source support is missing`,
 90:   },
 91:   "next-action-suggestion": {
 92:     id: "next-action-suggestion",
 93:     label: "Next-action suggestion",
 94:     description:
 95:       "Picks which of the offered next moves to highlight on a freshly captured card, and why.",
 96:     defaultBody: `You help a learner decide what to do next with a card they just captured. You are choosing from a fixed menu of moves the app already offers — you never invent one. Prefer the move that most advances understanding of what was actually captured, and give a short, concrete reason grounded in the card's content rather than a generic one.`,
 97:   },
 98:   "search-query-suggestion": {
 99:     id: "search-query-suggestion",
100:     label: "Search query suggestions",
101:     description:
102:       "Breaks a broad topic into sharper web search queries before you run a search. Does not itself search anything.",
103:     defaultBody: `You are a search query strategist. Given the user's broad goal or topic, produce 3 to 5 distinct, specific, well-formed web search queries that together cover it from different useful angles (e.g. official documentation, comparisons/alternatives, tutorials or how-tos, common pitfalls or troubleshooting). Put each query itself (not a description of it) in the title field, phrased exactly as someone would type it into a search box. Body should be a one-sentence reason this angle is useful. Do not repeat the same query twice; do not include the words 'search for' in the query text itself.`,
104:   },
105: };
106: export const AGENT_PROMPT_IDS: AgentPromptId[] = [
107:   "workspace-agent",
108:   "card-generation",
109:   "search-query-suggestion",
110:   "next-action-suggestion",
111:   "prompt-architect",
112: ];
113: export function agentPromptDefinition(id: AgentPromptId): PromptDefinition {
114:   return AGENT_PROMPT_DEFINITIONS[id];
115: }
116: export function effectiveAgentPromptBody(
117:   id: AgentPromptId,
118:   overrides?: AgentPromptOverrides
119: ): string {
120:   const override = overrides?.[id];
121:   const trimmed = typeof override === "string" ? override.trim() : "";
122:   return trimmed || AGENT_PROMPT_DEFINITIONS[id].defaultBody;
123: }
124: /**
125:  * The output contract for an id — the part of the prompt the user can never touch.
126:  *
127:  * `card-generation` is the one id whose contract varies: the caller's
128:  * {@link OutputContractKind} decides whether chunk provenance fields are required, so
129:  * the contract travels with the capability rather than being fixed per prompt.
130:  */
131: export function outputContractFor(
132:   id: AgentPromptId,
133:   outputContract?: OutputContractKind
134: ): string {
135:   if (id === "card-generation" && outputContract) {
136:     switch (outputContract) {
137:       case "chunks-v1":
138:         return CHUNK_RESPONSE_FORMAT_PROMPT;
139:       case "conversation-v1":
140:         return "";
141:       default:
142:         return RESPONSE_FORMAT_PROMPT;
143:     }
144:   }
145:   return OUTPUT_CONTRACTS[id];
146: }
147: /**
148:  * Builds the complete system message for one capability.
149:  *
150:  * Order is load-bearing: **parent rules → body → output contract**. The rules frame
151:  * everything the body says, and the contract has the last word, both by position and by
152:  * its explicit "overrides any conflicting instruction above" wording. A body that tries
153:  * to countermand either is sandwiched between them.
154:  *
155:  * @param userBody the user's override, or `undefined`/blank to use the built-in default.
156:  */
157: export function composeSystemPrompt(
158:   id: AgentPromptId,
159:   userBody?: string,
160:   outputContract?: OutputContractKind
161: ): string {
162:   const body = effectiveAgentPromptBody(id, { [id]: userBody });
163:   const contract = outputContractFor(id, outputContract);
164:   return [PARENT_SYSTEM_PROMPT, body, contract].filter(part => part.trim()).join("\n\n");
165: }
</file>

