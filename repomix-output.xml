 16:   initialize(now: number, config: FsrsConfig = DEFAULT_FSRS_CONFIG): ScheduleState {
 17:     const initialStability = Math.max(0.1, this.w[2]);
 18:     const initialDifficulty = Math.min(10, Math.max(1, this.w[3]));
 19:     const state: ScheduleState = {
 20:       algorithm: "fsrs",
 21:       version: 5,
 22:       state: "new",
 23:       dueAt: now + DAY_IN_MS,
 24:       lastReviewAt: undefined,
 25:       stability: initialStability,
 26:       difficulty: initialDifficulty,
 27:       interval: 1,
 28:       scheduledDays: 1,
 29:       reps: 0,
 30:       lapses: 0,
 31:     };
 32:     return state;
 33:   }
 34:   normalizeSchedule(schedule?: ScheduleState, now: number = Date.now()): ScheduleState {
 35:     if (!schedule) {
 36:       return this.initialize(now);
 37:     }
 38:     if (schedule.algorithm === "fsrs" && schedule.stability !== undefined && schedule.difficulty !== undefined) {
 39:       return schedule;
 40:     }
 41:     const interval = Math.max(1, schedule.interval || 1);
 42:     const reps = schedule.reps || 0;
 43:     const lapses = schedule.lapses || 0;
 44:     const stateName: FsrsStateName = reps > 0 ? "review" : "learning";
 45:     return {
 46:       algorithm: "fsrs",
 47:       version: 5,
 48:       state: stateName,
 49:       dueAt: schedule.dueAt || (now + interval * DAY_IN_MS),
 50:       lastReviewAt: schedule.lastReviewAt || (now - interval * DAY_IN_MS),
 51:       stability: interval,
 52:       difficulty: 5.0,
 53:       interval,
 54:       scheduledDays: interval,
 55:       reps,
 56:       lapses,
 57:     };
 58:   }
 59:   preview(
 60:     card: Card,
 61:     now: number = Date.now(),
 62:     config: FsrsConfig = DEFAULT_FSRS_CONFIG
 63:   ): Record<ReviewGrade, ReviewPreview> {
 64:     const grades: ReviewGrade[] = ["again", "hard", "good", "easy"];
 65:     const result = {} as Record<ReviewGrade, ReviewPreview>;
 66:     for (const grade of grades) {
 67:       const outcome = this.calculateReviewOutcome(card, grade, now, config);
 68:       const intervalDays = outcome.schedule.scheduledDays || 1;
 69:       let label: string;
 70:       if (grade === "again" || outcome.schedule.state === "relearning") {
 71:         const stepMin = config.relearningStepsMinutes[0] || 10;
 72:         label = `<${stepMin}m`;
 73:       } else if (intervalDays === 1) {
 74:         label = "1d";
 75:       } else {
 76:         label = `${intervalDays}d`;
 77:       }
 78:       result[grade] = {
 79:         dueAt: outcome.schedule.dueAt,
 80:         intervalDays,
 81:         label,
 82:       };
 83:     }
 84:     return result;
 85:   }
 86:   review(
 87:     card: Card,
 88:     grade: ReviewGrade,
 89:     now: number = Date.now(),
 90:     config: FsrsConfig = DEFAULT_FSRS_CONFIG
 91:   ): { schedule: ScheduleState; log: ReviewLog } {
 92:     const outcome = this.calculateReviewOutcome(card, grade, now, config);
 93:     return outcome;
 94:   }
 95:   private calculateReviewOutcome(
 96:     card: Card,
 97:     grade: ReviewGrade,
 98:     now: number,
 99:     config: FsrsConfig
100:   ): { schedule: ScheduleState; log: ReviewLog } {
101:     const current = this.normalizeSchedule(card.schedule, now);
102:     const prevState = current.state || "new";
103:     const lastReview = current.lastReviewAt || (now - (current.interval * DAY_IN_MS));
104:     const elapsedDays = Math.max(0, (now - lastReview) / DAY_IN_MS);
105:     let nextState: FsrsStateName = "review";
106:     let nextStability = current.stability || 1.0;
107:     let nextDifficulty = current.difficulty || 5.0;
108:     let dueAt = now;
109:     let scheduledDays = 1;
110:     let lapses = current.lapses || 0;
111:     let reps = current.reps;
112:     const gMap: Record<ReviewGrade, number> = { again: 1, hard: 2, good: 3, easy: 4 };
113:     const g = gMap[grade];
114:     if (grade === "again") {
115:       nextState = "relearning";
116:       lapses += 1;
117:       const relearnStepMinutes = config.relearningStepsMinutes[0] || 10;
118:       dueAt = now + (relearnStepMinutes * MINUTE_IN_MS);
119:       scheduledDays = 0;
120:       if (prevState === "new") {
121:         nextStability = this.w[0];
122:       } else {
123:         const R = Math.pow(1 + (elapsedDays / (9 * nextStability)), -1);
124:         nextStability = Math.max(
125:           0.1,
126:           this.w[11] * Math.pow(nextDifficulty, -this.w[12]) * (Math.pow(nextStability + 1, this.w[13]) - 1) * Math.exp(this.w[14] * (1 - R))
127:         );
128:       }
129:     } else {
130:       nextState = "review";
131:       reps += 1;
132:       const d0 = this.w[4] - (g - 3) * this.w[5];
133:       nextDifficulty = Math.min(10, Math.max(1, (this.w[6] * nextDifficulty) + ((1 - this.w[6]) * d0)));
134:       if (prevState === "new") {
135:         nextStability = this.w[g - 1];
136:       } else {
137:         const R = Math.pow(1 + (elapsedDays / (9 * nextStability)), -1);
138:         const hardModifier = grade === "hard" ? 0.8 : grade === "easy" ? 1.3 : 1.0;
139:         const sInc = Math.exp(this.w[8]) * (11 - nextDifficulty) * Math.pow(nextStability, -this.w[9]) * (Math.exp(this.w[10] * (1 - R)) - 1);
140:         nextStability = Math.max(0.1, nextStability * (1 + sInc * hardModifier));
141:       }
142:       const targetR = Math.min(0.98, Math.max(0.70, config.desiredRetention));
143:       const rawDays = Math.round(nextStability * (Math.pow(targetR, -1) - 1) / (Math.pow(0.9, -1) - 1));
144:       scheduledDays = Math.min(config.maximumIntervalDays, Math.max(1, rawDays));
145:       dueAt = now + (scheduledDays * DAY_IN_MS);
146:     }
147:     const nextSchedule: ScheduleState = {
148:       algorithm: "fsrs",
149:       version: 5,
150:       state: nextState,
151:       dueAt,
152:       lastReviewAt: now,
153:       stability: Math.round(nextStability * 100) / 100,
154:       difficulty: Math.round(nextDifficulty * 100) / 100,
155:       interval: scheduledDays,
156:       scheduledDays,
157:       reps,
158:       lapses,
159:     };
160:     const log: ReviewLog = {
161:       id: Math.random().toString(36).substring(2, 9),
162:       cardId: card.id,
163:       workspaceId: card.workspaceId,
164:       reviewedAt: now,
165:       grade,
166:       previousState: prevState,
167:       nextState,
168:       scheduledDays,
169:       elapsedDays: Math.round(elapsedDays * 100) / 100,
170:     };
171:     return { schedule: nextSchedule, log };
172:   }
173: }
</file>

