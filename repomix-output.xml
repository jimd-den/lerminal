149:       expect(await workflow.undoLast()).toBe(true);
150:       expect(host.forgotten[0]).toHaveLength(2);
151:       expect(host.refreshes).toBe(1);
152:       expect(await cardRepo.getCardsByWorkspace("w1")).toEqual([]);
153:       expect(workflow.state.undoableOperationId).toBeNull();
154:       expect(workflow.state.result).toBeNull();
155:       expect(host.messages).toHaveLength(1);
156:     });
157:     it("cannot undo the same run twice", async () => {
158:       await runAndRecord();
159:       await workflow.undoLast();
160:       expect(await workflow.undoLast()).toBe(false);
161:     });
162:     it("refuses — leaving everything in place — when a created card was edited", async () => {
163:       await runAndRecord();
