 1: import { createCard } from "../../entities/card";
 2: import { createProvenance } from "../../entities/provenance";
 3: import { resolveAssistantProfile } from "../../entities/assistantProfile";
 4: import { AgentGateway } from "../ports/gateways/AgentGateway";
 5: import { CardRepository } from "../ports/repositories/CardRepository";
 6: import { AgentRequestError } from "../errors";
 7: import { CommandContext, CommandResult, PipelineCommand } from "./Command";
 8: function unquote(value: string): string {
 9:   const quote = value[0];
10:   const isQuoted = (quote === '"' || quote === "'") && value.length >= 2 && value[value.length - 1] === quote;
11:   return isQuoted ? value.slice(1, -1) : value;
12: }
13: export class AskCommand implements PipelineCommand {
14:   readonly name = "ask";
15:   constructor(
16:     private readonly agentGateway: AgentGateway,
17:     private readonly cardRepo: CardRepository
18:   ) {}
19:   async execute(arg: string, ctx: CommandContext): Promise<CommandResult> {
20:     if (!arg || !arg.trim()) {
21:       return { kind: "needsInput", mode: "ask" };
22:     }
23:     let query = arg.trim();
24:     let profileOverride: string | undefined;
25:     const profileMatch = query.match(/^--profile\s+["']?([^"']+)["']?\s+(.*)$/i);
26:     if (profileMatch) {
27:       profileOverride = profileMatch[1];
28:       query = unquote(profileMatch[2].trim());
29:     }
30:     const profile = resolveAssistantProfile(
31:       "generate-cards",
32:       ctx.activeProfileIds,
33:       ctx.assistantProfiles,
34:       undefined,
35:       profileOverride
36:     );
37:     const settingsInstruction = ctx.systemPrompt?.trim();
38:     const systemPrompt = [
39:       profile.systemPrompt,
40:       settingsInstruction
41:         ? `USER-CONFIGURED CARD INSTRUCTION (this has priority for content, depth, and style):\n${settingsInstruction}`
42:         : "",
43:     ]
44:       .filter(Boolean)
45:       .join("\n\n");
46:     let result;
47:     try {
48:       result = await this.agentGateway.ask(
49:         query,
50:         ctx.inputCards,
51:         ctx.apiKey,
52:         ctx.model,
53:         systemPrompt,
54:         profile.outputContract ?? "cards-v1"
55:       );
56:     } catch (err: any) {
57:       throw new AgentRequestError(err?.message);
58:     }
59:     const cards = result.cards.map(item =>
60:       createCard({
61:         workspaceId: ctx.workspaceId,
62:         type: "chunk",
63:         title: item.title,
64:         body: item.body,
65:         cite: query.substring(0, 16),
66:         parentId: ctx.parentId ?? undefined,
67:         provenance: createProvenance({
68:           mode: "agent",
69:           sourceCardIds: ctx.inputCards.map(card => card.id),
70:           assistantProfileId: profile.id,
71:           model: ctx.model,
72:           isLocalFallback: result.isLocalFallback || undefined,
73:         }),
74:       })
75:     );
76:     if (cards.length === 0) {
77:       throw new AgentRequestError("The AI did not generate any cards from this prompt.");
78:     }
79:     await this.cardRepo.saveCards(cards);
80:     return { kind: "cards", cards };
81:   }
82: }
