29:       [FIELD.inputCardIds]: JSON.stringify(params.inputCardIds),
30:       [FIELD.parentId]: params.parentId ?? "",
31:       [FIELD.errorMessage]: params.errorMessage,
32:       [FIELD.failedAt]: String(params.failedAt),
33:     },
