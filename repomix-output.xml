<file path="src/usecases/goal/GoalArchitectWorkflow.ts">
  1: import {
  2:   buildMissionProposal,
  3:   canProposeMission,
  4:   deriveWorkingMap,
  5:   GoalAnswer,
  6:   GoalQuestion,
  7:   GoalQuestionId,
  8:   MissionProposal,
  9:   mergeIntoWorkingMap,
 10:   normalizeGoalArchitectTurn,
 11:   recordAnswer,
 12:   RecommendedResearch,
 13:   selectNextQuestion,
 14:   WorkingMap,
 15:   EMPTY_WORKING_MAP,
 16: } from "../../entities/goalArchitect";
 17: import { AgentGateway } from "../ports/gateways/AgentGateway";
 18: export type GoalArchitectStage =
 19:   | "intent"
 20:   | "proposal";
 21: export interface AgentQuestion {
 22:   prompt: string;
 23:   rationale: string;
 24:   choices?: string[];
 25: }
 26: export interface GoalArchitectState {
 27:   isOpen: boolean;
 28:   stage: GoalArchitectStage;
 29:   answers: GoalAnswer[];
 30:   map: WorkingMap;
 31:   question: GoalQuestion | null;
 32:   agentQuestion: AgentQuestion | null;
 33:   agentMessage: string | null;
 34:   agentError: string | null;
 35:   isAgentThinking: boolean;
 36:   proposal: MissionProposal | null;
 37:   recommendedResearch: RecommendedResearch[];
 38:   webUsed: boolean;
 39:   modelUsed: boolean;
 40:   isFirstRun: boolean;
 41: }
 42: export const INITIAL_GOAL_ARCHITECT_STATE: GoalArchitectState = {
 43:   isOpen: false,
 44:   stage: "intent",
 45:   answers: [],
 46:   map: EMPTY_WORKING_MAP,
 47:   question: null,
 48:   agentQuestion: null,
 49:   agentMessage: null,
 50:   agentError: null,
 51:   isAgentThinking: false,
 52:   proposal: null,
 53:   recommendedResearch: [],
 54:   webUsed: false,
 55:   modelUsed: false,
 56:   isFirstRun: false,
 57: };
 58: export interface GoalArchitectHost {
 59:   apiKey(): string;
 60:   model(): string;
 61:   onChange(): void;
 62:   requestResearchApproval(queries: RecommendedResearch[]): void;
 63: }
 64: export interface GoalArchitectWorkflowDeps {
 65:   host: GoalArchitectHost;
 66:   agentGateway?: AgentGateway;
 67: }
 68: export class GoalArchitectWorkflow {
 69:   private current: GoalArchitectState = { ...INITIAL_GOAL_ARCHITECT_STATE };
 70:   constructor(private readonly deps: GoalArchitectWorkflowDeps) {}
 71:   get state(): GoalArchitectState {
 72:     return this.current;
 73:   }
 74:   private patch(changes: Partial<GoalArchitectState>): void {
 75:     this.current = { ...this.current, ...changes };
 76:     this.deps.host.onChange();
 77:   }
 78:   open(): void {
 79:     this.current = {
 80:       ...INITIAL_GOAL_ARCHITECT_STATE,
 81:       isOpen: true,
 82:       question: selectNextQuestion([]),
 83:     };
 84:     this.deps.host.onChange();
 85:   }
 86:   markFirstRun(): void {
 87:     this.patch({ isFirstRun: true });
 88:   }
 89:   close(): void {
 90:     this.patch({ isOpen: false });
 91:   }
 92:   submitAnswer(text: string): void {
 93:     const trimmed = text.trim();
 94:     if (!trimmed) return;
 95:     const questionId = this.currentQuestionId();
 96:     if (!questionId) return;
 97:     this.advanceWith(
 98:       recordAnswer(this.current.answers, {
 99:         questionId,
100:         text: trimmed,
101:         skipped: false,
102:         answeredAt: Date.now(),
103:       })
104:     );
105:   }
106:   skipCurrent(): void {
107:     const questionId = this.currentQuestionId();
108:     if (!questionId) return;
109:     this.advanceWith(
110:       recordAnswer(this.current.answers, {
111:         questionId,
112:         text: "",
113:         skipped: true,
114:         answeredAt: Date.now(),
115:       })
116:     );
117:   }
118:   /** Revises an earlier answer, rebuilding the map from the corrected set. */
119:   editAnswer(questionId: GoalQuestionId, text: string): void {
120:     this.advanceWith(
121:       recordAnswer(this.current.answers, {
122:         questionId,
123:         text: text.trim(),
124:         skipped: text.trim().length === 0,
125:         answeredAt: Date.now(),
126:       }),
127:       { keepStage: true }
128:     );
129:   }
130:   private currentQuestionId(): GoalQuestionId | null {
131:     // An agent follow-up is answered on behalf of whichever app question is outstanding,
132:     // so its answer is stored under a stable id rather than a model-invented one.
133:     return this.current.question?.id ?? null;
134:   }
135:   /**
136:    * Rebuilds the map from the answers and picks the next question.
137:    *
138:    * The map is always recomputed from scratch rather than patched, so editing an earlier
139:    * answer can *remove* a finding it had caused. Anything a model contributed is layered
140:    * back on top and stays labelled.
141:    */
142:   private advanceWith(
143:     answers: GoalAnswer[],
144:     options: { keepStage?: boolean } = {}
145:   ): void {
146:     const derived = deriveWorkingMap(answers);
147:     const map = mergeIntoWorkingMap(derived, this.agentContributions());
148:     const question = selectNextQuestion(answers);
149:     this.patch({
150:       answers,
151:       map,
152:       question,
153:       agentQuestion: null,
154:       // Stale prose from the previous turn would read as a response to this answer.
155:       agentMessage: null,
156:       proposal:
157:         options.keepStage && this.current.stage === "proposal"
158:           ? buildMissionProposal(map, this.current.recommendedResearch)
159:           : this.current.proposal,
160:     });
161:   }
162:   private agentContributions(): Partial<WorkingMap> {
163:     const agentOnly = (items: { origin: string }[]) =>
164:       items.filter(item => item.origin === "agent" || item.origin === "web") as any;
165:     return {
166:       constraints: agentOnly(this.current.map.constraints),
167:       assumptions: agentOnly(this.current.map.assumptions),
168:       unknowns: agentOnly(this.current.map.unknowns),
169:       prerequisites: agentOnly(this.current.map.prerequisites),
170:       risks: agentOnly(this.current.map.risks),
171:       candidateNextActions: agentOnly(this.current.map.candidateNextActions),
172:     };
173:   }
174:   async requestAgentTurn(): Promise<void> {
175:     const apiKey = this.deps.host.apiKey().trim();
176:     const gateway = this.deps.agentGateway;
177:     if (!apiKey) {
178:       this.patch({
179:         agentError:
180:           "No API key is set, so I can't ask a model for suggestions. Everything else here still works — add a key in Settings to enable this.",
181:       });
182:       return;
183:     }
184:     if (!gateway?.designGoalArchitectTurn) {
185:       this.patch({
186:         agentError: "This build has no model connection for goal planning.",
187:       });
188:       return;
189:     }
190:     this.patch({ isAgentThinking: true, agentError: null });
191:     try {
192:       const raw = await gateway.designGoalArchitectTurn({
193:         briefing: this.briefing(),
194:         apiKey,
195:         model: this.deps.host.model(),
196:       });
197:       const turn = normalizeGoalArchitectTurn(raw);
198:       if (!turn) {
199:         this.patch({
200:           isAgentThinking: false,
201:           agentError:
202:             "The model's reply didn't come back in a usable shape. Your answers are safe — try again, or carry on without it.",
203:         });
204:         return;
205:       }
206:       const map = mergeIntoWorkingMap(this.current.map, turn.workingMap);
207:       this.patch({
208:         isAgentThinking: false,
209:         map,
210:         agentMessage: turn.message || null,
211:         agentQuestion: turn.question
212:           ? {
213:               prompt: turn.question.prompt,
214:               rationale: turn.question.rationale,
215:               choices: turn.question.choices,
216:             }
217:           : null,
218:         recommendedResearch: turn.recommendedResearch ?? this.current.recommendedResearch,
219:         modelUsed: true,
220:         proposal:
221:           this.current.stage === "proposal"
222:             ? buildMissionProposal(map, turn.recommendedResearch ?? this.current.recommendedResearch)
223:             : this.current.proposal,
224:       });
225:     } catch (error: any) {
226:       this.patch({
227:         isAgentThinking: false,
228:         agentError: `Couldn't reach the model: ${error?.message ?? "unknown error"}. Your answers are safe.`,
229:       });
230:     }
231:   }
232:   get canPropose(): boolean {
233:     return canProposeMission(this.current.answers);
234:   }
235:   proposeMission(): void {
236:     if (!this.canPropose) return;
237:     this.patch({
238:       stage: "proposal",
239:       proposal: buildMissionProposal(this.current.map, this.current.recommendedResearch),
240:     });
241:   }
242:   backToQuestions(): void {
243:     this.patch({ stage: "intent", question: selectNextQuestion(this.current.answers) });
244:   }
245:   requestResearch(): void {
246:     const queries = this.current.recommendedResearch;
247:     if (queries.length === 0) return;
248:     this.deps.host.requestResearchApproval(queries);
249:   }
250:   markWebUsed(): void {
251:     this.patch({ webUsed: true });
252:   }
253:   private briefing(): string {
254:     const lines: string[] = ["The user's answers so far:"];
255:     for (const answer of this.current.answers) {
256:       lines.push(
257:         answer.skipped
258:           ? `- [${answer.questionId}] (skipped)`
259:           : `- [${answer.questionId}] ${answer.text}`
260:       );
261:     }
262:     const map = this.current.map;
263:     const section = (label: string, items: { text: string }[]) => {
264:       if (items.length === 0) return;
265:       lines.push(`\n${label}:`);
266:       for (const item of items) lines.push(`- ${item.text}`);
267:     };
268:     if (map.goal) lines.push(`\nGoal: ${map.goal.text}`);
269:     if (map.deliverable) lines.push(`Deliverable: ${map.deliverable.text}`);
270:     section("Constraints", map.constraints);
271:     section("Assumptions", map.assumptions);
272:     section("Open questions", map.unknowns);
273:     section("Prerequisites", map.prerequisites);
274:     section("Risks", map.risks);
275:     return lines.join("\n");
276:   }
277: }
</file>

