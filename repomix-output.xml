<file path="src/usecases/capture/SuggestNextActionInteractor.ts">
 1: import { Card } from "../../entities/card";
 2: import { AgentGateway } from "../ports/gateways/AgentGateway";
 3: import { NextAction, NextActionOptions, nextActionsForCard } from "./nextActions";
 4: import { UseCaseError } from "../errors";
 5: export class SuggestNextActionError extends UseCaseError {
 6:   constructor(userMessage: string) {
 7:     super(userMessage);
 8:   }
 9: }
10: export interface SuggestedNextAction {
11:   action: NextAction;
12:   reason: string;
13: }
14: export class SuggestNextActionInteractor {
15:   constructor(private readonly agentGateway: AgentGateway) {}
16:   async execute(
17:     card: Card,
18:     apiKey: string,
19:     model: string,
20:     options: NextActionOptions = {},
21:     systemPrompt?: string
22:   ): Promise<SuggestedNextAction> {
23:     const menu = nextActionsForCard(card, options);
24:     if (menu.length === 0) {
25:       throw new SuggestNextActionError("There's nothing to suggest for this card.");
26:     }
27:     const trimmedKey = apiKey.trim();
28:     if (!trimmedKey) {
29:       throw new SuggestNextActionError("No API key is set.");
30:     }
31:     if (!this.agentGateway.suggestNextAction) {
32:       throw new SuggestNextActionError("This build has no model connection for suggestions.");
33:     }
34:     let text: string;
35:     try {
36:       text = await this.agentGateway.suggestNextAction({
37:         prompt: buildPrompt(card, menu),
38:         apiKey: trimmedKey,
39:         model,
40:         ...(systemPrompt ? { systemPrompt } : {}),
41:       });
42:     } catch (err: any) {
43:       throw new SuggestNextActionError(err?.message ?? "Couldn't reach the model");
44:     }
45:     const parsed = parseChoice(text);
46:     const chosen = parsed && menu.find(action => action.id === parsed.id);
47:     if (!chosen) {
48:       throw new SuggestNextActionError("The model's answer wasn't one of the offered actions.");
49:     }
50:     return { action: chosen, reason: parsed!.reason };
51:   }
52: }
53: function buildPrompt(card: Card, menu: NextAction[]): string {
54:   const options = menu.map(action => `- ${action.id}: ${action.label}`).join("\n");
55:   return [
56:     `A learner just captured this card:`,
57:     `Title: ${card.title}`,
58:     card.body ? `Body: ${card.body}` : null,
59:     ``,
60:     `Pick exactly one of the following next actions by id, and give a one-sentence reason.`,
61:     `Respond with nothing but this exact format, no other text:`,
62:     `id: <one of the ids below>`,
63:     `reason: <one sentence>`,
64:     ``,
65:     options,
66:   ]
67:     .filter((line): line is string => line !== null)
68:     .join("\n");
69: }
70: /** Reads the strict `id: …\nreason: …` format the prompt asks for. Anything else is null. */
71: function parseChoice(text: string): { id: string; reason: string } | null {
72:   const idMatch = text.match(/id:\s*([a-z0-9-]+)/i);
73:   const reasonMatch = text.match(/reason:\s*(.+)/i);
74:   if (!idMatch) return null;
75:   return {
76:     id: idMatch[1].trim(),
77:     reason: reasonMatch?.[1]?.trim() ?? "",
78:   };
79: }
</file>

