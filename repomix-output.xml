145: export function selectNextQuestion(answers: GoalAnswer[]): GoalQuestion | null {
146:   const text = answeredText(answers);
147:   for (const question of GOAL_QUESTIONS) {
148:     if (isAsked(answers, question.id)) continue;
149:     if (!question.optional) return question;
150:     const hint = COVERAGE_HINTS[question.id];
151:     if (hint && hint.test(text)) continue;
152:     return question;
153:   }
154:   return null;
155: }
156: export function canProposeMission(answers: GoalAnswer[]): boolean {
157:   return hasAnswer(answers, "outcome");
158: }
159: const firstSentence = (text: string): string => {
160:   const trimmed = text.trim();
161:   const match = trimmed.match(/^(.{10,120}?)[.!?](\s|$)/);
162:   return (match ? match[1] : trimmed).trim();
163: };
164: function listItems(text: string): string[] {
165:   return text
166:     .split(/[\n;]|,(?=\s)| and (?=\w)/i)
167:     .map(part => part.trim().replace(/^[-*•]\s*/, ""))
168:     .filter(part => part.length > 2);
169: }
170: /**
171:  * Builds the working map from the answers alone — no model, no network.
172:  *
173:  * This is the function that makes the whole flow usable without an API key, so it stays
174:  * deterministic and total: any set of answers, including none, yields a valid map. Every
175:  * entry it produces is tagged `user` (their own words) or `app` (something derived), never
176:  * `agent` — this function has no agent to speak for.
177:  */
178: export function deriveWorkingMap(answers: GoalAnswer[]): WorkingMap {
179:   const map: WorkingMap = {
180:     ...EMPTY_WORKING_MAP,
181:     constraints: [],
182:     assumptions: [],
183:     unknowns: [],
184:     prerequisites: [],
185:     risks: [],
186:     candidateNextActions: [],
187:   };
188:   const value = (id: GoalQuestionId): string => {
189:     const answer = answerFor(answers, id);
190:     return answer && !answer.skipped ? answer.text.trim() : "";
191:   };
192:   const outcome = value("outcome");
193:   if (outcome) map.goal = insight(firstSentence(outcome), "user");
194:   const finished = value("finished-result");
195:   if (finished) {
196:     map.deliverable = insight(firstSentence(finished), "user");
197:   } else if (outcome) {
198:     map.assumptions.push(
199:       insight(`"Done" is not yet defined — I've assumed it means: ${firstSentence(outcome)}`, "app")
200:     );
201:     map.unknowns.push(insight("What counts as a finished result", "app"));
202:   }
203:   for (const item of listItems(value("constraints"))) {
204:     map.constraints.push(insight(item, "user"));
205:   }
206:   const assets = value("assets");
207:   for (const item of listItems(assets)) {
208:     map.assumptions.push(insight(`You already have: ${item}`, "user"));
209:   }
210:   if (!assets) {
211:     map.unknowns.push(insight("Your starting experience, tools, and available time", "app"));
212:   }
213:   const approach = value("approach");
214:   if (approach) {
215:     map.assumptions.push(insight(`Intended approach: ${firstSentence(approach)}`, "user"));
216:     map.risks.push(
217:       insight("The intended approach hasn't been validated against a working proof yet", "app")
218:     );
219:   } else {
220:     map.unknowns.push(insight("How you intend to approach it", "app"));
221:   }
222:   const proof = value("smallest-proof");
223:   if (proof) {
224:     map.candidateNextActions.push(insight(firstSentence(proof), "user"));
225:   } else if (outcome) {
226:     map.candidateNextActions.push(
227:       insight("Define the smallest result that would prove this is working", "app")
228:     );
229:   }
230:   const blocker = value("blocker");
231:   if (blocker) {
232:     for (const item of listItems(blocker)) map.risks.push(insight(item, "user"));
233:     map.prerequisites.push(insight(`Understand ${firstSentence(blocker)}`, "app"));
234:   } else {
235:     map.unknowns.push(insight("Which part is most likely to block you", "app"));
236:   }
237:   const motivation = value("motivation");
238:   if (motivation) {
239:     map.assumptions.push(insight(`Why it matters now: ${firstSentence(motivation)}`, "user"));
240:   }
241:   for (const question of GOAL_QUESTIONS) {
242:     const answer = answerFor(answers, question.id);
243:     if (answer?.skipped) {
244:       map.unknowns.push(insight(`Skipped: ${question.prompt}`, "app"));
245:     }
246:   }
247:   return map;
248: }
249: export function mergeIntoWorkingMap(base: WorkingMap, additions: Partial<WorkingMap>): WorkingMap {
250:   const merge = (existing: Insight[], incoming: Insight[] | undefined): Insight[] => {
251:     if (!incoming?.length) return existing;
252:     const seen = new Set(existing.map(item => item.text.toLowerCase()));
253:     const fresh = incoming.filter(item => {
254:       const key = item.text.toLowerCase();
255:       if (!item.text || seen.has(key)) return false;
256:       seen.add(key);
257:       return true;
258:     });
259:     return fresh.length ? [...existing, ...fresh] : existing;
260:   };
261:   return {
262:     goal: base.goal ?? additions.goal,
263:     deliverable: base.deliverable ?? additions.deliverable,
264:     constraints: merge(base.constraints, additions.constraints),
265:     assumptions: merge(base.assumptions, additions.assumptions),
266:     unknowns: merge(base.unknowns, additions.unknowns),
267:     prerequisites: merge(base.prerequisites, additions.prerequisites),
268:     risks: merge(base.risks, additions.risks),
269:     candidateNextActions: merge(base.candidateNextActions, additions.candidateNextActions),
270:   };
271: }
272: export interface RecommendedResearch {
273:   query: string;
274:   rationale: string;
275:   sourceKinds: string[];
276: }
277: export interface GoalArchitectTurn {
278:   message: string;
279:   question?: {
280:     id: string;
281:     prompt: string;
282:     rationale: string;
283:     optional: boolean;
284:     choices?: string[];
285:   };
286:   workingMap: Partial<WorkingMap>;
287:   recommendedResearch?: RecommendedResearch[];
288: }
289: const asString = (value: unknown): string =>
290:   typeof value === "string" ? value.trim() : "";
291: /** Coerces a model's array-ish field into agent-tagged insights, dropping junk. */
292: function asInsights(value: unknown): Insight[] {
293:   if (!Array.isArray(value)) return [];
294:   return value
295:     .map(item => asString(typeof item === "string" ? item : (item as any)?.text))
296:     .filter(text => text.length > 0)
297:     .map(text => insight(text, "agent"));
298: }
299: export function normalizeGoalArchitectTurn(raw: unknown): GoalArchitectTurn | null {
300:   if (!raw || typeof raw !== "object") return null;
301:   const source = raw as Record<string, unknown>;
302:   const message = asString(source.message);
303:   const rawMap = (source.workingMap ?? {}) as Record<string, unknown>;
304:   const rawQuestion = source.question as Record<string, unknown> | undefined;
305:   const question =
306:     rawQuestion && asString(rawQuestion.prompt)
307:       ? {
308:           id: asString(rawQuestion.id) || "agent-question",
309:           prompt: asString(rawQuestion.prompt),
310:           rationale: asString(rawQuestion.rationale),
311:           optional: rawQuestion.optional !== false,
312:           choices: Array.isArray(rawQuestion.choices)
313:             ? rawQuestion.choices.map(asString).filter(Boolean)
314:             : undefined,
315:         }
316:       : undefined;
317:   if (!message && !question) return null;
318:   const goalText = asString(rawMap.goal);
319:   const deliverableText = asString(rawMap.deliverable);
320:   const research = Array.isArray(source.recommendedResearch)
321:     ? source.recommendedResearch
322:         .map((item: any) => ({
323:           query: asString(item?.query),
324:           rationale: asString(item?.rationale),
325:           sourceKinds: Array.isArray(item?.sourceKinds)
326:             ? item.sourceKinds.map(asString).filter(Boolean)
327:             : [],
328:         }))
329:         .filter(item => item.query.length > 0)
330:     : [];
331:   return {
332:     message,
333:     question,
334:     workingMap: {
335:       goal: goalText ? insight(goalText, "agent") : undefined,
336:       deliverable: deliverableText ? insight(deliverableText, "agent") : undefined,
337:       constraints: asInsights(rawMap.constraints),
338:       assumptions: asInsights(rawMap.assumptions),
339:       unknowns: asInsights(rawMap.unknowns),
340:       prerequisites: asInsights(rawMap.prerequisites),
341:       risks: asInsights(rawMap.risks),
342:       candidateNextActions: asInsights(rawMap.candidateNextActions),
343:     },
344:     recommendedResearch: research.length ? research : undefined,
345:   };
346: }
347: export interface ProposedCard {
348:   role: SemanticRole;
349:   type: CardType;
350:   title: string;
351:   body: string;
352:   origin: InsightOrigin;
353: }
354: export interface MissionProposal {
355:   title: string;
356:   goalStatement: string;
357:   targetDeliverable: string;
358:   successCriteria: string[];
359:   constraints: Insight[];
360:   assumptions: Insight[];
361:   firstMilestone: string;
362:   smallestProof: string;
363:   prerequisites: Insight[];
364:   risks: Insight[];
365:   unknowns: Insight[];
366:   recommendedResearch: RecommendedResearch[];
367:   suggestedCards: ProposedCard[];
368: }
369: const titleCase = (text: string): string =>
370:   text.length > 0 ? text[0].toUpperCase() + text.slice(1) : text;
371: function toTitle(text: string, max = 60): string {
372:   const cleaned = titleCase(text.replace(/^(i want to|i'd like to|i wanna|help me)\s+/i, "").trim());
373:   return cleaned.length <= max ? cleaned : `${cleaned.slice(0, max - 1).trimEnd()}…`;
374: }
375: /**
376:  * Builds the mission proposal from the working map.
377:  *
378:  * Deterministic, so the draft exists with or without a model. Where the map is silent the
379:  * proposal says so in plain language rather than inventing a plausible-sounding milestone
380:  * — an admitted gap is useful, and a fabricated plan is worse than none.
381:  */
382: export function buildMissionProposal(
383:   map: WorkingMap,
384:   research: RecommendedResearch[] = []
385: ): MissionProposal {
386:   const goalText = map.goal?.text ?? "";
387:   const deliverable = map.deliverable?.text ?? "";
388:   const smallestProof =
389:     map.candidateNextActions[0]?.text ??
390:     "Define the smallest result that would prove this is working";
391:   const firstMilestone = deliverable
392:     ? `Produce a first version of: ${deliverable}`
393:     : `Decide and write down what "finished" means for this goal`;
394:   const successCriteria = [
395:     deliverable ? `${deliverable} exists and works end to end` : `A written definition of "done" exists`,
396:     `${smallestProof} — completed and checked`,
397:   ];
398:   const suggestedCards: ProposedCard[] = [];
399:   if (goalText) {
400:     suggestedCards.push({
401:       role: "goal",
402:       type: "note",
403:       title: toTitle(goalText),
404:       body: goalText,
405:       origin: map.goal!.origin,
406:     });
407:   }
408:   if (deliverable) {
409:     suggestedCards.push({
410:       role: "deliverable",
411:       type: "note",
412:       title: toTitle(deliverable),
413:       body: deliverable,
414:       origin: map.deliverable!.origin,
415:     });
416:   }
417:   suggestedCards.push({
418:     role: "task",
419:     type: "note",
420:     title: toTitle(firstMilestone),
421:     body: `First milestone.\n\n${firstMilestone}`,
422:     origin: "app",
423:   });
424:   if (map.candidateNextActions.length > 0) {
425:     const proof = map.candidateNextActions[0];
426:     suggestedCards.push({
427:       role: "experiment",
428:       type: "note",
429:       title: toTitle(`Prove it: ${proof.text}`),
430:       body: [
431:         `Hypothesis: ${proof.text} is achievable with what you have now.`,
432:         `Method: build the smallest version that could demonstrate it.`,
433:         `Measurement: does it work end to end, yes or no?`,
434:         `Expected result: unknown — that is why it is worth running.`,
435:         `Next action: if it fails, the reason becomes the next prerequisite.`,
436:       ].join("\n\n"),
437:       origin: proof.origin,
438:     });
439:   }
440:   for (const prerequisite of map.prerequisites) {
441:     suggestedCards.push({
442:       role: "concept",
443:       type: "note",
444:       title: toTitle(prerequisite.text),
445:       body: prerequisite.text,
446:       origin: prerequisite.origin,
447:     });
448:   }
449:   for (const unknown of map.unknowns) {
450:     suggestedCards.push({
451:       role: "question",
452:       type: "question",
453:       title: toTitle(unknown.text),
454:       body: unknown.text,
455:       origin: unknown.origin,
456:     });
457:   }
458:   return {
459:     title: toTitle(goalText || "Untitled mission"),
460:     goalStatement: goalText,
461:     targetDeliverable: deliverable,
462:     successCriteria,
463:     constraints: map.constraints,
464:     assumptions: map.assumptions,
465:     firstMilestone,
466:     smallestProof,
467:     prerequisites: map.prerequisites,
468:     risks: map.risks,
469:     unknowns: map.unknowns,
470:     recommendedResearch: research,
471:     suggestedCards,
472:   };
473: }
474: export function describeKnownGaps(map: WorkingMap): string {
475:   if (map.unknowns.length === 0) {
476:     return "No open questions were recorded when this mission was created.";
477:   }
478:   return [
479:     "Open at the time this mission was created:",
480:     ...map.unknowns.map(item => `- ${item.text}${item.origin === "agent" ? " (agent hypothesis — verify)" : ""}`),
481:   ].join("\n");
482: }
483: export function describeAssumptions(map: WorkingMap): string {
484:   if (map.assumptions.length === 0) {
485:     return "No assumptions were recorded when this mission was created.";
486:   }
487:   return [
488:     "This mission assumes the following. Correct anything that is wrong:",
489:     ...map.assumptions.map(item => `- ${item.text} [${item.origin}]`),
490:   ].join("\n");
491: }
