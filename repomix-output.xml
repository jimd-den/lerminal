<file path="src/entities/schedule.ts">
 1: export type ReviewGrade = "again" | "hard" | "good" | "easy";
 2: export type FsrsStateName = "new" | "learning" | "review" | "relearning";
 3: const DAY_IN_MS = 86400000;
 4: const TEN_MIN_MS = 600000;
 5: export interface ScheduleState {
 6:   algorithm?: "fsrs";
 7:   version?: 5;
 8:   state?: FsrsStateName;
 9:   dueAt: number;
10:   lastReviewAt?: number;
11:   stability?: number;
12:   difficulty?: number;
13:   scheduledDays?: number;
14:   interval: number;
15:   reps: number;
16:   lapses?: number;
17: }
18: export interface ReviewLog {
19:   id: string;
20:   cardId: string;
21:   workspaceId: string;
22:   reviewedAt: number;
23:   grade: ReviewGrade;
24:   previousState: FsrsStateName;
25:   nextState: FsrsStateName;
26:   scheduledDays: number;
27:   elapsedDays: number;
28: }
29: export function createInitialSchedule(now: number): ScheduleState {
30:   const result: ScheduleState = {
31:     algorithm: "fsrs",
32:     version: 5,
33:     state: "new",
34:     dueAt: now + DAY_IN_MS,
35:     stability: 1.0,
36:     difficulty: 5.0,
37:     interval: 1,
38:     scheduledDays: 1,
39:     reps: 0,
40:     lapses: 0,
41:   };
42:   return result;
43: }
44: export function gradeSchedule(current: ScheduleState, grade: ReviewGrade, now: number): ScheduleState {
45:   const lapses = current.lapses ?? 0;
46:   let result: ScheduleState;
47:   if (grade === "again") {
48:     result = {
49:       ...current,
50:       dueAt: now + TEN_MIN_MS,
51:       interval: 1,
52:       scheduledDays: 0,
53:       reps: current.reps,
54:       lapses: lapses + 1,
55:       state: "relearning",
56:       lastReviewAt: now,
57:     };
58:   } else {
59:     const factor = grade === "hard" ? 1.2 : grade === "easy" ? 3.2 : 2.4;
60:     const bonus = grade === "easy" ? 2 : 1;
61:     const nextInterval = Math.max(1, Math.round(current.interval * factor) + bonus);
62:     result = {
63:       ...current,
64:       dueAt: now + nextInterval * DAY_IN_MS,
65:       interval: nextInterval,
66:       scheduledDays: nextInterval,
67:       reps: current.reps + 1,
68:       lapses,
69:       state: "review",
70:       lastReviewAt: now,
71:     };
72:   }
73:   return result;
74: }
75: export function updateSchedule(current: ScheduleState, ok: boolean, now: number): ScheduleState {
76:   return gradeSchedule(current, ok ? "good" : "again", now);
77: }
</file>

