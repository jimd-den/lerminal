1306:   private buildChatContext(card: Card): string {
1307:     const ws = this.domain.workspaces.find(
1308:       (w) => w.id === this.domain.activeWorkspaceId,
1309:     );
1310:     const groupCards = this.domain.cards.filter(
1311:       (c) =>
1312:         c.parentId === card.parentId &&
1313:         c.id !== card.id &&
1314:         c.type !== "group" &&
1315:         c.type !== "chat",
1316:     );
1317:     const cardList =
1318:       groupCards.length > 0
1319:         ? groupCards
1320:             .map(
1321:               (c) =>
1322:                 `- ${c.title}: ${(c.body || c.answer || "").substring(0, 400)}`,
1323:             )
1324:             .join("\n")
1325:         : "(no other cards in this group yet)";
1326:     return `You are a focused study tutor helping the user learn. They are in the workspace "${ws?.name ?? "Untitled"}". Use the following cards from the current group as the primary context for your answers; be accurate and concise, and say when something isn't covered by them.\n\nCards in context:\n${cardList}`;
1327:   }
1328:   async sendChatMessage(cardId: string, userText: string): Promise<boolean> {
1329:     const text = userText.trim();
1330:     if (!text) return false;
1331:     if (this.ui.chatStreamingCardId) return false;
1332:     const card = this.domain.cards.find((c) => c.id === cardId);
1333:     if (!card) return false;
1334:     if (!this.agentGateway.streamChat) {
1335:       this.showToast("This model gateway can't stream chat");
1336:       return false;
1337:     }
1338:     if (!this.domain.openRouterKey?.trim()) {
1339:       this.showToast("Add your OpenRouter key in Settings");
1340:       return false;
1341:     }
1342:     const history = this.parseChat(card.body);
1343:     history.push({ role: "user", content: text });
1344:     history.push({ role: "assistant", content: "" });
1345:     const assistantIdx = history.length - 1;
1346:     this.ui.chatStreamingCardId = cardId;
1347:     this.emit();
1348:     const requestMessages: ChatMessage[] = [
1349:       {
1350:         role: "system",
1351:         content: `${
1352:           resolveAssistantProfile(
1353:             "chat",
1354:             this.domain.activeProfileIds,
1355:             this.domain.assistantProfiles,
1356:           ).systemPrompt
1357:         }\n\n${this.buildChatContext(card)}`,
1358:       },
1359:       ...history.slice(0, assistantIdx),
1360:     ];
1361:     try {
1362:       await this.writeChat(cardId, history, true);
1363:       await this.agentGateway.streamChat(
1364:         requestMessages,
1365:         this.domain.openRouterKey,
1366:         this.domain.selectedModel,
1367:         (delta) => {
1368:           history[assistantIdx].content += delta;
1369:           void this.writeChat(cardId, history, false);
1370:         },
1371:       );
1372:       await this.writeChat(cardId, history, true);
1373:     } catch (err: any) {
1374:       history[assistantIdx].content +=
1375:         `\n\n_[error: ${err?.message || "stream failed"}]_`;
1376:       await this.writeChat(cardId, history, true);
1377:       this.showToast("Chat failed");
1378:     } finally {
1379:       this.ui.chatStreamingCardId = null;
1380:       this.emit();
1381:     }
1382:     return true;
1383:   }
1384:   async extractUrlToCard(
1385:     url: string,
1386:     title: string,
1387:     parentId?: string,
1388:     sourceCardIdForGrouping?: string,
1389:   ): Promise<void> {
1390:     const workspaceId = this.domain.activeWorkspaceId;
1391:     if (!workspaceId) return;
1392:     const opId = this.addPendingOperation(`Extracting ${url}...`);
1393:     try {
