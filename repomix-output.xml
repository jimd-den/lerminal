1099:   const [capability, setCapability] =
1100:     useState<AssistantCapability>("generate-cards");
1101:   const [messages, setMessages] = useState<ChatMessage[]>([]);
1102:   const [input, setInput] = useState("");
1103:   const [working, setWorking] = useState(false);
1104:   const [name, setName] = useState("");
1105:   const [description, setDescription] = useState("");
1106:   const [prompt, setPrompt] = useState("");
1107:   useEffect(() => {
1108:     if (!visible) {
1109:       setMessages([]);
1110:       setInput("");
1111:       setName("");
1112:       setDescription("");
1113:       setPrompt("");
1114:     }
1115:   }, [visible]);
1116:   const chooseCapability = (next: AssistantCapability) => {
1117:     if (next === capability) return;
1118:     setCapability(next);
1119:     setMessages([]);
1120:     setInput("");
1121:     setName("");
1122:     setDescription("");
1123:     setPrompt("");
1124:   };
