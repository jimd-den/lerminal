 18:   | {
 19:       type: "chunk_cards";
 20:       cardIds: string[];
 21:       mode: "deterministic" | "agent-assisted";
 22:       destinationParentId?: string | null;
 23:     }
 24:   | { type: "extract_url"; cardId: string }
 25:   | { type: "search_web"; queries: string[]; purpose: string; sourceKinds?: string[] }
 26:   | { type: "make_study_candidates"; cardIds: string[]; mode: "recall" | "cloze" }
 27:   | { type: "draft_experiment"; cardIds: string[] }
 28:   | {
 29:       type: "create_mission";
 30:       title: string;
 31:       goalStatement: string;
 32:       targetDeliverable?: string;
 33:       successCriteria?: string[];
 34:       steps: Array<{ title: string; detail?: string; role?: SemanticRole }>;
 35:       cardIds?: string[];
 36:     }
 37:   | { type: "ask_clarifying_question"; question: string; rationale?: string };
 38: const AGENT_TOOL_INTENT_TYPE_MAP: Record<AgentToolIntent["type"], true> = {
 39:   suggest_next_actions: true,
 40:   create_cards: true,
 41:   create_group: true,
 42:   link_cards: true,
 43:   chunk_cards: true,
 44:   extract_url: true,
 45:   search_web: true,
 46:   make_study_candidates: true,
 47:   draft_experiment: true,
 48:   create_mission: true,
 49:   ask_clarifying_question: true,
 50: };
 51: export const AGENT_TOOL_INTENT_TYPES = Object.keys(
 52:   AGENT_TOOL_INTENT_TYPE_MAP
 53: ) as AgentToolIntent["type"][];
 54: export interface ToolIntentItem {
 55:   key: string;
 56:   title: string;
 57:   detail?: string;
 58:   cardId?: string;
 59: }
 60: export function toolIntentItems(tool: AgentToolIntent): ToolIntentItem[] | null {
 61:   switch (tool.type) {
 62:     case "create_cards":
 63:       return tool.cards.map((card, index) => ({
 64:         key: `card-${index}`,
 65:         title: card.title,
 66:         detail: card.body,
 67:       }));
 68:     case "create_group":
 69:     case "chunk_cards":
 70:     case "make_study_candidates":
 71:       return tool.cardIds.map(cardId => ({ key: cardId, title: cardId, cardId }));
 72:     case "search_web":
 73:       return tool.queries.map((query, index) => ({ key: `query-${index}`, title: query }));
 74:     case "create_mission":
 75:       return [
 76:         ...tool.steps.map((step, index) => ({
 77:           key: `step-${index}`,
 78:           title: step.title,
 79:           ...(step.detail ? { detail: step.detail } : {}),
 80:         })),
 81:         ...(tool.cardIds ?? []).map(cardId => ({ key: cardId, title: cardId, cardId })),
 82:       ];
 83:     default:
 84:       return null;
 85:   }
 86: }
 87: export function narrowToolIntent(
 88:   tool: AgentToolIntent,
 89:   selectedKeys: Iterable<string>
 90: ): AgentToolIntent | null {
 91:   const selected = new Set(selectedKeys);
 92:   switch (tool.type) {
 93:     case "create_cards": {
 94:       const cards = tool.cards.filter((_, index) => selected.has(`card-${index}`));
 95:       if (cards.length === 0) return null;
 96:       return { type: "create_cards", cards };
 97:     }
 98:     case "create_group": {
 99:       const cardIds = tool.cardIds.filter(id => selected.has(id));
100:       if (cardIds.length === 0) return null;
101:       return { ...tool, cardIds };
102:     }
103:     case "chunk_cards":
104:     case "make_study_candidates": {
105:       const cardIds = tool.cardIds.filter(id => selected.has(id));
106:       if (cardIds.length === 0) return null;
107:       return { ...tool, cardIds };
108:     }
109:     case "search_web": {
110:       const queries = tool.queries.filter((_, index) => selected.has(`query-${index}`));
111:       if (queries.length === 0) return null;
112:       return { ...tool, queries };
113:     }
114:     case "create_mission": {
115:       const steps = tool.steps.filter((_, index) => selected.has(`step-${index}`));
116:       if (steps.length === 0) return null;
117:       const cardIds = (tool.cardIds ?? []).filter(id => selected.has(id));
118:       const narrowed: AgentToolIntent = { ...tool, steps };
119:       if (tool.cardIds) {
120:         if (cardIds.length > 0) (narrowed as { cardIds?: string[] }).cardIds = cardIds;
121:         else delete (narrowed as { cardIds?: string[] }).cardIds;
122:       }
123:       return narrowed;
124:     }
125:     default:
126:       return tool;
127:   }
128: }
</file>

