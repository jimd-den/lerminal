37:   dispatch: { kind: "mission" },
38: });
39: const extractKeyIdeasAction = (): NextAction => ({
40:   id: "extract-ideas",
41:   label: "Extract key ideas",
42:   dispatch: { kind: "pipeline", text: "chunk" },
43: });
44: const createTaskAction = (): NextAction => ({
45:   id: "create-task",
46:   label: "Create next task",
47:   dispatch: { kind: "preflight", presetId: "plan-capstone" },
48: });
49: const MENUS: Record<SemanticRole, () => NextAction[]> = {
50:   question: () => [researchAction(), prerequisitesAction(), explainAction()],
51:   concept: () => [explainAction(), studyCardsAction(), prerequisitesAction()],
52:   source: () => [extractKeyIdeasAction(), studyCardsAction(), researchAction()],
53:   experiment: () => [planExperimentAction(), prerequisitesAction(), createTaskAction()],
54:   claim: () => [researchAction(), explainAction(), studyCardsAction()],
55:   task: () => [createTaskAction(), prerequisitesAction(), attachToMissionAction()],
56:   deliverable: () => [createTaskAction(), attachToMissionAction(), explainAction()],
57:   goal: () => [prerequisitesAction(), researchAction(), attachToMissionAction()],
58: };
59: const noteMenu = (): NextAction[] => [
60:   explainAction(),
61:   prerequisitesAction(),
62:   attachToMissionAction(),
63: ];
64: function resolveRole(card: Card): SemanticRole | null {
65:   if (card.role) return card.role;
66:   switch (card.type) {
67:     case "source":
68:       return "source";
69:     case "chunk":
70:       return "concept";
71:     case "question":
72:       return "question";
73:     default:
74:       return null;
75:   }
76: }
77: export interface NextActionOptions {
78:   hasMission?: boolean;
79: }
80: export function nextActionsForCard(card: Card, options: NextActionOptions = {}): NextAction[] {
81:   const role = resolveRole(card);
82:   const actions = role ? MENUS[role]() : noteMenu();
83:   return options.hasMission === false
84:     ? actions.filter(action => action.dispatch.kind !== "mission")
85:     : actions;
86: }
</file>

