 454:   private buildWorkspaceAgentWorkflow(deps: GriotControllerDeps): WorkspaceAgentWorkflow {
 455:     const host: WorkspaceAgentHost = {
 456:       onChange: () => this.emit(),
 457:       apiKey: () => this.domain.openRouterKey ?? "",
 458:       model: () => this.domain.selectedModel,
 459:       // The user-editable body from the prompt registry; the gateway wraps it in the
 460:       // parent rules and the workspace-agent output contract, neither of which is
 461:       // reachable from settings.
 462:       systemPrompt: () => this.agentPromptBody("workspace-agent"),
 463:       webSearchEnabled: () => this.domain.webSearchEnabled,
 464:       allCards: () => this.domain.cards,
 465:       currentContext: () => this.workspaceAgentContext(),
 466:     };
 467:     return new WorkspaceAgentWorkflow({
 468:       host,
 469:       agentGateway: deps.agentGateway,
 470:       dispatchTool: (tool, context) => this.dispatchWorkspaceAgentTool(tool, context),
 471:     });
 472:   }
 473:   private buildResearchWorkflow(deps: GriotControllerDeps): ResearchWorkflow {
 474:       return new ResearchWorkflow({
 475:         runResearch: this.runResearchInteractor,
 476:         extractResult: this.extractResearchResultInteractor,
 477:         saveAsSource: this.saveResearchResultAsSourceInteractor,
 478:         createBrief: this.createResearchBriefInteractor,
 479:         host: {
 480:           context: () => ({
 481:             workspaceId: this.domain.activeWorkspaceId,
 482:             parentId: this.domain.currentGroupId,
 483:             apiKey: this.domain.openRouterKey,
 484:             model: this.domain.selectedModel,
 485:           }),
 486:           onChange: () => this.emit(),
 487:           notify: (message) => this.showToast(message),
 488:           onSourceSaved: async (workspaceId) => {
 489:             if (this.domain.activeWorkspaceId === workspaceId) {
 490:               await this.loadCardsForActiveWorkspace();
 491:             }
 492:             this.emit();
 493:           },
 494:           onBriefCreated: async ({ created, keptCount, workspaceId, parentId }) => {
 495:             this.operations.present({
 496:               summary: `${created.length} cited claim${created.length === 1 ? "" : "s"} created from ${keptCount} kept source(s)`,
 497:               createdCardIds: created.map((card) => card.id),
 498:               destination: { spaceId: workspaceId, groupId: parentId ?? undefined },
 499:               primaryActionLabel: "Open result",
 500:             });
 501:             if (this.domain.activeWorkspaceId === workspaceId) {
 502:               this.domain.selection = new Set(created.map((card) => card.id));
 503:               await this.loadCardsForActiveWorkspace();
 504:             }
 505:             this.emit();
 506:           },
 507:         },
 508:       });
 509:   }
 510:   private buildMissionWorkflow(deps: GriotControllerDeps): MissionWorkflow {
 511:       return new MissionWorkflow({
 512:         workspaceRepo: deps.workspaceRepo,
 513:         gapReport: this.gapReportInteractor,
 514:         generateSyllabus: this.generateSyllabusInteractor,
 515:         host: {
 516:           activeWorkspace: () => this.activeWorkspace(),
 517:           cards: () => this.domain.cards,
 518:           apiKey: () => this.domain.openRouterKey ?? "",
 519:           model: () => this.domain.selectedModel,
 520:           onChange: () => this.emit(),
 521:           notify: (message) => this.showToast(message),
 522:           onWorkspaceSaved: (workspace) => {
 523:             this.domain.workspaces = this.domain.workspaces.map((w) =>
 524:               w.id === workspace.id ? workspace : w,
 525:             );
 526:           },
 527:           openStatusReportPreflight: (prompt) => {
 528:             this.ui.activePreflightPresetId = "status-report";
 529:             this.ui.preflightQuery = prompt;
 530:             this.emit();
 531:           },
 532:           onSyllabusCreated: async ({ group, items, workspaceId }) => {
 533:             if (this.domain.activeWorkspaceId === workspaceId) {
 534:               await this.loadCardsForActiveWorkspace();
 535:               this.domain.selection = new Set(items.map((card) => card.id));
 536:             }
 537:             this.operations.present({
 538:               summary: `Syllabus created: ${items.length} prerequisite topic${items.length === 1 ? "" : "s"}`,
 539:               createdCardIds: [group.id, ...items.map((card) => card.id)],
 540:               destination: { spaceId: workspaceId, groupId: group.id },
 541:               primaryActionLabel: "Open syllabus",
 542:             });
 543:             this.emit();
 544:           },
