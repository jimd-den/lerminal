<file path="src/frameworks/ui/useDeckNavigation.ts">
  1: import { useCallback, useEffect, useState } from "react";
  2: import { BackHandler } from "react-native";
  3: import {
  4:   AppState,
  5:   GriotController,
  6: } from "../../adapters/presenters/GriotController";
  7: import { CorePlace } from "./griot/components";
  8: import { CaptureIntent } from "./griot/screens";
  9: export type LibraryLevel = "index" | "space" | "document";
 10: export interface DeckNavigation {
 11:   place: CorePlace;
 12:   libraryLevel: LibraryLevel;
 13:   captureIntent: CaptureIntent;
 14:   openSpace: (spaceId: string) => Promise<void>;
 15:   openDocument: (groupId: string) => void;
 16:   backFromDocument: () => void;
 17:   openCapture: (intent: CaptureIntent, parentId?: string | null) => void;
 18:   openOperationResult: () => Promise<void>;
 19:   openSettings: () => void;
 20:   changePlace: (next: CorePlace) => void;
 21:   showLibraryIndex: () => void;
 22: }
 23: export interface DeckNavigationOptions {
 24:   controller: GriotController;
 25:   state: AppState;
 26:   captureWorking: boolean;
 27: }
 28: export function useDeckNavigation({
 29:   controller,
 30:   state,
 31:   captureWorking,
 32: }: DeckNavigationOptions): DeckNavigation {
 33:   const [place, setPlace] = useState<CorePlace>("deck");
 34:   const [libraryLevel, setLibraryLevel] = useState<LibraryLevel>("index");
 35:   const [captureIntent, setCaptureIntent] = useState<CaptureIntent>("note");
 36:   const openSpace = useCallback(
 37:     async (spaceId: string) => {
 38:       if (spaceId !== state.activeWorkspaceId) {
 39:         await controller.switchWorkspace(spaceId);
 40:       }
 41:       controller.navigateToGroup(null);
 42:       controller.clearSelection();
 43:       setPlace("library");
 44:       setLibraryLevel("space");
 45:     },
 46:     [controller, state.activeWorkspaceId]
 47:   );
 48:   const openDocument = useCallback(
 49:     (groupId: string) => {
 50:       controller.navigateToGroup(groupId);
 51:       setPlace("library");
 52:       setLibraryLevel("document");
 53:     },
 54:     [controller]
 55:   );
 56:   const backFromDocument = useCallback(() => {
 57:     const current = state.cards.find(card => card.id === state.currentGroupId);
 58:     if (current?.parentId) {
 59:       controller.navigateToGroup(current.parentId);
 60:       setLibraryLevel("document");
 61:     } else {
 62:       controller.navigateToGroup(null);
 63:       setLibraryLevel("space");
 64:     }
 65:   }, [controller, state.cards, state.currentGroupId]);
 66:   const openCapture = useCallback(
 67:     (intent: CaptureIntent, parentId: string | null = null) => {
 68:       controller.navigateToGroup(parentId);
 69:       setCaptureIntent(intent);
 70:       setPlace("capture");
 71:     },
 72:     [controller]
 73:   );
 74:   const openOperationResult = useCallback(async () => {
 75:     const result = state.operationResult;
 76:     if (!result) return;
 77:     await controller.openOperationResult();
 78:     if (result.destination.cardId && !result.destination.groupId) {
 79:       controller.openCard(result.destination.cardId);
 80:       return;
 81:     }
 82:     setPlace("library");
 83:     setLibraryLevel(result.destination.groupId ? "document" : "space");
 84:   }, [controller, state.operationResult]);
 85:   const openSettings = useCallback(() => setPlace("more"), []);
 86:   const showLibraryIndex = useCallback(() => setLibraryLevel("index"), []);
 87:   const changePlace = useCallback(
 88:     (next: CorePlace) => {
 89:       if (captureWorking) return;
 90:       controller.navigateToGroup(null);
 91:       setPlace(next);
 92:       if (next === "library") setLibraryLevel("index");
 93:     },
 94:     [captureWorking, controller]
 95:   );
 96:   useEffect(() => {
 97:     if (state.isSettingsSheetOpen) {
 98:       setPlace("more");
 99:       controller.setSettingsSheetOpen(false);
100:     }
101:   }, [controller, state.isSettingsSheetOpen]);
102:   useEffect(() => {
103:     if (!state.pendingGroupNavigation) return;
104:     const groupId = controller.consumeGroupNavigation();
105:     if (groupId) {
106:       setPlace("library");
107:       setLibraryLevel("document");
108:     }
109:   }, [controller, state.pendingGroupNavigation]);
110:   useEffect(() => {
111:     if (!state.captureIntent) return;
112:     const intent = controller.consumeCaptureIntent();
113:     if (intent) {
114:       setCaptureIntent(intent);
115:       setPlace("capture");
116:     }
117:   }, [controller, state.captureIntent]);
118:   useEffect(() => {
119:     const subscription = BackHandler.addEventListener("hardwareBackPress", () => {
120:       if (state.selection.size > 0) {
121:         controller.clearSelection();
122:         return true;
123:       }
124:       if (place === "capture" && captureWorking) return true;
125:       if (place === "library" && libraryLevel === "document") {
126:         backFromDocument();
127:         return true;
128:       }
129:       if (place === "library" && libraryLevel === "space") {
130:         setLibraryLevel("index");
131:         return true;
132:       }
133:       if (place !== "deck") {
134:         controller.navigateToGroup(null);
135:         setPlace("deck");
136:         return true;
137:       }
138:       return false;
139:     });
140:     return () => subscription.remove();
141:   }, [backFromDocument, captureWorking, controller, libraryLevel, place, state.selection.size]);
142:   return {
143:     place,
144:     libraryLevel,
145:     captureIntent,
146:     openSpace,
147:     openDocument,
148:     backFromDocument,
149:     openCapture,
150:     openOperationResult,
151:     openSettings,
152:     changePlace,
153:     showLibraryIndex,
154:   };
155: }
</file>

