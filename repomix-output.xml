1737:   public addPendingOperation(
1738:     commandName: string,
1739:     retry?: {
1740:       pipelineText: string;
1741:       inputCardIds: string[];
1742:       parentId: string | null;
1743:     },
1744:   ): string {
1745:     return this.operations.begin(commandName, retry);
