 1: import { OperationRecord } from "../../entities/operationLog";
 2: import { OperationLogRepository } from "../../usecases/ports/repositories/OperationLogRepository";
 3: import { KeyValueStore } from "./KeyValueStore";
 4: import { JsonCollectionStore, JsonStoreOptions, removeById, upsert } from "./JsonStore";
 5: const STORAGE_KEY = "learnimal_operation_log_v1";
 6: const MAX_RECORDS = 200;
 7: const recordId = (record: OperationRecord) => record.id;
 8: const newestFirst = (a: OperationRecord, b: OperationRecord) => b.completedAt - a.completedAt;
 9: const bounded = (records: OperationRecord[]): OperationRecord[] =>
10:   [...records].sort(newestFirst).slice(0, MAX_RECORDS);
11: export class AsyncStorageOperationLogRepository implements OperationLogRepository {
12:   private readonly records: JsonCollectionStore<OperationRecord>;
13:   constructor(store: KeyValueStore, options?: JsonStoreOptions) {
14:     this.records = new JsonCollectionStore(STORAGE_KEY, store, "operationLog", options);
15:   }
16:   async getRecords(workspaceId: string): Promise<OperationRecord[]> {
17:     const all = await this.records.readAll();
18:     return all.filter((record) => record.workspaceId === workspaceId).sort(newestFirst);
19:   }
20:   async getRecord(id: string): Promise<OperationRecord | null> {
21:     const all = await this.records.readAll();
22:     return all.find((record) => record.id === id) ?? null;
23:   }
24:   async saveRecord(record: OperationRecord): Promise<void> {
25:     await this.records.mutate((all) => bounded(upsert(all, record, recordId)));
26:   }
27:   async deleteRecord(id: string): Promise<void> {
28:     await this.records.mutate((all) => removeById(all, id, recordId));
29:   }
30: }
</file>

