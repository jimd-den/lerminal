 14: class FakeStore implements KeyValueStore {
 15:   readonly data = new Map<string, string>();
 16:   failRead = false;
 17:   failWrite = false;
 18:   writes = 0;
 19:   async getItem(key: string): Promise<string | null> {
 20:     if (this.failRead) throw new Error("disk unavailable");
 21:     return this.data.get(key) ?? null;
 22:   }
 23:   async setItem(key: string, value: string): Promise<void> {
 24:     if (this.failWrite) throw new Error("disk full");
 25:     this.writes++;
 26:     this.data.set(key, value);
 27:   }
 28:   async removeItem(key: string): Promise<void> {
 29:     this.data.delete(key);
 30:   }
 31: }
 32: interface Item {
 33:   id: string;
 34:   value: number;
 35: }
