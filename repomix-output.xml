39: export function readFailedRunCard(card: Card): FailedRunDetails | null {
40:   if (!isFailedRunCard(card)) return null;
41:   const fields = card.fields;
42:   const pipelineText = fields?.[FIELD.pipelineText];
43:   if (!pipelineText) return null;
44:   let inputCardIds: string[] = [];
45:   try {
46:     const parsed = JSON.parse(fields?.[FIELD.inputCardIds] ?? "[]");
47:     if (Array.isArray(parsed)) inputCardIds = parsed.filter(id => typeof id === "string");
48:   } catch {
49:     return null;
50:   }
51:   const parentId = fields?.[FIELD.parentId];
52:   return {
53:     pipelineText,
54:     inputCardIds,
55:     parentId: parentId ? parentId : null,
56:     errorMessage: fields?.[FIELD.errorMessage] ?? card.body ?? "Something went wrong",
57:     failedAt: Number(fields?.[FIELD.failedAt]) || card.createdAt,
58:   };
59: }
