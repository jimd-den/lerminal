<file path="src/usecases/research/ResearchWorkflow.ts">
  1: import { Card } from "../../entities/card";
  2: import { ResearchResult } from "../../entities/research";
  3: import { UseCaseError } from "../errors";
  4: import { RunResearchInteractor } from "./RunResearchInteractor";
  5: import { ExtractResearchResultInteractor } from "./ExtractResearchResultInteractor";
  6: import { SaveResearchResultAsSourceInteractor } from "./SaveResearchResultAsSourceInteractor";
  7: import { CreateResearchBriefInteractor } from "./CreateResearchBriefInteractor";
  8: export interface ResearchState {
  9:   query: string;
 10:   results: ResearchResult[];
 11:   isOpen: boolean;
 12:   loading: boolean;
 13:   error: string | null;
 14:   isCreatingBrief: boolean;
 15: }
 16: export interface ResearchContext {
 17:   workspaceId: string | null;
 18:   parentId: string | null;
 19:   apiKey: string;
 20:   model: string;
 21: }
 22: export interface BriefOutcome {
 23:   created: Card[];
 24:   keptCount: number;
 25:   workspaceId: string;
 26:   parentId: string | null;
 27: }
 28: export interface ResearchHost {
 29:   context(): ResearchContext;
 30:   onChange(): void;
 31:   notify(message: string): void;
 32:   onSourceSaved(workspaceId: string, card: Card): Promise<void>;
 33:   onBriefCreated(outcome: BriefOutcome): Promise<void>;
 34: }
 35: export interface ResearchWorkflowDeps {
 36:   runResearch: RunResearchInteractor;
 37:   extractResult: ExtractResearchResultInteractor;
 38:   saveAsSource: SaveResearchResultAsSourceInteractor;
 39:   createBrief: CreateResearchBriefInteractor;
 40:   host: ResearchHost;
 41: }
 42: const EMPTY_STATE: ResearchState = {
 43:   query: "",
 44:   results: [],
 45:   isOpen: false,
 46:   loading: false,
 47:   error: null,
 48:   isCreatingBrief: false,
 49: };
 50: /** Turns any thrown value into something worth showing a user. */
 51: const messageFor = (error: unknown, fallback: string): string =>
 52:   error instanceof UseCaseError ? error.userMessage : fallback;
 53: export class ResearchWorkflow {
 54:   private current: ResearchState = { ...EMPTY_STATE };
 55:   constructor(private readonly deps: ResearchWorkflowDeps) {}
 56:   get state(): ResearchState {
 57:     return this.current;
 58:   }
 59:   /** Applies a partial update and re-renders — the only way this class changes state. */
 60:   private patch(changes: Partial<ResearchState>): void {
 61:     this.current = { ...this.current, ...changes };
 62:     this.deps.host.onChange();
 63:   }
 64:   /** Replaces one candidate, matched by url. Pure with respect to the others. */
 65:   private replaceResult(url: string, next: (result: ResearchResult) => ResearchResult): void {
 66:     this.patch({
 67:       results: this.current.results.map((result) =>
 68:         result.url === url ? next(result) : result,
 69:       ),
 70:     });
 71:   }
 72:   private find(url: string): ResearchResult | undefined {
 73:     return this.current.results.find((result) => result.url === url);
 74:   }
 75:   /**
 76:    * Runs a real web search and opens the sheet with normalized, inspectable candidates.
 77:    * A failed search sets `error` — it never falls back to model-invented "results".
 78:    */
 79:   async start(query: string): Promise<void> {
 80:     const trimmed = query.trim();
 81:     if (!trimmed) return;
 82:     this.patch({
 83:       query: trimmed,
 84:       results: [],
 85:       error: null,
 86:       loading: true,
 87:       isOpen: true,
 88:     });
 89:     try {
 90:       this.patch({ results: await this.deps.runResearch.execute(trimmed) });
 91:     } catch (error) {
 92:       this.patch({ error: messageFor(error, "Search failed") });
 93:     } finally {
 94:       this.patch({ loading: false });
 95:     }
 96:   }
 97:   setKeepState(url: string, keepState: ResearchResult["keepState"]): void {
 98:     this.replaceResult(url, (result) => ({ ...result, keepState }));
 99:   }
100:   async extract(url: string): Promise<void> {
101:     const target = this.find(url);
102:     if (!target) return;
103:     this.patch({ loading: true });
104:     try {
105:       const extracted = await this.deps.extractResult.execute(target);
106:       this.replaceResult(url, () => extracted);
107:     } catch (error) {
108:       this.deps.host.notify(messageFor(error, "Extraction failed"));
109:     } finally {
110:       this.patch({ loading: false });
111:     }
112:   }
113:   async saveAsSource(url: string): Promise<void> {
114:     const { workspaceId, parentId } = this.deps.host.context();
115:     const target = this.find(url);
116:     if (!workspaceId || !target || target.savedCardId) return;
117:     try {
118:       const card = await this.deps.saveAsSource.execute({
119:         result: target,
120:         workspaceId,
121:         parentId,
122:       });
123:       this.replaceResult(url, (result) => ({ ...result, savedCardId: card.id }));
124:       await this.deps.host.onSourceSaved(workspaceId, card);
125:       this.deps.host.notify(`Source added: ${card.title}`);
126:     } catch (error) {
127:       this.deps.host.notify(messageFor(error, "Could not save source"));
128:     }
129:   }
130:   async createBrief(): Promise<boolean> {
131:     const { workspaceId, parentId, apiKey, model } = this.deps.host.context();
132:     if (!workspaceId) return false;
133:     this.patch({ isCreatingBrief: true });
134:     try {
135:       const created = await this.deps.createBrief.execute({
136:         query: this.current.query,
137:         results: this.current.results,
138:         workspaceId,
139:         parentId,
140:         apiKey,
141:         model,
142:       });
143:       const keptCount = this.current.results.filter((r) => r.keepState === "kept").length;
144:       this.patch({ isOpen: false });
145:       await this.deps.host.onBriefCreated({ created, keptCount, workspaceId, parentId });
146:       return true;
147:     } catch (error) {
148:       this.deps.host.notify(messageFor(error, "Could not create brief"));
149:       return false;
150:     } finally {
151:       this.patch({ isCreatingBrief: false });
152:     }
153:   }
154:   close(): void {
155:     this.patch({ ...EMPTY_STATE, isCreatingBrief: this.current.isCreatingBrief });
156:   }
157: }
</file>

