1500:   public async runPipeline(
1501:     pipelineText: string,
1502:     retry?: { inputCardIds: string[]; parentId: string | null },
1503:   ): Promise<boolean> {
1504:     const startedAt = Date.now();
1505:     this.logger.debug("pipeline.run", { pipelineText });
1506:     const workspaceId = this.domain.activeWorkspaceId;
1507:     if (!workspaceId) {
1508:       this.showToast("Create a workspace first");
1509:       return false;
1510:     }
1511:     const alias = resolveCommandAlias(pipelineText);
1512:     if (alias) {
1513:       await this.dispatchSuggestedAction(alias.dispatch);
1514:       return true;
1515:     }
1516:     this.dismissTransientSheets();
1517:     this.pendingPipelineResume = null;
1518:     this.emit();
1519:     const { targetParentId, initialInputCards } = this.resolvePipelineInputs(retry);
1520:     const opId = this.addPendingOperation(pipelineText, {
1521:       pipelineText,
1522:       inputCardIds: initialInputCards.map((c) => c.id),
1523:       parentId: targetParentId,
1524:     });
1525:     try {
1526:       const outcome = await this.pipeline.run(pipelineText, {
1527:         workspaceId,
1528:         parentId: targetParentId,
1529:         initialInputCards,
1530:         workspaces: this.domain.workspaces,
1531:         apiKey: this.domain.openRouterKey,
1532:         model: this.domain.selectedModel,
1533:         systemPrompt: this.domain.customSystemPrompt,
1534:         chunkSystemPrompt: this.domain.customChunkSystemPrompt,
1535:         assistantProfiles: this.domain.assistantProfiles,
1536:         activeProfileIds: this.domain.activeProfileIds,
1537:         cardTypes: this.domain.cardTypes,
1538:         autoGroup: this.domain.autoGroupByCommand,
1539:       });
1540:       this.removePendingOperation(opId);
1541:       if (outcome.kind === "needsInput") {
1542:         await this.pausePipelineForInput(outcome, workspaceId, targetParentId);
1543:         return false;
1544:       }
1545:       if (outcome.kind === "review") {
1546:         this.startReview();
1547:         return true;
1548:       }
1549:       if (outcome.kind === "goal") {
1550:         this.openGoalArchitect();
1551:         return true;
1552:       }
1553:       const pendingRecord =
1554:         outcome.cards.length > 0
1555:           ? await this.settleRunOutput(outcome.cards, {
1556:               pipelineText,
1557:               workspaceId,
1558:               targetParentId,
1559:               startedAt,
1560:             })
1561:           : null;
1562:       if (this.domain.activeWorkspaceId === workspaceId) {
1563:         this.domain.selection = new Set(outcome.cards.map((c) => c.id));
1564:         await this.loadCardsForActiveWorkspace();
1565:       }
1566:       if (pendingRecord) {
1567:         const settled = this.domain.cards.filter((card) =>
1568:           pendingRecord!.createdCardIds.includes(card.id),
1569:         );
1570:         await this.operations.recordCompletedRun({
1571:           commandName: pipelineText,
1572:           workspaceId,
1573:           parentId: pendingRecord.destinationGroupId,
1574:           inputCardIds: initialInputCards.map((card) => card.id),
1575:           createdCards: settled,
1576:           startedAt,
1577:           summary: pendingRecord.summary,
1578:         });
1579:       }
1580:       this.emit();
1581:       return true;
1582:     } catch (error) {
1583:       await this.recordPipelineFailure(error, {
1584:         operationId: opId,
1585:         pipelineText,
1586:         workspaceId,
1587:         targetParentId,
1588:         inputCardIds: initialInputCards.map((card) => card.id),
1589:       });
1590:       return false;
1591:     }
1592:   }
1593:   private resolvePipelineInputs(retry?: {
1594:     inputCardIds: string[];
1595:     parentId: string | null;
1596:   }): { targetParentId: string | null; initialInputCards: Card[] } {
1597:     if (retry) {
1598:       return {
1599:         targetParentId: retry.parentId,
1600:         initialInputCards: this.domain.cards.filter((card) =>
1601:           retry.inputCardIds.includes(card.id),
1602:         ),
1603:       };
1604:     }
1605:     return {
1606:       targetParentId: this.domain.currentGroupId,
1607:       initialInputCards: expandForPipe(this.domain.cards, this.domain.selection),
1608:     };
1609:   }
1610:   private async pausePipelineForInput(
1611:     outcome: Extract<PipelineOutcome, { kind: "needsInput" }>,
1612:     workspaceId: string,
1613:     targetParentId: string | null,
1614:   ): Promise<void> {
1615:     this.ui.pendingCommandName = outcome.command;
1616:     if (outcome.resume) {
1617:       if (this.domain.activeWorkspaceId === workspaceId) {
1618:         await this.loadCardsForActiveWorkspace();
1619:       }
1620:       this.pendingPipelineResume = {
1621:         command: outcome.resume.command,
1622:         remainingPipeline: outcome.resume.remainingPipeline,
1623:         inputCardIds: outcome.resume.inputCards.map((card) => card.id),
1624:         parentId: targetParentId,
1625:       };
1626:     }
1627:     this.setInputSheetOpen(true, outcome.mode);
1628:   }
1629:   private async settleRunOutput(
1630:     cards: Card[],
1631:     run: {
1632:       pipelineText: string;
1633:       workspaceId: string;
1634:       targetParentId: string | null;
1635:       startedAt: number;
1636:     },
1637:   ): Promise<PendingRunRecord> {
1638:     let destinationGroupId = commonParentId(cards) ?? run.targetParentId ?? undefined;
1639:     let createdGroupId: string | undefined;
1640:     if (
1641:       shouldAutoGroup({
1642:         cards,
1643:         startedAt: run.startedAt,
1644:         autoGroupEnabled: this.domain.autoGroupByCommand,
1645:       })
1646:     ) {
1647:       const group = await this.groupCardsInteractor.execute({
1648:         workspaceId: run.workspaceId,
1649:         parentId: cards[0].parentId ?? run.targetParentId,
1650:         name: `${commandNameOf(run.pipelineText)} output`,
1651:         cards,
1652:       });
1653:       destinationGroupId = group.id;
1654:       createdGroupId = group.id;
1655:       this.domain.currentGroupId = group.id;
1656:       this.ui.pendingGroupNavigation = group.id;
1657:     }
1658:     const summary = describeRunOutput(cards);
1659:     this.operations.present({
1660:       summary,
1661:       createdCardIds: cards.map((card) => card.id),
1662:       destination: {
1663:         spaceId: run.workspaceId,
1664:         groupId: destinationGroupId,
1665:         cardId: cards.length === 1 ? cards[0].id : undefined,
1666:       },
1667:       primaryActionLabel: destinationGroupId ? "Open document" : "Open result",
1668:     });
1669:     return {
1670:       createdCardIds: [
1671:         ...cards.map((card) => card.id),
1672:         ...(createdGroupId ? [createdGroupId] : []),
1673:       ],
1674:       summary,
1675:       destinationGroupId,
1676:     };
1677:   }
1678:   private async recordPipelineFailure(
1679:     error: unknown,
1680:     run: {
1681:       operationId: string;
1682:       pipelineText: string;
1683:       workspaceId: string;
1684:       targetParentId: string | null;
1685:       inputCardIds: string[];
1686:     },
1687:   ): Promise<void> {
1688:     this.logger.error("pipeline.failed", error);
1689:     const errorMessage =
1690:       error instanceof UseCaseError ? error.userMessage : "Pipeline failed";
1691:     this.removePendingOperation(run.operationId);
1692:     await this.cardRepo.saveCard(
1693:       createFailedRunCard({
1694:         workspaceId: run.workspaceId,
1695:         pipelineText: run.pipelineText,
1696:         inputCardIds: run.inputCardIds,
1697:         parentId: run.targetParentId,
1698:         errorMessage,
1699:         failedAt: Date.now(),
1700:       }),
1701:     );
1702:     if (this.domain.activeWorkspaceId === run.workspaceId) {
1703:       await this.loadCardsForActiveWorkspace();
1704:     }
1705:     this.showToast(errorMessage);
1706:     this.emit();
1707:   }
1708:   async rerunFailedCard(cardId: string): Promise<boolean> {
1709:     const card = this.domain.cards.find((c) => c.id === cardId);
1710:     if (!card) return false;
1711:     const details = readFailedRunCard(card);
1712:     if (!details) {
1713:       this.showToast("This failure can't be retried — its details are incomplete");
1714:       return false;
1715:     }
1716:     this.ui.openCardId = null;
1717:     this.emit();
1718:     const succeeded = await this.runPipeline(details.pipelineText, {
1719:       inputCardIds: details.inputCardIds,
1720:       parentId: details.parentId,
1721:     });
1722:     if (succeeded) {
1723:       await this.cardRepo.deleteCard(cardId);
1724:       await this.loadCardsForActiveWorkspace();
1725:       this.emit();
1726:     }
1727:     return succeeded;
1728:   }
