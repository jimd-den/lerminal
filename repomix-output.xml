  1: import React from "react";
  2: import { Pressable, StyleSheet, Text, View } from "react-native";
  3: import {
  4:   AppState,
  5:   GriotController,
  6: } from "../../../adapters/presenters/GriotController";
  7: import { presentActivity } from "../../../adapters/presenters/ActivityPresenter";
  8: import { WorkingBar } from "../motion/communicative";
  9: import { GriotTheme, Structure, TypeScale } from "./theme";
 10: export function ActivityBanner({
 11:   controller,
 12:   state,
 13:   theme,
 14: }: {
 15:   controller: GriotController;
 16:   state: AppState;
 17:   theme: GriotTheme;
 18: }) {
 19:   const activity = presentActivity(state);
 20:   if (!activity) return null;
 21:   const failed = activity.error !== null;
 22:   const tint = failed ? theme.danger : theme.accent;
 23:   return (
 24:     <View
 25:       accessibilityRole="alert"
 26:       accessibilityLiveRegion="polite"
 27:       style={[
 28:         styles.banner,
 29:         {
 30:           backgroundColor: theme.panelStrong,
 31:           borderColor: tint,
 32:         },
 33:       ]}
 34:     >
 35:       <View style={styles.row}>
 36:         <View style={styles.copy}>
 37:           <View style={styles.labelRow}>
 38:             <Text
 39:               numberOfLines={1}
 40:               style={[styles.label, { color: failed ? theme.danger : theme.text }]}
 41:             >
 42:               {failed ? `${activity.label} failed` : activity.label}
 43:             </Text>
 44:             {}
 45:             {activity.usesModel ? (
 46:               <Badge text="MODEL" color={theme.accent} theme={theme} />
 47:             ) : null}
 48:             {activity.usesWeb ? (
 49:               <Badge text="WEB" color={theme.warning} theme={theme} />
 50:             ) : null}
 51:           </View>
 52:           <Text numberOfLines={2} style={[styles.detail, { color: theme.textMuted }]}>
 53:             {failed ? activity.error!.message : "Working…"}
 54:           </Text>
 55:         </View>
 56:         {failed ? (
 57:           <View style={styles.actions}>
 58:             {activity.error!.canRetry ? (
 59:               <Pressable
 60:                 accessibilityRole="button"
 61:                 onPress={() => void controller.retryPipeline(activity.error!.operationId)}
 62:                 hitSlop={6}
 63:                 style={styles.action}
 64:               >
 65:                 <Text style={[styles.actionText, { color: theme.accent, fontFamily: theme.fontMono }]}>
 66:                   RETRY
 67:                 </Text>
 68:               </Pressable>
 69:             ) : null}
 70:             <Pressable
 71:               accessibilityRole="button"
 72:               accessibilityLabel="Dismiss error"
 73:               onPress={() => controller.removePendingOperation(activity.error!.operationId)}
 74:               hitSlop={6}
 75:               style={styles.action}
 76:             >
 77:               <Text style={[styles.actionText, { color: theme.textMuted, fontFamily: theme.fontMono }]}>
 78:                 DISMISS
 79:               </Text>
 80:             </Pressable>
 81:           </View>
 82:         ) : null}
 83:       </View>
 84:       <WorkingBar active={!failed} color={tint} trackColor={theme.line} />
 85:     </View>
 86:   );
 87: }
 88: function Badge({ text, color, theme }: { text: string; color: string; theme: GriotTheme }) {
 89:   return (
 90:     <View style={[styles.badge, { borderColor: color }]}>
 91:       <Text style={[styles.badgeText, { color, fontFamily: theme.fontMono }]}>{text}</Text>
 92:     </View>
 93:   );
 94: }
 95: const styles = StyleSheet.create({
 96:   banner: {
 97:     borderWidth: 1,
 98:     borderRadius: Structure.radiusControl,
 99:     paddingHorizontal: 12,
100:     paddingTop: 10,
101:     paddingBottom: 8,
102:     marginHorizontal: 12,
103:     marginBottom: 8,
104:     gap: 8,
105:   },
106:   row: { flexDirection: "row", alignItems: "center", gap: 10 },
107:   copy: { flex: 1 },
108:   labelRow: { flexDirection: "row", alignItems: "center", gap: 6, flexWrap: "wrap" },
109:   label: { fontSize: TypeScale.body, fontWeight: "700", flexShrink: 1 },
110:   detail: { fontSize: TypeScale.meta, lineHeight: 17, marginTop: 2 },
111:   badge: { borderWidth: 1, borderRadius: 5, paddingHorizontal: 5, paddingVertical: 1 },
112:   badgeText: { fontSize: TypeScale.label, fontWeight: "900", letterSpacing: 0.8 },
113:   actions: { flexDirection: "row", gap: 4 },
114:   action: { minHeight: Structure.tap, minWidth: 60, alignItems: "center", justifyContent: "center" },
115:   actionText: { fontSize: TypeScale.label, fontWeight: "800", letterSpacing: 0.6 },
116: });
