1491:   public async runPipeline(
1492:     pipelineText: string,
1493:     retry?: { inputCardIds: string[]; parentId: string | null },
1494:   ): Promise<boolean> {
1495:     const startedAt = Date.now();
1496:     this.logger.debug("pipeline.run", { pipelineText });
1497:     const workspaceId = this.domain.activeWorkspaceId;
1498:     if (!workspaceId) {
1499:       this.showToast("Create a workspace first");
1500:       return false;
1501:     }
1502:     const alias = resolveCommandAlias(pipelineText);
1503:     if (alias) {
1504:       await this.dispatchSuggestedAction(alias.dispatch);
1505:       return true;
1506:     }
1507:     this.dismissTransientSheets();
1508:     this.pendingPipelineResume = null;
1509:     this.emit();
1510:     const { targetParentId, initialInputCards } = this.resolvePipelineInputs(retry);
1511:     const opId = this.addPendingOperation(pipelineText, {
1512:       pipelineText,
1513:       inputCardIds: initialInputCards.map((c) => c.id),
1514:       parentId: targetParentId,
1515:     });
1516:     try {
1517:       const outcome = await this.pipeline.run(pipelineText, {
1518:         workspaceId,
1519:         parentId: targetParentId,
1520:         initialInputCards,
1521:         workspaces: this.domain.workspaces,
1522:         apiKey: this.domain.openRouterKey,
1523:         model: this.domain.selectedModel,
1524:         systemPrompt: this.domain.customSystemPrompt,
1525:         chunkSystemPrompt: this.domain.customChunkSystemPrompt,
1526:         assistantProfiles: this.domain.assistantProfiles,
1527:         activeProfileIds: this.domain.activeProfileIds,
1528:         cardTypes: this.domain.cardTypes,
1529:         autoGroup: this.domain.autoGroupByCommand,
1530:       });
1531:       this.removePendingOperation(opId);
1532:       if (outcome.kind === "needsInput") {
1533:         await this.pausePipelineForInput(outcome, workspaceId, targetParentId);
1534:         return false;
1535:       }
1536:       if (outcome.kind === "review") {
1537:         this.startReview();
1538:         return true;
1539:       }
1540:       const pendingRecord =
1541:         outcome.cards.length > 0
1542:           ? await this.settleRunOutput(outcome.cards, {
1543:               pipelineText,
1544:               workspaceId,
1545:               targetParentId,
1546:               startedAt,
1547:             })
1548:           : null;
1549:       if (this.domain.activeWorkspaceId === workspaceId) {
1550:         this.domain.selection = new Set(outcome.cards.map((c) => c.id));
1551:         await this.loadCardsForActiveWorkspace();
1552:       }
1553:       if (pendingRecord) {
1554:         const settled = this.domain.cards.filter((card) =>
1555:           pendingRecord!.createdCardIds.includes(card.id),
1556:         );
1557:         await this.operations.recordCompletedRun({
1558:           commandName: pipelineText,
1559:           workspaceId,
1560:           parentId: pendingRecord.destinationGroupId,
1561:           inputCardIds: initialInputCards.map((card) => card.id),
1562:           createdCards: settled,
1563:           startedAt,
1564:           summary: pendingRecord.summary,
1565:         });
1566:       }
1567:       this.emit();
1568:       return true;
1569:     } catch (error) {
1570:       await this.recordPipelineFailure(error, {
1571:         operationId: opId,
1572:         pipelineText,
1573:         workspaceId,
1574:         targetParentId,
1575:         inputCardIds: initialInputCards.map((card) => card.id),
1576:       });
1577:       return false;
1578:     }
1579:   }
1580:   private resolvePipelineInputs(retry?: {
1581:     inputCardIds: string[];
1582:     parentId: string | null;
1583:   }): { targetParentId: string | null; initialInputCards: Card[] } {
1584:     if (retry) {
1585:       return {
1586:         targetParentId: retry.parentId,
1587:         initialInputCards: this.domain.cards.filter((card) =>
1588:           retry.inputCardIds.includes(card.id),
1589:         ),
1590:       };
1591:     }
1592:     return {
1593:       targetParentId: this.domain.currentGroupId,
1594:       initialInputCards: expandForPipe(this.domain.cards, this.domain.selection),
1595:     };
1596:   }
1597:   private async pausePipelineForInput(
1598:     outcome: Extract<PipelineOutcome, { kind: "needsInput" }>,
1599:     workspaceId: string,
1600:     targetParentId: string | null,
1601:   ): Promise<void> {
1602:     this.ui.pendingCommandName = outcome.command;
1603:     if (outcome.resume) {
1604:       if (this.domain.activeWorkspaceId === workspaceId) {
1605:         await this.loadCardsForActiveWorkspace();
1606:       }
1607:       this.pendingPipelineResume = {
1608:         command: outcome.resume.command,
1609:         remainingPipeline: outcome.resume.remainingPipeline,
1610:         inputCardIds: outcome.resume.inputCards.map((card) => card.id),
1611:         parentId: targetParentId,
1612:       };
1613:     }
1614:     this.setInputSheetOpen(true, outcome.mode);
1615:   }
1616:   private async settleRunOutput(
1617:     cards: Card[],
1618:     run: {
1619:       pipelineText: string;
1620:       workspaceId: string;
1621:       targetParentId: string | null;
1622:       startedAt: number;
1623:     },
1624:   ): Promise<PendingRunRecord> {
1625:     let destinationGroupId = commonParentId(cards) ?? run.targetParentId ?? undefined;
1626:     let createdGroupId: string | undefined;
1627:     if (
1628:       shouldAutoGroup({
1629:         cards,
1630:         startedAt: run.startedAt,
1631:         autoGroupEnabled: this.domain.autoGroupByCommand,
1632:       })
1633:     ) {
1634:       const group = await this.groupCardsInteractor.execute({
1635:         workspaceId: run.workspaceId,
1636:         parentId: cards[0].parentId ?? run.targetParentId,
1637:         name: `${commandNameOf(run.pipelineText)} output`,
1638:         cards,
1639:       });
1640:       destinationGroupId = group.id;
1641:       createdGroupId = group.id;
1642:       this.domain.currentGroupId = group.id;
1643:       this.ui.pendingGroupNavigation = group.id;
1644:     }
1645:     const summary = describeRunOutput(cards);
1646:     this.operations.present({
1647:       summary,
1648:       createdCardIds: cards.map((card) => card.id),
1649:       destination: {
1650:         spaceId: run.workspaceId,
1651:         groupId: destinationGroupId,
1652:         cardId: cards.length === 1 ? cards[0].id : undefined,
1653:       },
1654:       primaryActionLabel: destinationGroupId ? "Open document" : "Open result",
1655:     });
1656:     return {
1657:       createdCardIds: [
1658:         ...cards.map((card) => card.id),
1659:         ...(createdGroupId ? [createdGroupId] : []),
1660:       ],
1661:       summary,
1662:       destinationGroupId,
1663:     };
1664:   }
1665:   private async recordPipelineFailure(
1666:     error: unknown,
1667:     run: {
1668:       operationId: string;
