<file path="src/usecases/review/ReviewSession.ts">
  1: import { Card } from "../../entities/card";
  2: import { CardTypeDefinition } from "../../entities/cardTypeDefinition";
  3: import { FsrsConfig } from "../../entities/workspace";
  4: import { ReviewGrade } from "../../entities/schedule";
  5: import { UseCaseError } from "../errors";
  6: import { StartReviewInteractor } from "./StartReviewInteractor";
  7: import { GradeReviewInteractor } from "./GradeReviewInteractor";
  8: import { FsrsScheduler, ReviewPreview } from "./FsrsScheduler";
  9: export interface ReviewSessionState {
 10:   queue: Card[];
 11:   index: number;
 12:   isOpen: boolean;
 13:   revealAnswer: boolean;
 14: }
 15: export interface ReviewHost {
 16:   cards(): Card[];
 17:   cardTypes(): CardTypeDefinition[];
 18:   interleaveReviews(): boolean;
 19:   schedulerConfig(): FsrsConfig;
 20:   onChange(): void;
 21:   notify(message: string): void;
 22:   onCardGraded(card: Card): void;
 23:   refreshCards(): Promise<void>;
 24: }
 25: export interface ReviewSessionDeps {
 26:   startReview: StartReviewInteractor;
 27:   gradeReview: GradeReviewInteractor;
 28:   scheduler: FsrsScheduler;
 29:   host: ReviewHost;
 30:   now?: () => number;
 31: }
 32: const CLOSED: ReviewSessionState = {
 33:   queue: [],
 34:   index: 0,
 35:   isOpen: false,
 36:   revealAnswer: false,
 37: };
 38: export class ReviewSession {
 39:   private current: ReviewSessionState = { ...CLOSED };
 40:   private readonly now: () => number;
 41:   constructor(private readonly deps: ReviewSessionDeps) {
 42:     this.now = deps.now ?? Date.now;
 43:   }
 44:   get state(): ReviewSessionState {
 45:     return this.current;
 46:   }
 47:   private patch(changes: Partial<ReviewSessionState>): void {
 48:     this.current = { ...this.current, ...changes };
 49:     this.deps.host.onChange();
 50:   }
 51:   get currentCard(): Card | undefined {
 52:     return this.current.queue[this.current.index];
 53:   }
 54:   previews(cardId: string): Record<ReviewGrade, ReviewPreview> | null {
 55:     const card = this.deps.host.cards().find((c) => c.id === cardId);
 56:     if (!card) return null;
 57:     return this.deps.scheduler.preview(card, this.now(), this.deps.host.schedulerConfig());
 58:   }
 59:   start(cram: boolean = false): void {
 60:     try {
 61:       const queue = this.deps.startReview.execute(
 62:         this.deps.host.cards(),
 63:         this.now(),
 64:         this.deps.host.interleaveReviews(),
 65:         cram,
 66:         this.deps.host.cardTypes(),
 67:       );
 68:       this.patch({ queue, index: 0, isOpen: true, revealAnswer: false });
 69:     } catch (error) {
 70:       this.patch({ ...CLOSED });
 71:       this.deps.host.notify(
 72:         error instanceof UseCaseError ? error.userMessage : "Could not start review",
 73:       );
 74:     }
 75:   }
 76:   reveal(): void {
 77:     this.patch({ revealAnswer: true });
 78:   }
 79:   async grade(grade: boolean | ReviewGrade): Promise<boolean> {
 80:     const card = this.currentCard;
 81:     if (!card) return false;
 82:     const updated = await this.deps.gradeReview.execute(
 83:       card,
 84:       grade,
 85:       this.now(),
 86:       this.deps.host.schedulerConfig(),
 87:     );
 88:     if (!updated) return this.current.isOpen;
 89:     this.deps.host.onCardGraded(updated);
 90:     const queue = this.current.queue.map((queued) =>
 91:       queued.id === updated.id ? updated : queued,
 92:     );
 93:     const nextIndex = this.current.index + 1;
 94:     if (nextIndex >= queue.length) {
 95:       this.patch({ ...CLOSED });
 96:       await this.deps.host.refreshCards();
 97:       this.deps.host.notify("Review complete!");
 98:       return false;
 99:     }
100:     this.patch({ queue, index: nextIndex, revealAnswer: false });
101:     return true;
102:   }
103:   applyCardUpdate(card: Card): void {
104:     if (!this.current.queue.some((queued) => queued.id === card.id)) return;
105:     this.patch({
106:       queue: this.current.queue.map((queued) =>
107:         queued.id === card.id ? card : queued,
108:       ),
109:     });
110:   }
111:   close(): void {
112:     this.patch({ ...CLOSED });
113:   }
114: }
</file>

